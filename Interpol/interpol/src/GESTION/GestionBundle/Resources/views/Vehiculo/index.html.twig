{% extends 'GESTIONGestionBundle::base.html.twig' %}

{% block body -%}
	<style>
		/* ---------- Formulario de consulta de vehículos (mismo criterio visual que la ficha y los formularios de personas y documentos) ---------- */
		.pf-wrap {
			max-width: 760px;
			margin: 15px auto 30px;
			padding: 0 15px;
		}
		.pf-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			background: #fff;
			border-radius: 10px;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			padding: 12px 20px;
			margin-bottom: 16px;
		}
		.pf-topbar img {
			width: 230px;
			max-width: 55%;
		}
		.pf-title {
			margin: 0;
			color: #2d3c90;
			font-size: 22px;
			font-weight: 600;
		}
		.pf-card {
			background: #fff;
			border-radius: 12px;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			margin-bottom: 16px;
			overflow: visible; /* visible para que la lista desplegable del selector no quede cortada */
		}
		.pf-card-h {
			border-radius: 12px 12px 0 0;
			padding: 11px 18px;
			background: #f4f6fb;
			border-bottom: 1px solid #e3e7f1;
			color: #2d3c90;
			font-size: 15px;
			font-weight: 700;
		}
		.pf-card-h .glyphicon {
			margin-right: 8px;
			opacity: 0.8;
		}
		.pf-card-b {
			padding: 16px 18px 6px;
		}
		.pf-fields {
			display: flex;
			flex-wrap: wrap;
			margin: 0 -8px;
		}
		.pf-field {
			flex: 1 1 200px;
			padding: 0 8px;
			margin-bottom: 14px;
		}
		.pf-field label {
			display: block;
			margin-bottom: 5px;
			color: #5d6678;
			font-size: 13px;
			font-weight: 600;
		}
		.pf-card .form-control {
			height: 40px;
			border-radius: 8px;
			border: 1px solid #cdd4e4;
			box-shadow: none;
		}
		.pf-card .form-control:focus {
			border-color: #2d3c90;
			box-shadow: 0 0 0 2px rgba(45, 60, 144, 0.15);
		}
		.pf-help {
			display: block;
			margin: 0 0 12px;
			color: #7a8194;
			font-size: 12px;
		}
		.pf-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 12px;
		}
		.pf-actions .btn {
			flex: 1 1 200px;
			padding: 10px 0;
			border-radius: 8px;
			font-size: 16px;
		}
		.pf-actions .btn i {
			margin-right: 6px;
		}
		.bootstrap-select:not([class*="col-"]):not([class*="form-control"]):not(
				.input-group-btn
			) {
			width: 100% !important;
		}
		@media (max-width: 767px) {
			.pf-wrap {
				margin-top: 8px;
			}
			.pf-topbar {
				flex-direction: column;
				gap: 6px;
				text-align: center;
			}
		}
	</style>

	{% set bInvestigativo = "NO" %}
	{% for perfil in usuario.perfilid %}
		{% for permiso in perfil.permisoid %}
			{% if permiso.id == '7' %}
				{% set bInvestigativo = "SI" %}
			{% endif %}
		{% endfor %}
	{% endfor %}

	<form method="POST" id="frmVehiculo" action="{{ path('vehiculo_show') }}">
		<div id="panelconsulta" class="pf-wrap">

			<div class="pf-topbar">
				<img src="{{ asset('bundles/pfa/img/ocnbuenosaires.png') }}"/>
				<p class="pf-title">Interpol - Vehículos</p>
			</div>

			{# Tipo de consulta: si el usuario no es investigativo queda oculto, pero se envía igual con el valor BC #}
			<div class="pf-card {{ bInvestigativo == 'SI' ? '' : 'hidden' }}">
				<div class="pf-card-h"><span class="glyphicon glyphicon-cog"></span>Tipo de consulta</div>
				<div class="pf-card-b">
					<div class="pf-field" style="padding: 0;">
						<label for="lstTipoCons">Tipo de Consulta</label>
						<select name="lstTipoCons" class="selectpicker form-control" id="lstTipoCons" required>
							<option value="BC">Control Fronterizo</option>
							{% if bInvestigativo == "SI" %}
								<option value="AD" selected>Investigación</option>
							{% endif %}
						</select>
					</div>
				</div>
			</div>

			<div class="pf-card">
				<div class="pf-card-h"><span class="glyphicon glyphicon-road"></span>Datos del vehículo</div>
				<div class="pf-card-b">
					{% if bInvestigativo == "SI" %}
						<small class="pf-help">Ingrese el VIN o el Nro. de Motor para realizar la consulta.</small>
					{% else %}
						<small class="pf-help">Complete los tres campos para realizar la consulta.</small>
					{% endif %}
					<div class="pf-fields">
						<div class="pf-field">
							<label for="txtVin">VIN (Nro. Chasis)</label>
							<input type="text" value="" class="form-control interpol" name="txtVin" id="txtVin" placeholder="Ingrese VIN">
						</div>
						<div class="pf-field">
							<label for="txtDominio">Dominio</label>
							<input type="text" value="" class="form-control interpol" name="txtDominio" id="txtDominio" placeholder="Ingrese Dominio">
						</div>
						<div class="pf-field">
							<label for="txtNroMotor">Nro. Motor</label>
							<input type="text" value="" class="form-control" name="txtNroMotor" id="txtNroMotor" placeholder="Ingrese Número de Motor">
						</div>
					</div>
				</div>
			</div>

			<div class="pf-actions">
				<button class="btn btn-success" data-toggle="tooltip" id="consultar" title="Consultar" type="submit" data-placement="bottom">
					<i class="fa fa-search" aria-hidden="true"></i>
					Consultar
				</button>
				<button class="btn btn-default" data-toggle="tooltip" title="Limpiar Parámetros de Búsqueda" id="limpiar" type="button" data-placement="bottom">
					<i class="fa fa-undo" aria-hidden="true"></i>
					Limpiar Búsqueda
				</button>
			</div>

		</div>
	</form>

	<script>
		$(document).ready(function () {
			$('#limpiar').click(function () {
				$("#txtVin").val("");
				$("#txtDominio").val("");
				$("#txtNroMotor").val("");
				$("#lstTipoCons").val("{{ bInvestigativo == 'SI' ? 'AD' : 'BC' }}").selectpicker('refresh');
			});
		});

		{% if bInvestigativo == "SI" %}
		// Usuarios investigativos: alcanza con el VIN o el Nro. de Motor.
		$('#frmVehiculo').submit(function () {
			if ($("#txtVin").val() == '' && $("#txtNroMotor").val() == '') {
				alert("Datos insuficientes para realizar la consulta");
				return false;
			}
		});
		{% else %}
		// Resto de los usuarios: se piden los tres campos.
		$('#frmVehiculo').submit(function () {
			if ($("#txtVin").val() == '' || $("#txtDominio").val() == '' || $("#txtNroMotor").val() == '') {
				alert("Completar todos los campos para realizar la consulta");
				return false;
			}
		});
		{% endif %}
	</script>
{% endblock %}
