															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item == 1 ? 'Sí' : 'No' }}</span></div>
														{% elseif key == 'associated_nominal_purpose_id' %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item ~ (propositos[item] is defined ? " - " ~ propositos[item] : '') }}</span></div>
														{% elseif key == 'status_id' %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item ~ (estados[item] is defined ? " - " ~ estados[item] : '') }}</span></div>
														{% elseif key == 'publication_date' %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item|slice(8, 2) ~ "/" ~ item|slice(5, 2) ~ "/" ~ item|slice(0, 4) }}</span></div>
														{% elseif key == 'date' %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item|slice(6, 2) ~ "/" ~ item|slice(4, 2) ~ "/" ~ item|slice(0, 4)|default('NO DATA') }}</span></div>
														{% else %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ (colores[item] is defined ? colores[item] ~ ' / ' : '') ~ item|default('NO DATA') }}</span></div>
														{% endif %}
													{% endif %}
												{% endfor %}
											</div>
										</div>
									{% endif %}

									{# ---------- Pedido de arresto ---------- #}
