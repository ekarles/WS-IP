																{% if "country" in k %}
																	<div class="pd-row"><span class="pd-k">{{ titulos[k]|default(k) }}</span><span class="pd-v">{{ i ~ " - " ~ paises[i]["DESCRIPCION"]|default('NO DATA') }}</span></div>
																{% elseif "_on" in k or "date" in k %}
																	<div class="pd-row"><span class="pd-k">{{ titulos[k]|default(k) }}</span><span class="pd-v">{{ i|slice(6, 2) ~ "/" ~ i|slice(4, 2) ~ "/" ~ i|slice(0, 4)|default('NO DATA') }}</span></div>
																{% else %}
																	<div class="pd-row"><span class="pd-k">{{ titulos[k]|default(k) }}</span><span class="pd-v">{{ i|default('NO DATA') }}</span></div>
																{% endif %}
															{% endif %}
														{% endfor %}
													{% else %}
														{% if key == "country_of_issue_id" %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ paises[item]["DESCRIPCION"]|default('NO DATA') }}</span></div>
														{% elseif "_on" in key or "date" in key %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item|slice(6, 2) ~ "/" ~ item|slice(4, 2) ~ "/" ~ item|slice(0, 4)|default('NO DATA') }}</span></div>
														{% else %}
															<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item|default('NO DATA') }}</span></div>
														{% endif %}
													{% endif %}
												{% endfor %}
											</div>
										</div>
									{% endif %}

									{# ---------- Documento ---------- #}
									{% if nominalDetails["document"] is defined %}
