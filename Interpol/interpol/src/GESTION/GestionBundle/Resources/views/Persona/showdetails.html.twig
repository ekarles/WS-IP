{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
	<style>
		/* ---------- Ficha de persona (tarjetas) ---------- */
		.pd-wrap {
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 15px;
		}
		.pd-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			background: #fff;
			border-radius: 10px;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			padding: 12px 20px;
			margin: 15px 0;
		}
		.pd-topbar img {
			width: 230px;
			max-width: 55%;
		}
		.pd-title {
			margin: 0;
			color: #2d3c90;
			font-size: 22px;
			font-weight: 600;
		}
		.pd-alert {
			background: #fdecea;
			border-left: 5px solid #c0392b;
			border-radius: 8px;
			padding: 12px 18px;
			margin-bottom: 16px;
			color: #5a2b27;
		}
		.pd-alert h4 {
			margin: 0 0 6px;
			color: #a12b20;
			font-weight: 700;
		}
		.pd-alert p {
			margin: 0 0 3px;
			font-size: 14px;
		}
		.pd-hero {
			display: flex;
			flex-wrap: wrap;
			gap: 24px;
			background: #fff;
			border-radius: 12px;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			padding: 22px;
			margin-bottom: 20px;
		}
		.pd-photo {
			flex: 0 0 220px;
			text-align: center;
		}
		.pd-photo .thumbnail {
			margin-bottom: 8px;
			border-radius: 10px;
			overflow: hidden;
		}
		.pd-photo img {
			width: 100%;
			height: auto;
			max-height: 300px;
			object-fit: cover;
		}
		.pd-photo-nav {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			color: #7a8194;
			font-size: 13px;
		}
		.pd-info {
			flex: 1 1 380px;
			min-width: 0;
		}
		.pd-actions {
			float: right;
			margin: 0 0 8px 12px;
		}
		.pd-actions .btn {
			margin-left: 6px;
		}
		.pd-name {
			margin: 0;
			color: #1f2a60;
			font-size: 30px;
			font-weight: 700;
			line-height: 1.1;
			text-transform: uppercase;
			word-break: break-word;
		}
		.pd-forename {
			margin: 2px 0 12px;
			color: #444;
			font-size: 20px;
			text-transform: uppercase;
		}
		.pd-badge {
			display: inline-block;
			margin: 0 8px 6px 0;
			padding: 5px 16px;
			border-radius: 20px;
			background: #555;
			color: #fff;
			font-size: 14px;
			font-weight: 700;
			letter-spacing: 0.5px;
		}
		.pd-chip {
			display: inline-block;
			margin: 0 6px 6px 0;
			padding: 3px 11px;
			border-radius: 14px;
			background: #fff3cd;
			border: 1px solid #f0d98c;
			color: #7a5b00;
			font-size: 12px;
			font-weight: 700;
		}
		.pd-facts {
			display: flex;
			flex-wrap: wrap;
			margin-top: 10px;
		}
		.pd-fact {
			flex: 1 1 200px;
			padding: 6px 12px 6px 0;
		}
		.pd-fact .pd-k {
			display: block;
		}
		.pd-fact .pd-v {
			display: block;
			text-align: left;
		}
		.pd-grid {
			display: flex;
			flex-wrap: wrap;
			margin: 0 -8px;
		}
		.pd-card {
			flex: 1 1 calc(50% - 16px);
			min-width: 320px;
			margin: 0 8px 16px;
			background: #fff;
			border-radius: 12px;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			overflow: hidden;
		}
		.pd-card.pd-full {
			flex-basis: 100%;
		}
		.pd-card-h {
			padding: 11px 18px;
			background: #f4f6fb;
			border-bottom: 1px solid #e3e7f1;
			color: #2d3c90;
			font-size: 15px;
			font-weight: 700;
		}
		.pd-card-h .glyphicon {
			margin-right: 8px;
			opacity: 0.8;
		}
		.pd-card-danger .pd-card-h {
			background: #fdecea;
			border-bottom-color: #f3c7c2;
			color: #a12b20;
		}
		.pd-card-b {
			padding: 6px 18px 10px;
		}
		.pd-row {
			display: flex;
			justify-content: space-between;
			gap: 14px;
			padding: 7px 0;
			border-bottom: 1px solid #f0f2f7;
		}
		.pd-row:last-child {
			border-bottom: 0;
		}
		.pd-k {
			color: #7a8194;
			font-size: 13px;
		}
		.pd-v {
			color: #222;
			font-weight: 600;
			text-align: right;
			word-break: break-word;
		}
		.pd-foot {
			margin: 4px 0 24px;
		}
		.pd-error {
			background: #fff;
			border-radius: 12px;
			border-left: 5px solid #c0392b;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			padding: 18px 22px;
			margin-bottom: 20px;
		}
		.pd-error h4 {
			margin-top: 0;
			color: #a12b20;
			font-weight: 700;
		}
		@media (max-width: 768px) {
			.pd-photo {
				flex-basis: 100%;
			}
			.pd-actions {
				float: none;
				margin: 0 0 10px;
			}
			.pd-name {
				font-size: 24px;
			}
			.pd-card {
				min-width: 100%;
			}
		}

		/* Tabla contenedora (sirve para repetir el pie en cada hoja al imprimir): en pantalla no altera el diseño */
		.pd-pt,
		.pd-pt > tbody,
		.pd-pt > tbody > tr,
		.pd-pt > tbody > tr > td {
			display: block;
			padding: 0;
			border: 0;
		}
		.pd-pt > tfoot {
			display: none;
		}
		/* ---------- Impresión ---------- */
		#pieImpresion {
			display: none;
		}
	</style>
	{# Estilos de impresión: se aplican solo al imprimir. El script de ajuste (ajustarImpresion) los activa un instante
	   para medir el alto y agrandar la letra hasta llenar la hoja A4; todos los tamaños están en rem. #}
	<style id="pdPrintCss" media="print">
		/* El CSS de impresión de Bootstrap fuerza "background: transparent" y "color: #000" con !important en todos los
																																   elementos; por eso los colores de esta hoja llevan !important. */
		@page {
			size: A4 portrait;
			margin: 7mm;
		}
		* {
			-webkit-print-color-adjust: exact !important;
			print-color-adjust: exact !important;
		}
		html {
			font-size: 12px;
		}
		html,
		body {
			background: #fff !important;
		}
		body {
			width: 196mm;
			margin: 0 !important;
			line-height: 1.2 !important;
		}
		nav.navbar,
		.sidebar,
		#dvFlashMsg,
		.footer-zone,
		.animationload,
		.animationload2,
		.modal,
		.modal-backdrop,
		.btn,
		.pd-actions,
		.pd-foot,
		.pd-photo-nav {
			display: none !important;
		}
		#page-wrapper {
			margin: 0 !important;
			padding: 0 !important;
			border: 0 !important;
		}
		.container-fluid {
			padding: 0 !important;
		}

		/* Tabla contenedora: el pie (tfoot) se repite al final de cada hoja */
		.pd-pt {
			display: table !important;
			width: 100%;
			height: 281mm;
			border-collapse: collapse;
			border-spacing: 0;
		}
		.pd-pt > tbody {
			display: table-row-group !important;
		}
		.pd-pt > tfoot {
			display: table-footer-group !important;
		}
		.pd-pt tr {
			display: table-row !important;
			page-break-inside: auto !important;
		}
		.pd-pt td {
			display: table-cell !important;
			padding: 0;
			vertical-align: top;
		}
		.pd-pt > tfoot td {
			vertical-align: bottom;
		}

		.pd-wrap {
			max-width: none;
			padding: 0;
		}
		.pd-topbar {
			box-shadow: none;
			border: 0;
			border-bottom: 1px solid #999;
			border-radius: 0;
			padding: 0 0 0.25rem;
			margin: 0 0 0.4rem;
			background: transparent !important;
		}
		.pd-topbar img {
			width: 9rem;
		}
		.pd-title {
			font-size: 1.33rem;
			color: #2d3c90 !important;
		}
		.pd-alert {
			padding: 0.25rem 0.65rem;
			margin-bottom: 0.4rem;
			border-left: 4px solid #c0392b;
			border-radius: 3px;
			background: #fdecea !important;
		}
		.pd-alert h4 {
			margin: 0 0 0.1rem;
			font-size: 1rem;
			color: #a12b20 !important;
		}
		.pd-alert p {
			margin: 0;
			font-size: 0.78rem;
			line-height: 1.15;
			color: #5a2b27 !important;
		}
		.pd-hero {
			display: flex;
			flex-wrap: nowrap;
			gap: 0.8rem;
			padding: 0.4rem 0.65rem;
			margin-bottom: 0.5rem;
			box-shadow: none;
			border: 1px solid #b9c4dc;
			border-radius: 4px;
			background: #f1f5fc !important;
		}
		.pd-photo {
			flex: 0 0 9.5rem;
		}
		.pd-photo .thumbnail {
			margin: 0;
			padding: 1px;
			border-radius: 3px;
			background: #fff !important;
		}
		.pd-photo img {
			max-height: 12.5rem;
		}
		.pd-info {
			flex: 1 1 auto;
		}
		.pd-name {
			font-size: 1.67rem;
			color: #1f2a60 !important;
		}
		.pd-forename {
			margin: 0 0 0.25rem;
			font-size: 1.22rem;
			color: #333 !important;
		}
		.pd-badge {
			padding: 0.08rem 0.65rem;
			margin: 0 0.3rem 0.15rem 0;
			font-size: 0.89rem;
		}
		.pd-chip {
			padding: 0 0.5rem;
			margin: 0 0.25rem 0.15rem 0;
			font-size: 0.78rem;
			background: #fff3cd !important;
			color: #7a5b00 !important;
		}
		.pd-facts {
			margin-top: 0.15rem;
		}
		.pd-fact {
			flex: 1 1 11rem;
			padding: 0.08rem 0.65rem 0.08rem 0;
		}
		.pd-fact .pd-k {
			font-size: 0.78rem;
		}
		.pd-fact .pd-v {
			font-size: 0.94rem;
		}
		.pd-grid {
			display: block;
			margin: 0;
			-webkit-column-count: 2;
			column-count: 2;
			-webkit-column-gap: 0.5rem;
			column-gap: 0.5rem;
		}
		.pd-card {
			display: block;
			min-width: 0;
			margin: 0 0 0.4rem;
			box-shadow: none;
			border: 1px solid #c3cde0;
			border-radius: 3px;
			background: #fff !important;
			break-inside: avoid;
			page-break-inside: avoid;
			-webkit-column-break-inside: avoid;
		}
		/* Un tono suave y claro distinto por sección */
		.pd-card:nth-child(8n + 1) {
			background: #e3efff !important;
		}
		.pd-card:nth-child(8n + 2) {
			background: #e2f6e8 !important;
		}
		.pd-card:nth-child(8n + 3) {
			background: #fff1d6 !important;
		}
		.pd-card:nth-child(8n + 4) {
			background: #efe6fa !important;
		}
		.pd-card:nth-child(8n + 5) {
			background: #dcf3f1 !important;
		}
		.pd-card:nth-child(8n + 6) {
			background: #fde6ee !important;
		}
		.pd-card:nth-child(8n + 7) {
			background: #eef3d3 !important;
		}
		.pd-card:nth-child(8n + 8) {
			background: #e8ebf0 !important;
		}
		.pd-card.pd-card-danger {
			background: #fdecea !important;
			border-color: #efb9b3;
		}
		.pd-card-h {
			padding: 0.15rem 0.5rem;
			font-size: 0.94rem;
			background: rgba(0, 0, 0, 0.07) !important;
			border-bottom: 1px solid rgba(0, 0, 0, 0.12);
			color: #243a8a !important;
		}
		.pd-card-danger .pd-card-h {
			color: #a12b20 !important;
		}
		.pd-card-h .glyphicon {
			display: none;
		}
		.pd-card-b {
			padding: 0.08rem 0.5rem 0.15rem;
		}
		.pd-row {
			display: block;
			gap: 0;
			padding: 0.1rem 0;
			border-bottom: 1px dotted rgba(0, 0, 0, 0.25);
		}
		.pd-k {
			display: inline;
			font-size: 0.78rem;
			color: #555 !important;
		}
		.pd-k:after {
			content: ": ";
		}
		.pd-v {
			display: inline;
			font-size: 0.89rem;
			text-align: left;
		}
		#pieImpresion {
			display: block;
			margin: 0.3rem 0 0;
			padding-top: 0.2rem;
			border-top: 1px solid #999;
			font-size: 0.89rem;
		}
	</style>
	<form method="POST" action="{{ path('persona_showdetails') }}">
		{% if app.request.get('txtCombinada') is defined and app.request.get('txtCombinada') == 'SI' %}
			<input type="hidden" id="txtCombinadaPer" name="txtCombinada" value="SI"/>
		{% endif %}
		<input type="hidden" id="txtEntity" name="txtEntity" value="{{ app.request.get('txtEntity')|default('') }}"/>
		<input type="hidden" id="txtNombre" name="txtNombre" value="{{ app.request.get('txtNombre')|default('') }}"/>
		<input type="hidden" id="txtApellido" name="txtApellido" value="{{ app.request.get('txtApellido')|default('') }}"/>
		<input type="hidden" id="txtFechaNac" name="txtFechaNac" value="{{ app.request.get('txtFechaNac')|default('') }}"/>
		<input type="hidden" id="lstTipoCons" name="lstTipoCons" value="{{ app.request.get('lstTipoCons')|default('') }}"/>

		<table class="pd-pt">
			<tbody>
				<tr>
					<td>
						<div id="panelTitulo" class="pd-wrap">
							<div class="pd-topbar">
								<img src="{{ asset('bundles/pfa/img/ocnbuenosaires.png') }}"/>
								<p class="pd-title">Interpol - Personas</p>
							</div>
						</div>

						<div id="panelconsulta" class="pd-wrap">
							{% if (nominalDetails.ERROR is defined and nominalDetails.ERROR != '') %}
								<div class="pd-error">
									<h4>Atención se produjo el siguiente mensaje de error:</h4>
									<h3>{{ nominalDetails.ERROR }}</h3>
									<a href="#" onclick="window.history.back(); return false;" role="button" id="btnCerrar1" name="btnCerrar1" class="btn btn-default">Volver</a>
								</div>

							{% else %}

								{# Tipo de notificación (o difusión) para la insignia de color #}
								{% set notifType = '' %}
								{% if nominalDetails["notification"] is defined %}
									{% set notifType = nominalDetails["notification"]["type_id"]|default('') %}
								{% elseif nominalDetails["diffusion"] is defined %}
									{% set notifType = nominalDetails["diffusion"]["type_id"]|default('') %}
								{% endif %}

								{# Colores de cada tipo de notificación (RED, BLUE, etc.); las difusiones usan el color de su tipo #}
								{% set paletaNotif = {
					'RED': ['#d32f2f', '#ffffff'],
					'ORANGE': ['#f57c00', '#ffffff'],
					'BLUE': ['#1565c0', '#ffffff'],
					'YELLOW': ['#fdd835', '#333333'],
					'GREEN': ['#2e7d32', '#ffffff'],
					'BLACK': ['#212121', '#ffffff'],
					'PURPLE': ['#6a1b9a', '#ffffff'],
					'LIGHT BLUE': ['#4fc3f7', '#06324a'],
					'UN': ['#4fc3f7', '#06324a'],
					'SILVER': ['#b0b7c0', '#222222'],
					'DIFUSION': ['#ffffff', '#333333']
				} %}
								{% set claveNotif = notifType|upper|replace({' DIFF': '', 'YELOW': 'YELLOW'}) %}
								{% set pc = paletaNotif[claveNotif] is defined ? paletaNotif[claveNotif] : ['#555555', '#ffffff'] %}

								<div class="pd-alert">
									<h4><span class="glyphicon glyphicon-info-sign"></span> Resultado Positivo!</h4>
									<p>{{ encabezados.leyenda_A }}</p>
									<p>{{ encabezados.leyenda_B }}</p>
									<p>{{ encabezados.leyenda_C }}</p>
									<p>{{ encabezados.leyenda_D }}</p>
									<p>{{ encabezados.leyenda_E }}</p>
									<p>{{ encabezados.leyenda_F }}</p>
								</div>

								<div class="pd-hero"{% if notifType != '' %} style="border-top: 4px solid {{ pc[0] }};"{% endif %}>
									<div class="pd-photo">
										<a class="thumbnail" href="javascript:mostrar(0)">
											{% if arrayImg|length > 0 %}
												<img id="imagen" src="{{ arrayImg[0]|default('') }}">
											{% else %}
												<img id="imagen" src="{{ asset('bundles/images/unknown.png') }}">
											{% endif %}
										</a>
										<div class="pd-photo-nav">
											<button type="button" class="btn btn-default btn-sm" disabled>
												<span class="glyphicon glyphicon-chevron-left"></span>
											</button>
											<span id="nroFoto">{{ arrayImg|length == 0 ? '0' : '1' }} de {{ arrayImg|length }}</span>
											<button type="button" class="btn btn-default btn-sm" disabled>
												<span class="glyphicon glyphicon-chevron-right"></span>
											</button>
										</div>
									</div>

									<div class="pd-info">
										<div class="pd-actions">
											<a href="#" role="button" id="btnCerrar1" name="btnCerrar1" onclick="window.history.back(); return false;" class="btn btn-default"><span class="glyphicon glyphicon-arrow-left"></span> Volver</a>
											<a href="#" role="button" id="btnImprimir" name="btnImprimir" class="btn btn-default" onclick="window.print(); return false;"><span class="glyphicon glyphicon-print"></span> Imprimir</a>
											<a href="#" role="button" id="btnReintentar" name="btnReintentar" class="btn btn-default"><span class="glyphicon glyphicon-refresh"></span> Reintentar</a>
											{# PDF original de la notificación: uno por cada archivo "notification" informado (puede haber más de uno por idioma) #}
											{% set pdfFiles = nominalDetails["notification"]["file"]|default(nominalDetails["diffusion"]["file"]|default([])) %}
											{% if pdfFiles["ref"] is defined or pdfFiles["path"] is defined %}{% set pdfFiles = [pdfFiles] %}{% endif %}
											{% for pf in pdfFiles %}
												{# la ruta del PDF puede venir en "ref" o en "path", según la versión del esquema #}
												{% set rutaPdf = pf.ref|default(pf.path|default('')) %}
												{% if rutaPdf != '' and 'notification' in pf.type_id|default('notification')|lower %}
													<a href="#" role="button" class="btn btn-default" data-ref="{{ rutaPdf }}" onclick="descargarNoticiaPdf(this); return false;" title="Abre el PDF original de la notificación en una ventana nueva"><span class="glyphicon glyphicon-download-alt"></span> PDF original{{ pdfFiles|length > 1 and pf.language_id is defined ? ' (idioma ' ~ pf.language_id ~ ')' : '' }}</a>
												{% endif %}
											{% endfor %}
										</div>

										<h2 class="pd-name">{{ nominalDetails["name"]|default('NO DATA') }}</h2>
										<div class="pd-forename">{{ nominalDetails["forename"]|default('NO DATA') }}</div>

										<div>
											{% if notifType != '' %}
												<span class="pd-badge" style="background-color: {{ pc[0] }} !important; color: {{ pc[1] }} !important; border: 1px solid rgba(0, 0, 0, .35);">
													Notificación:
													{% if notifType in colores|keys %}
														{{ colores[notifType] ~ " / " ~ notifType }}
													{% else %}
														{{ notifType }}
													{% endif %}
												</span>
											{% endif %}
										</div>

										{# Precauciones como etiquetas #}
										{% if nominalDetails["caution"] is defined %}
											{% set cauts = nominalDetails["caution"] %}
											{% if cauts["caution_id"] is defined %}{% set cauts = [cauts] %}{% endif %}
											<div>
												{% for itemt in cauts %}
													<span class="pd-chip"><span class="glyphicon glyphicon-warning-sign"></span> {{ itemt.caution_id|default('NO DATA') ~ (caution[itemt.caution_id|default('')] is defined ? " - " ~ caution[itemt.caution_id|default('')] : '') }}</span>
												{% endfor %}
											</div>
										{% endif %}

										<div class="pd-facts">
											{% if nominalDetails["sex_id"] is defined %}
												<div class="pd-fact"><span class="pd-k">{{ titulos["sex_id"] }}</span><span class="pd-v">{{ nominalDetails["sex_id"]|default('NO DATA') }}</span></div>
											{% endif %}
											{% if nominalDetails["date_of_birth"] is defined %}
												<div class="pd-fact"><span class="pd-k">{{ titulos["date_of_birth"] }}</span><span class="pd-v">{{ nominalDetails["date_of_birth"]|slice(6, 2) ~ "/" ~ nominalDetails["date_of_birth"]|slice(4, 2) ~ "/" ~ nominalDetails["date_of_birth"]|slice(0, 4)|default('NO DATA') }}</span></div>
