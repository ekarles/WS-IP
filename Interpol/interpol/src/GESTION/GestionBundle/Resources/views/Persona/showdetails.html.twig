												<div class="pd-row"><span class="pd-k">Tipo de Alias</span><span class="pd-v">{{ nominalDetails["@attributes"]["qualification_id"] ~ (Alias_Qualification[nominalDetails["@attributes"]["qualification_id"]] is defined ? " - " ~ Alias_Qualification[nominalDetails["@attributes"]["qualification_id"]] : '') }}</span></div>
