													{% for clave, valor in nominalDetails["nickname"] %}
														<div class="pd-fact"><span class="pd-k">{{ titulos["nickname"] }}</span><span class="pd-v">{{ valor|default('NO DATA') }}</span></div>
													{% endfor %}
												{% else %}
													<div class="pd-fact"><span class="pd-k">{{ titulos["nickname"] }}</span><span class="pd-v">{{ nominalDetails["nickname"]|default('NO DATA') }}</span></div>
