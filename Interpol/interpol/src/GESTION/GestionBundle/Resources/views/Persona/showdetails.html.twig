													<div class="pd-row"><span class="pd-k">{{ offsN|length > 1 ? 'Delito ' ~ loop.index : 'Delito' }}</span><span class="pd-v">{{ off.offence_id|default('NO DATA') ~ (Offences_Code[off.offence_id|default('')] is defined ? " - " ~ Offences_Code[off.offence_id|default('')] : '') }}</span></div>
												{% endfor %}
												{# Propósito asociado: puede venir un solo código o una lista de códigos; se traduce con el diccionario #}
												{% set propsN = nominalDetails["notification"]["associated_nominal_purpose_id"]|default([]) %}
												{% if propsN is not iterable %}{% set propsN = [propsN] %}{% endif %}
												{% for p in propsN %}
													<div class="pd-row"><span class="pd-k">{{ (titulos['associated_nominal_purpose_id']|default('Propósito asociado')) ~ (propsN|length > 1 ? ' ' ~ loop.index : '') }}</span><span class="pd-v">{{ p ~ (propositos[p] is defined ? " - " ~ propositos[p] : '') }}</span></div>
												{% endfor %}
												{% for key, item in nominalDetails["notification"]|default('') if key != 'offence' and key != 'associated_nominal_purpose_id' %}
													{% if item is iterable %}
														{% for keyI, itemI in item %}
															{% if itemI is not iterable and itemI|length > 0 %}
																{% if 'date' in keyI %}
																	<div class="pd-row"><span class="pd-k">{{ titulos[keyI]|default(keyI) }}</span><span class="pd-v">{{ itemI|slice(6, 2) ~ "/" ~ itemI|slice(4, 2) ~ "/" ~ itemI|slice(0, 4)|default('NO DATA') }}</span></div>
																{% else %}
																	<div class="pd-row"><span class="pd-k">{{ titulos[keyI]|default(keyI) }}</span><span class="pd-v">{{ (colores[itemI] is defined ? colores[itemI] ~ ' / ' : '') ~ itemI|default('NO DATA') }}</span></div>
																{% endif %}
															{% endif %}
														{% endfor %}
													{% else %}
														{% if item|length == 0 %}{# campo vacío: no se muestra #}
