														</div>
													{% endif %}
													{% if al.date_of_birth is defined %}
														<div class="pd-row">
															<span class="pd-k">Fecha de nacimiento</span>
															<span class="pd-v">{{ al.date_of_birth|slice(6, 2) ~ "/" ~ al.date_of_birth|slice(4, 2) ~ "/" ~ al.date_of_birth|slice(0, 4) }}</span>
														</div>
													{% endif %}
													{% if al.place_of_birth is defined %}
														<div class="pd-row">
															<span class="pd-k">Lugar de nacimiento</span>
															<span class="pd-v">{{ al.place_of_birth }}</span>
														</div>
													{% endif %}
													{% if al.country_of_birth_id is defined %}
														<div class="pd-row">
															<span class="pd-k">País de nacimiento</span>
															<span class="pd-v">{{ al.country_of_birth_id }}{% if paises[al.country_of_birth_id] is defined %} - {{ paises[al.country_of_birth_id]["DESCRIPCION"] }}{% endif %}</span>
														</div>
													{% endif %}
												{% endfor %}
											</div>
										</div>
									{% endif %}

									{# ---------- Padre ---------- #}
									{% if nominalDetails["father"] is defined %}
										<div class="pd-card">
											<div class="pd-card-h"><span class="glyphicon glyphicon-user"></span>Padre</div>
											<div class="pd-card-b">
												{% for keyf, itemf in nominalDetails["father"]|default('') %}
													<div class="pd-row"><span class="pd-k">{{ keyf == 'forename' ? 'Nombre' : 'Apellido' }}</span><span class="pd-v">{{ itemf|default('NO DATA') }}</span></div>
												{% endfor %}
											</div>
										</div>
									{% endif %}

									{# ---------- Madre ---------- #}
									{% if nominalDetails["mother"] is defined %}
										<div class="pd-card">
											<div class="pd-card-h"><span class="glyphicon glyphicon-user"></span>Madre</div>
											<div class="pd-card-b">
												{% for keym, itemm in nominalDetails["mother"]|default('') %}
													<div class="pd-row"><span class="pd-k">{{ keym == 'forename' ? 'Nombre' : 'Apellido' }}</span><span class="pd-v">{{ itemm|default('NO DATA') }}</span></div>
												{% endfor %}
											</div>
										</div>
									{% endif %}

									{# ---------- Historia criminal ---------- #}
									{% if nominalDetails["criminal_history"] is defined %}
										<div class="pd-card pd-card-danger">
											<div class="pd-card-h"><span class="glyphicon glyphicon-exclamation-sign"></span>Historia Criminal</div>
											<div class="pd-card-b">
												{% for keyc, itemc in nominalDetails["criminal_history"]|default('') %}
													{% if itemc is iterable %}
														{% for keyd, itemd in itemc|default('') %}
															<div class="pd-row"><span class="pd-k">{{ titulos[keyd]|default(keyd) }}</span><span class="pd-v">{{ itemd ~ ' - ' ~ Offences_Code[itemd]|default('NO DATA') }}</span></div>
														{% endfor %}
													{% else %}
														<div class="pd-row"><span class="pd-k">{{ titulos[keyc]|default(keyc) }}</span><span class="pd-v">{{ itemc ~ ' - ' ~ Offences_Code[itemc]|default('NO DATA') }}</span></div>
													{% endif %}
												{% endfor %}
											</div>
										</div>
									{% endif %}

									{# ---------- Icis ---------- #}
									{% if nominalDetails["icis"] is defined and nominalDetails["icis"] is not empty %}
										<div class="pd-card">
											<div class="pd-card-h"><span class="glyphicon glyphicon-th-list"></span>Icis</div>
											<div class="pd-card-b">
												{% for key, itemi in nominalDetails["icis"]|default('') %}
													<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ itemi|default('NO DATA') }}</span></div>
												{% endfor %}
											</div>
										</div>
									{% endif %}

									{# ---------- Archivo ---------- #}
									{% if nominalDetails["file"] is defined %}
										<div class="pd-card">
											<div class="pd-card-h"><span class="glyphicon glyphicon-paperclip"></span>Archivo</div>
											<div class="pd-card-b">
												{% for key, item in nominalDetails["file"]|default('') %}
													{% if item is iterable %}
														{% for k, i in item|default('') %}
															{% if i is iterable %}
																{% for clave, valor in i %}
																	<div class="pd-row"><span class="pd-k">{{ titulos[clave]|default(clave) }}</span><span class="pd-v">{{ valor|default('NO DATA') }}</span></div>
																{% endfor %}
															{% else %}
																<div class="pd-row"><span class="pd-k">{{ titulos[k]|default(k) }}</span><span class="pd-v">{{ i|default('NO DATA') }}</span></div>
															{% endif %}
														{% endfor %}
													{% else %}
														<div class="pd-row"><span class="pd-k">{{ titulos[key]|default(key) }}</span><span class="pd-v">{{ item|default('NO DATA') }}</span></div>
													{% endif %}
												{% endfor %}
											</div>
										</div>
									{% endif %}

								</div>

								<div class="pd-foot">
									<button type="button" id="btnCerrar3" name="btnCerrar3" class="btn btn-default" onclick="window.history.back();"><span class="glyphicon glyphicon-arrow-left"></span> Volver</button>
								</div>
							{% endif %}	<!-- if (nominalDetails.ERROR is defined) -->

							<div class="modal fade" id="MensajeConfirmacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
								<div class="modal-dialog" role="document">
									<div class="modal-content">
										<div class="modal-header modal-header-danger">
											<h5 class="modal-title text-center" id="exampleModalLabel"><b>Confirmación</b></h5>
										</div>
										<div class="modal-body text-center" id="dvMensaje"></div>
										<div class="modal-footer">
											<button
												type="button"
												class="btn btn-default res"
												data-dismiss="modal"
											>Cancelar</button>
											<button type="button" class="btn btn-danger res" data-dismiss="modal" onClick="mostrarDetalle();">Aceptar</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</td>
				</tr>
			</tbody>
			<tfoot>
				<tr>
					<td>
						{# Pie de impresión: siempre al pie de cada hoja impresa #}
						<div id="pieImpresion">
							Consulta realizada por <strong>{{ datosImpresion.usuario|default('') }}</strong>{% if datosImpresion.dependencia|default('') != '' %} - {{ datosImpresion.dependencia }}{% endif %} - {{ datosImpresion.fecha|default('') }}
						</div>
					</td>
				</tr>
			</tfoot>
		</table>
	</form>
	<div class="bootbox modal fade bootbox-alert in" tabindex="-1" role="dialog" id="showImages">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header" style="text-align:center;color: #a94442;background-color: #f2dede;border-color: #ebccd1;">
					<h4 class="modal-title">Fotos Disponibles</h4>
				</div>
				<div class="modal-body">
					<div class="bootbox-body">
						<a href="javascript:void(0)" class="thumbnail"><img id="imgMostrar" src="{{ asset('bundles/images/unknown.png') }}"></a>
					</div>
				</div>
				<div class="modal-footer">
					<table _ngcontent-xyt-6="" width="100%">
						<tbody _ngcontent-xyt-6=""><tr _ngcontent-xyt-6="">
								<tr>
									<td width="20%">
										<button class="btn btn-default center-block" disabled>
											<span class="glyphicon glyphicon-chevron-left"></span>
										</button>
									</td>
									<td width="60%">
										<p class="text-center" style="padding-top:10px;" id="nroFotoMostrar">{{ arrayImg|length == 0 ? '0' : '1' }} de {{ arrayImg|length }}</p>
									</td>
									<td width="20%">
										<button class="btn btn-default center-block" disabled>
											<span class="glyphicon glyphicon-chevron-right"></span>
										</button>
									</td>
								</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
	<script languaje="javascript">
	var arrayImg = new Array();
	var cont = 0;
	var idx=0;

	{% for img in arrayImg %}
		arrayImg.push('{{img}}');
		cont++;
	{% endfor %}

    $(document).ready(function () {
        {% if arrayImg|length > 1 %}
        	addIdxImg(cont);
        {% endif %}

		$("#showImages").on('hidden.bs.modal', function () {
			checkIconos();
		});

		$("#showImages").on('show.bs.modal', function () {
			checkIconos();
		});

    });

    $( "#btnReintentar" ).click(function() {
		confirmaDetalle( $("#txtNombre").val(), $("#txtApellido").val(), $("#txtFechaNac").val(), $("#txtEntity").val() );
    });

    $( "#btnCerrar" ).click(function() {
    	cerrar();
    });

    $( "#btnCerrar2" ).click(function() {
    	cerrar();
    });

	function checkIconos(){
		if(idx==(cont-1)){
			$(".glyphicon-chevron-right").parent().attr("disabled","");
		}
		if(idx==0){
			$(".glyphicon-chevron-left").parent().attr("disabled","");
		}
	}

    function confirmaDetalle( pApellido, pNombre, pFechaNac, pEntity ){
		$("#txtEntity").val( pEntity );
    	$('#dvMensaje').html( "¿Est&aacute; seguro de que quiere consultar los datos de <b>" + pApellido + ", " + pNombre + "</b>, fecha de nacimiento: <b>"+pFechaNac+"</b>?<br/><br/><b>ESTA ACCI&Oacute;N PUEDE GENERAR ALARMAS</b>." );
		$('#btDetalle').attr('onclick', '');
		$('#btDetalle').click(function() {
			mostrarDetalle();
		});
    	$('#MensajeConfirmacion').modal( 'show' );
    }	//	function mostrarDivDetalle(){

	function mostrarDetalle( ){
		if( $( "#txtEntity" ).val() == ""){
			alert("Para ver el detalle volver a seleccionar un renglón haciendo click en la lupa del mismo.");
			return false;
		}	//	if( $( "#txtEntity" ).val() == ""){
		$( "form" ).submit();
	}	//	function mostrarDetalle( ){

    function cerrar(){
    	{% if app.request.get('txtCombinada') is defined and app.request.get('txtCombinada')=='SI' %}
    		$('form').attr('action', '{{ path('combinada') }}');
		{% else %}
			$('form').attr('action', '{{ path('persona') }}');
		{% endif %}

    	$( "form" ).submit();
    }

    function addIdxImg(cant){
    	$(".glyphicon-chevron-right").parent().removeAttr("disabled");
    	$(".glyphicon-chevron-right").parent().unbind();
    	$(".glyphicon-chevron-left").parent().unbind();

    	$(".glyphicon-chevron-right").parent().click(function(e){

			e.preventDefault();
    		idx++;

    		if(idx==1){
    			$(".glyphicon-chevron-left").parent().removeAttr("disabled");
    		}
    		if(idx==(cant-1)){
    			$(this).attr("disabled","");
    		}
    		$("#imagen").attr('src',arrayImg[idx]);
    		$("#imgMostrar").attr('src',arrayImg[idx]);
    		$("#imagen").parent().attr('href','javascript:mostrar('+idx+')');
    		$("#nroFoto").html((idx+1)+" de " + cant);
    		$("#nroFotoMostrar").html((idx+1)+" de " + cant);
    	});

    	$(".glyphicon-chevron-left").parent().click(function(e){
    		e.preventDefault();
    		idx--;
    		if(idx==0){
    			$(this).attr("disabled","");
    		}
    		if(idx<(cant-1)){
    			$(".glyphicon-chevron-right").parent().removeAttr("disabled");
    		}
    		$("#imagen").attr('src',arrayImg[idx]);
    		$("#imgMostrar").attr('src',arrayImg[idx]);
    		$("#imagen").parent().attr('href','javascript:mostrar('+idx+')');
    		$("#nroFoto").html((idx+1)+" de " + cant);
    		$("#nroFotoMostrar").html((idx+1)+" de " + cant);
    	});
    }

    //  Impresión: activa un instante los estilos de impresión, mide el alto de la ficha y agranda la letra
    //  (los tamaños de impresión están en rem) hasta aprovechar el alto de la hoja A4.
    //  Si el contenido no entra en una sola hoja se imprime con el tamaño base y sigue en la hoja siguiente.
    function ajustarImpresion(){
        var estilo = document.getElementById('pdPrintCss');
        var pie = document.getElementById('pieImpresion');
        var titulo = document.getElementById('panelTitulo');
        var consulta = document.getElementById('panelconsulta');
        if (!estilo || !pie || !titulo || !consulta) {
            return;
        }

        var raiz = document.documentElement;
        var altoHoja = (297 - 14) / 25.4 * 96 * 0.98;   // A4 menos márgenes de 7 mm, con un pequeño margen de seguridad
        var altoActual = function () {
            //  alto del contenido + alto del pie (que va al final de la hoja)
            return (consulta.getBoundingClientRect().bottom - titulo.getBoundingClientRect().top) + pie.offsetHeight;
        };

        estilo.media = 'all';
        try {
            raiz.style.fontSize = '';
            if (altoActual() < altoHoja) {
                var min = 1, max = 1.6;
                for (var i = 0; i < 8; i++) {
                    var medio = (min + max) / 2;
                    raiz.style.fontSize = (12 * medio) + 'px';
                    if (altoActual() <= altoHoja) {
                        min = medio;
                    } else {
                        max = medio;
                    }
                }
                raiz.style.fontSize = (12 * min) + 'px';
            }
        } finally {
            estilo.media = 'print';
        }
    }

    function restaurarImpresion(){
        document.documentElement.style.fontSize = '';
        var estilo = document.getElementById('pdPrintCss');
        if (estilo) {
            estilo.media = 'print';
        }
    }

    window.addEventListener('beforeprint', ajustarImpresion);
    window.addEventListener('afterprint', restaurarImpresion);

    //  PDF original de la notificación: se pide por POST en una ventana nueva (la página ya está dentro de un formulario,
    //  por eso se arma uno temporal). El navegador lo muestra en su visor y desde ahí se puede descargar.
    function descargarNoticiaPdf(boton){
    	var campos = [
    		['pathToNotice', $(boton).attr('data-ref')],
    		['lstTipoCons', $('#lstTipoCons').val()]
    	];

    	var f = document.createElement('form');
    	f.method = 'POST';
    	f.action = "{{ path('persona_noticepdf') }}";
    	f.target = '_blank';

    	for (var i = 0; i < campos.length; i++) {
    		var input = document.createElement('input');
    		input.type = 'hidden';
    		input.name = campos[i][0];
    		input.value = campos[i][1] || '';
    		f.appendChild(input);
    	}

    	document.body.appendChild(f);
    	f.submit();
    	document.body.removeChild(f);
    }

    function mostrar(idx){
    	if(idx >= 0){
    		$("#imgMostrar").attr('src',arrayImg[idx]);
    	}
    	$("#showImages").modal();
    }

    </script>
{% endblock %}
