{% extends 'GESTIONGestionBundle::base.html.twig' %}

{% block body -%}
	<style>
		.pf-wrap {
			max-width: 760px;
			margin: 15px auto 30px;
			padding: 0 15px;
		}
		.pf-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			background: #fff;
			border-radius: 10px;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			padding: 12px 20px;
			margin-bottom: 16px;
		}
		.pf-topbar img {
			width: 230px;
			max-width: 55%;
		}
		.pf-title {
			margin: 0;
			color: #2d3c90;
			font-size: 22px;
			font-weight: 600;
		}
		.pf-card {
			background: #fff;
			border-radius: 12px;
			box-shadow: 0 1px 4px rgba(20, 30, 70, 0.12);
			margin-bottom: 16px;
			overflow: visible;
		}
		.pf-card-h {
			border-radius: 12px 12px 0 0;
			padding: 11px 18px;
			background: #f4f6fb;
			border-bottom: 1px solid #e3e7f1;
			color: #2d3c90;
			font-size: 15px;
			font-weight: 700;
		}
		.pf-card-h .glyphicon {
			margin-right: 8px;
			opacity: 0.8;
		}
		.pf-card-b {
			padding: 16px 18px 6px;
		}
		.pf-fields {
			display: flex;
			flex-wrap: wrap;
			margin: 0 -8px;
		}
		.pf-field {
			flex: 1 1 200px;
			padding: 0 8px;
			margin-bottom: 14px;
		}
		.pf-field label {
			display: block;
			margin-bottom: 5px;
			color: #5d6678;
			font-size: 13px;
			font-weight: 600;
		}
		.pf-card .form-control {
			height: 40px;
			border-radius: 8px;
			border: 1px solid #cdd4e4;
			box-shadow: none;
		}
		.pf-card .form-control:focus {
			border-color: #2d3c90;
			box-shadow: 0 0 0 2px rgba(45, 60, 144, 0.15);
		}
		.pf-req {
			color: #d9534f;
		}
		.pf-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 12px;
		}
		.pf-actions .btn {
			flex: 1 1 200px;
			padding: 10px 0;
			border-radius: 8px;
			font-size: 16px;
		}
		.pf-actions .btn i {
			margin-right: 6px;
		}
		.bootstrap-select:not([class*="col-"]):not([class*="form-control"]):not(
				.input-group-btn
			) {
			width: 100% !important;
		}
		@media (max-width: 767px) {
			.pf-wrap {
				margin-top: 8px;
			}
			.pf-topbar {
				flex-direction: column;
				gap: 6px;
				text-align: center;
			}
		}
	</style>

	<form method="POST" id="frm" action="{{ path('arma_show') }}">
		<div id="panelconsulta" class="pf-wrap">

			<div class="pf-topbar">
				<img src="{{ asset('bundles/pfa/img/ocnbuenosaires.png') }}"/>
				<p class="pf-title">Interpol - Armas</p>
			</div>

			<div class="pf-card">
				<div class="pf-card-h"><span class="glyphicon glyphicon-screenshot"></span>Datos del arma</div>
				<div class="pf-card-b">
					<div class="pf-fields">
						<div class="pf-field">
							<label for="txtSN">Número de Serie
								<span class="pf-req">*</span>
							</label>
							<input type="text" id="txtSN" name="txtSN" value="" required="required" placeholder="Ingrese Nro. de serie de arma" class="form-control"/>
						</div>
						<div class="pf-field">
							<label for="txtMarca">Marca</label>
							<input type="text" id="txtMarca" name="txtMarca" placeholder="Ingrese marca de arma" value="" class="form-control"/>
						</div>
						<div class="pf-field">
							<label for="txtModelo">Modelo</label>
							<input type="text" id="txtModelo" name="txtModelo" placeholder="Ingrese modelo de arma" value="" class="form-control"/>
						</div>
						<div class="pf-field">
							<label for="txtCalibre">Calibre</label>
							<input type="text" id="txtCalibre" name="txtCalibre" placeholder="Ingrese calibre de arma" value="" class="form-control"/>
						</div>
						<div class="pf-field">
							<label for="txtFabricante">Fabricante</label>
							<input type="text" id="txtFabricante" name="txtFabricante" placeholder="Ingrese fabricante de arma" value="" class="form-control"/>
						</div>
						<div class="pf-field">
							<label for="txtTipo">Tipo
								<span class="pf-req">*</span>
							</label>
							<select id="txtTipo" name="txtTipo" required="required" class="selectpicker">
								<option value="1" selected>Seleccione el tipo de arma</option>
								<option value="1">1 - Commercial Version</option>
								<option value="2">2 - Combination Gun</option>
								<option value="3">3 - Handgun</option>
								<option value="4">4 - Machine Gun</option>
								<option value="5">5 - Rifle</option>
								<option value="6">6 - Shotgun</option>
								<option value="7">7 - Submachine Gun</option>
								<option value="8">8 - Other</option>
								<option value="9">9 - Cannon</option>
								<option value="10">10 - Grenade Launcher</option>
								<option value="11">11 - Mortar</option>
								<option value="12">12 - Airsoft</option>
							</select>
						</div>
					</div>
				</div>
			</div>

			<div class="pf-card">
				<div class="pf-card-h"><span class="glyphicon glyphicon-calendar"></span>Período</div>
				<div class="pf-card-b">
					<div class="pf-fields">
						<div class="pf-field">
							<label for="dtfechaDesde">Fecha desde</label>
							<input type="date" id="dtfechaDesde" name="dtfechaDesde" value="{{ app.request.get('dtfechaDesde') }}" class="form-control">
						</div>
						<div class="pf-field">
							<label for="dtFechaHasta">Fecha hasta</label>
							<input type="date" id="dtFechaHasta" name="dtFechaHasta" value="{{ app.request.get('dtFechaHasta') }}" class="form-control">
						</div>
					</div>
				</div>
			</div>

			<div class="pf-actions">
				<button class="btn btn-success" data-toggle="tooltip" id="consultar" title="Consultar" type="submit" data-placement="bottom">
					<i class="fa fa-search" aria-hidden="true"></i>
					Consultar
				</button>
				<button id="sendForm" type="submit" class="hide"></button>
				<button class="btn btn-default" data-toggle="tooltip" title="Limpiar Parámetros de Búsqueda" id="limpiar" type="button" data-placement="bottom">
					<i class="fa fa-undo" aria-hidden="true"></i>
					Limpiar Búsqueda
				</button>
			</div>

		</div>
	</form>

	<script>
		$("#limpiar").click(function () {
			$("#txtSN, #txtMarca, #txtModelo, #txtCalibre, #txtFabricante").val("");
			$("#dtfechaDesde, #dtFechaHasta").val("");
			$("#txtTipo").val("1").selectpicker("refresh");
		});
	</script>
{% endblock %}
