<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="ADMIN\AdminBundle\Entity\AlarmaRepository" name="ADMIN\AdminBundle\Entity\Alarma" table="ALARMA">
    <id name="alarid" association-key="true"/>
    <field name="entityid" type="string" column="ENTITYID" length="255" precision="0" scale="0" nullable="true"/>
    <field name="fecha" type="datetime" column="FECHA" precision="0" scale="0" nullable="true"/>
    <field name="modoconsulta" type="string" column="MODOCONSULTA" length="255" precision="0" scale="0" nullable="true"/>
    <field name="passgenerico" type="string" column="PASSGENERICO" length="255" precision="0" scale="0" nullable="true"/>
    <field name="respuesta" type="text" column="RESPUESTA" precision="0" scale="0" nullable="true"/>
    <field name="usuario" type="string" column="USUARIO" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuarioapellido" type="string" column="USUARIOAPELLIDO" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuariodepen" type="string" column="USUARIODEPEN" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuariodepenid" type="string" column="USUARIODEPENID" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuariodoc" type="string" column="USUARIODOC" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuariogenerico" type="string" column="USUARIOGENERICO" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuarioip" type="string" column="USUARIOIP" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuariojerarquia" type="string" column="USUARIOJERARQUIA" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuarionombre" type="string" column="USUARIONOMBRE" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuariotipodoc" type="string" column="USUARIOTIPODOC" length="255" precision="0" scale="0" nullable="true"/>
    <one-to-one field="alarid" target-entity="ADMIN\AdminBundle\Entity\InterpolLogMv">
      <join-columns>
        <join-column name="ALARID" referenced-column-name="IA_ID" nullable="1"/>
      </join-columns>
    </one-to-one>
    <many-to-one field="altiidinicial" target-entity="ADMIN\AdminBundle\Entity\Alarmatipo">
      <join-columns>
        <join-column name="ALTIIDINICIAL" referenced-column-name="ALTIID" nullable="1"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="estadoid" target-entity="ADMIN\AdminBundle\Entity\Alarmaestado">
      <join-columns>
        <join-column name="ESTADOID" referenced-column-name="ESTADOID" nullable="1"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="tipodelitoid" target-entity="ADMIN\AdminBundle\Entity\Tipodelito">
      <join-columns>
        <join-column name="TIPODELITOID" referenced-column-name="TIPODELITOID" nullable="1"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="altiid" target-entity="ADMIN\AdminBundle\Entity\Alarmatipo">
      <join-columns>
        <join-column name="ALTIID" referenced-column-name="ALTIID" nullable="1"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
