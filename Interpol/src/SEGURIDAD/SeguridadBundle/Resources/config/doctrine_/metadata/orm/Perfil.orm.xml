<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="Perfil" table="PERFIL">
    <id name="perfilid" type="integer" column="PERFILID">
      <generator strategy="SEQUENCE"/>
    </id>
    <field name="borrado" type="integer" column="BORRADO" nullable="true"/>
    <field name="descripcion" type="string" column="DESCRIPCION" length="80" nullable="true"/>
    <field name="nombre" type="string" column="NOMBRE" length="60" nullable="true"/>
    <many-to-many field="usuarioid" target-entity="Usuario" inversed-by="perfilid">
      <join-table name="usuarioperfil">
        <join-columns>
          <join-column name="PERFILID" referenced-column-name="PERFILID"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="USUARIOID" referenced-column-name="USUARIOID"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
    <many-to-many field="permisoid" target-entity="Permiso" inversed-by="perfilid">
      <join-table name="perfilpermiso">
        <join-columns>
          <join-column name="PERFILID" referenced-column-name="PERFILID"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="PERMISOID" referenced-column-name="PERMISOID"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
  </entity>
</doctrine-mapping>
