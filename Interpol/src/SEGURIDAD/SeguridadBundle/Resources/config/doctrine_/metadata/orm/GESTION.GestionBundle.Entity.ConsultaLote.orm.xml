<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="GESTION\GestionBundle\Entity\ConsultaLoteRepository" name="GESTION\GestionBundle\Entity\ConsultaLote" table="ConsultaLote">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
    </id>
    <field name="tipoLote" type="string" column="TipoLote" length="1" precision="0" scale="0" nullable="false"/>
    <field name="archivo" type="blob" column="Archivo" precision="0" scale="0" nullable="false"/>
    <field name="archivoNombre" type="string" column="ArchivoNombre" length="250" precision="0" scale="0" nullable="false"/>
    <field name="fecAlta" type="string" column="FecAlta" precision="0" scale="0" nullable="false"/>
    <field name="estado" type="string" column="Estado" length="1" precision="0" scale="0" nullable="false"/>
    <field name="error" type="integer" column="Error" precision="0" scale="0" nullable="false"/>
    <one-to-many field="consultaLoteDetalle" target-entity="GESTION\GestionBundle\Entity\ConsultaLoteDetalle" mapped-by="consultaLoteId"/>
    <many-to-one field="usuario" target-entity="SEGURIDAD\SeguridadBundle\Entity\Usuario">
      <join-columns>
        <join-column name="USUARIOID" referenced-column-name="USUARIOID" nullable=""/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
