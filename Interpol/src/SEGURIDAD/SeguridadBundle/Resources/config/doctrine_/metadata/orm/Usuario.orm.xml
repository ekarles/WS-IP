<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="Usuario" table="USUARIO">
    <id name="usuarioid" type="integer" column="USUARIOID">
      <generator strategy="SEQUENCE"/>
    </id>
    <field name="activo" type="integer" column="ACTIVO" nullable="true"/>
    <field name="apellido" type="string" column="APELLIDO" length="255" nullable="true"/>
    <field name="borrado" type="integer" column="BORRADO" nullable="true"/>
    <field name="consulta" type="string" column="CONSULTA" length="50" nullable="true"/>
    <field name="expiracionpassword" type="date" column="EXPIRACIONPASSWORD" nullable="true"/>
    <field name="fechaalta" type="date" column="FECHAALTA" nullable="true"/>
    <field name="fechaborrado" type="date" column="FECHABORRADO" nullable="true"/>
    <field name="fechadesactivado" type="date" column="FECHADESACTIVADO" nullable="true"/>
    <field name="iphabilitada" type="string" column="IPHABILITADA" length="250" nullable="true"/>
    <field name="jerarquia" type="string" column="JERARQUIA" length="255" nullable="true"/>
    <field name="nombre" type="string" column="NOMBRE" length="255" nullable="true"/>
    <field name="numerodoc" type="string" column="NUMERODOC" length="255" nullable="true"/>
    <field name="password" type="string" column="PASSWORD" length="255" nullable="true"/>
    <field name="sessionid" type="string" column="SESSIONID" length="50" nullable="true"/>
    <field name="tipodoc" type="string" column="TIPODOC" length="255" nullable="true"/>
    <field name="ultimaip" type="string" column="ULTIMAIP" length="60" nullable="true"/>
    <field name="ultimologin" type="date" column="ULTIMOLOGIN" nullable="true"/>
    <field name="usuario" type="string" column="USUARIO" length="255" nullable="true"/>
    <field name="usuarioalta" type="integer" column="USUARIOALTA" nullable="true"/>
    <many-to-one field="depenid" target-entity="Dependencia">
      <join-columns>
        <join-column name="DEPENID" referenced-column-name="DEPENID"/>
      </join-columns>
    </many-to-one>
    <many-to-many field="perfilid" target-entity="Perfil" mapped-by="usuarioid"/>
    <many-to-many field="permisoid" target-entity="Permiso" mapped-by="usuarioid"/>
  </entity>
</doctrine-mapping>
