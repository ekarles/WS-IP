<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="SEGURIDAD\SeguridadBundle\Entity\Usuario" table="USUARIO">
    <id name="id" type="integer" column="USUARIOID">
      <generator strategy="SEQUENCE"/>
    </id>
    <field name="activo" type="integer" column="ACTIVO" precision="0" scale="0" nullable="true"/>
    <field name="apellido" type="string" column="APELLIDO" length="255" precision="0" scale="0" nullable="true"/>
    <field name="borrado" type="integer" column="BORRADO" precision="0" scale="0" nullable="true"/>
    <field name="consulta" type="string" column="CONSULTA" length="50" precision="0" scale="0" nullable="true"/>
    <field name="expiracionpassword" type="datetime" column="EXPIRACIONPASSWORD" precision="0" scale="0" nullable="true"/>
    <field name="fechaalta" type="datetime" column="FECHAALTA" precision="0" scale="0" nullable="true"/>
    <field name="fechaborrado" type="datetime" column="FECHABORRADO" precision="0" scale="0" nullable="true"/>
    <field name="fechadesactivado" type="datetime" column="FECHADESACTIVADO" precision="0" scale="0" nullable="true"/>
    <field name="iphabilitada" type="string" column="IPHABILITADA" length="250" precision="0" scale="0" nullable="true"/>
    <field name="jerarquia" type="string" column="JERARQUIA" length="255" precision="0" scale="0" nullable="true"/>
    <field name="nombre" type="string" column="NOMBRE" length="255" precision="0" scale="0" nullable="true"/>
    <field name="numerodoc" type="string" column="NUMERODOC" length="255" precision="0" scale="0" nullable="true"/>
    <field name="sessionid" type="string" column="SESSIONID" length="50" precision="0" scale="0" nullable="true"/>
    <field name="tipodoc" type="string" column="TIPODOC" length="255" precision="0" scale="0" nullable="true"/>
    <field name="ultimaip" type="string" column="ULTIMAIP" length="60" precision="0" scale="0" nullable="true"/>
    <field name="ultimologin" type="datetime" column="ULTIMOLOGIN" precision="0" scale="0" nullable="true"/>
    <field name="usuario" type="string" column="USUARIO" length="255" precision="0" scale="0" nullable="true"/>
    <field name="usuarioalta" type="integer" column="USUARIOALTA" precision="0" scale="0" nullable="true"/>
    <many-to-one field="depenid" target-entity="SEGURIDAD\SeguridadBundle\Entity\Dependencia">
      <join-columns>
        <join-column name="DEPENID" referenced-column-name="DEPENID" nullable="1"/>
      </join-columns>
    </many-to-one>
    <many-to-many field="perfilid" target-entity="SEGURIDAD\SeguridadBundle\Entity\Perfil" mapped-by="usuarioid"/>
    <many-to-many field="permisoid" target-entity="SEGURIDAD\SeguridadBundle\Entity\Permiso" mapped-by="usuarioid"/>
  </entity>
</doctrine-mapping>
