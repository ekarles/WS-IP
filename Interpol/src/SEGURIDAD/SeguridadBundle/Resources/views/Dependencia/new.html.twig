{% extends 'GESTIONGestionBundle::base.html.twig' %} 
{% block body -%}
	<div class="row text-center">
		<h1>Nueva Dependencia</h1>
	</div>
	{{ form_start(form) }}
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<div class="container">
					<button type="submit" class="btn btn-success pull-right" id="btnGuardarA">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_dependencia') }}">
		                Volver
		            </a>
	            </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">
                   		<div class="col-md-6">
		                    {{ form_label(form.codigo) }}
		                    {{ form_widget(form.codigo) }}
		                    {{ form_errors(form.codigo) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.nombre) }}
		                    {{ form_widget(form.nombre) }}
		                    {{ form_errors(form.nombre) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.contacto) }}
		                    {{ form_widget(form.contacto) }}
		                    {{ form_errors(form.contacto) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.direccion) }}
		                    {{ form_widget(form.direccion) }}
		                    {{ form_errors(form.direccion) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(form.latitud) }}
		                    {{ form_widget(form.latitud) }}
		                    {{ form_errors(form.latitud) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.longitud) }}
		                    {{ form_widget(form.longitud) }}
		                    {{ form_errors(form.longitud) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.maximousuarios) }}
		                    {{ form_widget(form.maximousuarios) }}
		                    {{ form_errors(form.maximousuarios) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(form.minaviso) }}
		                    {{ form_widget(form.minaviso) }}
		                    {{ form_errors(form.minaviso) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.orden) }}
		                    {{ form_widget(form.orden) }}
		                    {{ form_errors(form.orden) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.tipo) }}
		                    {{ form_widget(form.tipo) }}
		                    {{ form_errors(form.tipo) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(form.institucionid) }}
		                    {{ form_widget(form.institucionid) }}
		                    {{ form_errors(form.institucionid) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(form.borrado) }}
		                    {{ form_widget(form.borrado) }}
		                    {{ form_errors(form.borrado) }}
		                </div>
		            </div>
		            <div class="row">
		            	<div class="col-md-12">
		                    {{ form_label(form.observaciones) }}
		                    {{ form_widget(form.observaciones) }}
		                    {{ form_errors(form.observaciones) }}
		                </div>
		            </div> 
		            <div class="row">
		            	<div class="col-md-12">
		                    {{ form_label(form.mail) }}
		                    {{ form_widget(form.mail) }}
		                    {{ form_errors(form.mail) }}
		                </div>
		            </div>    
		            <br>        
				</div>
			</div>
			<div class="panel-footer">
	            <div class="container">
	                <button type="submit" class="btn btn-success pull-right" id="btnGuardarB">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_dependencia') }}">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
	</script>
	{{ form_end(form) }}
<script>
	$(document).ready(function () {
        
		$("#btnGuardarA").click(function(){
			return tratarLatitudLongitud();
		});

		$("#btnGuardarB").click(function(){
			return tratarLatitudLongitud();
		});

   
	});
	
	function tratarLatitudLongitud(){
	
		var sLatitud = $("#seguridad_seguridadbundle_dependencia_latitud").val();
		var sLongitud = $("#seguridad_seguridadbundle_dependencia_longitud").val();
		
		sLatitud  = sLatitud.replace(",", ".");
		sLongitud = sLongitud.replace(",", ".");
		$("#seguridad_seguridadbundle_dependencia_latitud").val(sLatitud);
		$("#seguridad_seguridadbundle_dependencia_longitud").val(sLongitud);
		
		if( isNaN( sLatitud  ) ){
			alert("Valor no válido en campo latitud.");
			$("#seguridad_seguridadbundle_dependencia_latitud").focus();
			return false
		}
		
		if( isNaN( sLongitud ) ){
			alert("Valor no válido en campo longitud.");
			$("#seguridad_seguridadbundle_dependencia_longitud").focus();
			return false
		}
		return true;
	}

</script>

{% endblock %}
