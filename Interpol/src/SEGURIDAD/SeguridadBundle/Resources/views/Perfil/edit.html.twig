{% extends 'GESTIONGestionBundle::base.html.twig' %} 
{% block body -%}
	<div class="row text-center">
		<h1>Editar perfil</h1>
	</div>
	{{ form_start(edit_form) }}
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<div class="container">
					<button type="submit" class="btn btn-success pull-right" id="btnGuardarA">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_perfil') }}">
		                Volver
		            </a>
	            </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.descripcion) }}
		                    {{ form_widget(edit_form.descripcion) }}
		                    {{ form_errors(edit_form.descripcion) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.nombre) }}
		                    {{ form_widget(edit_form.nombre) }}
		                    {{ form_errors(edit_form.nombre) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.borrado) }}
		                    {{ form_widget(edit_form.borrado) }}
		                    {{ form_errors(edit_form.borrado) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(edit_form.permisoid) }}
		                    {{ form_widget(edit_form.permisoid) }}
		                    {{ form_errors(edit_form.permisoid) }}
		                </div>
		                {% if is_granted('ROLE_SUPER_ADMIN') %}
		                <div class="col-md-6">
		                    {{ form_label(edit_form.admin) }}
		                    {{ form_widget(edit_form.admin) }}
		                    {{ form_errors(edit_form.admin) }}
		                </div>
		                {% endif %}
		                {% if is_granted('ROLE_SUPER_ADMIN') %}
		                <div class="col-md-6">
		                    {{ form_label(edit_form.admin_ext) }}
		                    {{ form_widget(edit_form.admin_ext) }}
		                    {{ form_errors(edit_form.admin_ext) }}
		                </div>
		                {% endif %}

		            </div>
		            <br>        
				</div>
			</div>
			<div class="panel-footer">
	            <div class="container">
	                <button type="submit" class="btn btn-success pull-right" id="btnGuardarB">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_perfil') }}">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
	</script>
	{{ form_end(edit_form) }}
<script>
	$(document).ready(function () {
        
		$("#btnGuardarA").click(function(){
			return tratarLatitudLongitud();
		});

		$("#btnGuardarB").click(function(){
			return tratarLatitudLongitud();
		});

   
	});
	
	function tratarLatitudLongitud(){
	
		var sLatitud = $("#seguridad_seguridadbundle_dependencia_latitud").val();
		var sLongitud = $("#seguridad_seguridadbundle_dependencia_longitud").val();
		
		sLatitud  = sLatitud.replace(",", ".");
		sLongitud = sLongitud.replace(",", ".");
		$("#seguridad_seguridadbundle_dependencia_latitud").val(sLatitud);
		$("#seguridad_seguridadbundle_dependencia_longitud").val(sLongitud);
		
		if( isNaN( sLatitud  ) ){
			alert("Valor no válido en campo latitud.");
			$("#seguridad_seguridadbundle_dependencia_latitud").focus();
			return false
		}
		
		if( isNaN( sLongitud ) ){
			alert("Valor no válido en campo longitud.");
			$("#seguridad_seguridadbundle_dependencia_longitud").focus();
			return false
		}
		return true;
	}

</script>
{% endblock %}
