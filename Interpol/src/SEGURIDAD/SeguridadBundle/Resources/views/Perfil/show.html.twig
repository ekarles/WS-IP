{% extends 'GESTIONGestionBundle::base.html.twig' %} 
{% block body -%}
	<div class="row text-center">
		<h1>Borrar Perfil</h1>
	</div>
	{{ form_start(delete_form) }}
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<b>¿Confirma que desea borrar el perfil?</b><i class="fa fa-question"></i>
					<div _ngcontent-ktt-12="" class="pull-right">
					<button type="submit" class="btn btn-danger pull-right" >Borrar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_perfil') }}">
		                Volver
		            </a>
                    </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">
			            <div class="col-md-6">
			                <div class="col-md-3 alert alert-secondary">Id</div>
			                <div class="col-md-6 alert alert-secondary">{{ entity.id}}</div>
			            </div>
			            <div class="col-md-6">
			                <div class="col-md-3 alert alert-secondary">Nombre</div>
			                <div class="col-md-6 alert alert-secondary">{{ entity.nombre }}</div>
			            </div>
			            <div class="col-md-6">
			                <div class="col-md-3 alert alert-secondary">Descripcion</div>
			                <div class="col-md-6 alert alert-secondary">{{ entity.descripcion }}</div>
			            </div>			            
			            <div class="col-md-6">
			                <div class="col-md-3 alert alert-secondary">Borrado</div>
			                <div class="col-md-6 alert alert-secondary">{{ entity.borrado == 1 ? 'Sí' : 'No' }}</div>
			            </div>				            			            
					</div>
				</div>
			</div>
			<div class="panel-footer">
	            <div class="container">
	                <button type="submit" class="btn btn-danger pull-right" >Borrar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_perfil') }}">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
	</script>
	{{ form_end(delete_form) }}

{% endblock %}
