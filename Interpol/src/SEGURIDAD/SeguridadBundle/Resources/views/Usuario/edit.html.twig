{% extends 'GESTIONGestionBundle::base.html.twig' %} 

{% block body -%}
	<div class="row text-center">
		<h1>Editar Usuario</h1>
	</div>
	{{ form_start(edit_form) }}
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<div class="container">
					<button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('usuario') }}">
		                Volver
		            </a>
	            </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.nombre) }}
		                    {{ form_widget(edit_form.nombre) }}
		                    {{ form_errors(edit_form.nombre) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(edit_form.apellido) }}
		                    {{ form_widget(edit_form.apellido) }}
		                    {{ form_errors(edit_form.apellido) }}
		                </div>
		            </div>
		            <div class="row">
		                <div class="col-md-6{{'usuario:' in errores ? ' form-group has-error' : ''}}">
		                    {{ form_label(edit_form.usuario) }}
		                    {{ form_widget(edit_form.usuario) }}
		                    {{ form_errors(edit_form.usuario) }}
		                </div>
		                <div class="col-md-6">
		                    <label for="seguridad_seguridadbundle_usuario_password">Password (dejar vac&iacute;o para no modificar)</label>
		                    {{ form_widget(edit_form.password) }}
		                    {{ form_errors(edit_form.password) }}
		                </div> 
		            </div>
		            <div class="row">
		                <div class="col-md-6">
		                    {{ form_label(edit_form.tipodoc) }}
		                    {{ form_widget(edit_form.tipodoc) }}
		                    {{ form_errors(edit_form.tipodoc) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(edit_form.numerodoc) }}
		                    {{ form_widget(edit_form.numerodoc) }}
		                    {{ form_errors(edit_form.numerodoc) }}
		                </div>
		            </div>
		            <div class="row">
		            	<div class="col-md-4">
		                     {{ form_label(edit_form.depenid) }}
		                    {{ form_widget(edit_form.depenid) }}
		                    {{ form_errors(edit_form.depenid) }}
		                </div>
		                <div class="col-md-4">
		                    {{ form_label(edit_form.jerarquia) }}
		                    {{ form_widget(edit_form.jerarquia) }}
		                    {{ form_errors(edit_form.jerarquia) }}
		                </div>
		                <div class="col-md-4">
		                    {{ form_label(edit_form.estado) }}
		                    {{ form_widget(edit_form.estado) }}
		                    {{ form_errors(edit_form.estado) }}
		                </div>
		            </div>
		            <div class="row">
		            	<div class="col-md-6">
		                     {{ form_label(edit_form.iphabilitada) }}
		                    {{ form_widget(edit_form.iphabilitada) }}
		                    {{ form_errors(edit_form.iphabilitada) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(edit_form.expiracionpassword)}}
		                    <input type="date" id="sixMonthsFromNow" value="{{sixMonthsFromNow|date('Y-m-d')}}" style="display:none;"/>
		                    {{ form_widget(edit_form.expiracionpassword)}}
		                    {{ form_errors(edit_form.expiracionpassword) }}
		                </div> 
		            </div>
		            <br>
		            <div class="row">
		            	<div class="col-md-4">
			                <label>&Uacute;ltima IP:</label>
			                <span>{{ entity.ultimaip|default('') }}</span>
			            </div>
			            <div class="col-md-4">
			                <label>&Uacute;ltimo Login:</label>
			                <span>{{ entity.ultimologin ? entity.ultimologin|date('d/m/Y H:i:s') : '' }}</span>
			            </div>
			            <div class="col-md-4">
			                <label>Cant. Consultas:</label>
			                <span>{{ entity.cantPersona+entity.cantDocumento+entity.cantVehiculo+entity.cantCombinada+entity.cantLote }}</span>
			            </div>
		            </div>
		            <div class="row">
		            	<div class="col-md-6">
		                    {{ form_label(edit_form.perfilid)}}
		                    {{ form_widget(edit_form.perfilid)}}
		                    {{ form_errors(edit_form.perfilid) }}
		                </div>
		                {% if is_granted('ROLE_SUPER_ADMIN') %} 
		            	<div class="col-md-6">
		                    {{ form_label(edit_form.roles)}}
		                    {{ form_widget(edit_form.roles)}}
		                    {{ form_errors(edit_form.roles) }}
		                </div>
		                {% endif %} 
		            </div>
					<div class="row">
		            	<div class="col-md-12">
		                    {{ form_label(edit_form.observacion)}}
		                    {{ form_widget(edit_form.observacion)}}
		                    {{ form_errors(edit_form.observacion) }}
		                </div>
		            </div>
		            <br>
		            <br>
		            <div style="text-align:center;">
		            	<span><strong>Datos obligatorios (*)</strong></span>
		            </div>         
				</div>
			</div>
			<div class="panel-footer">
	            <div class="container">
	                <button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('usuario') }}">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
		$('#seguridad_seguridadbundle_usuario_depenid').attr('required','true');
		{% if entity.borrado %}
			$('#seguridad_seguridadbundle_usuario_estado').val('B').refresh();
		{% elseif not entity.activo %}
			$('#seguridad_seguridadbundle_usuario_estado').val('I').refresh();
		{% endif %}
		
		$('#seguridad_seguridadbundle_usuario_password').blur(function(){
			if($('#seguridad_seguridadbundle_usuario_password').val()!=''){
				if( (new Date($('#sixMonthsFromNow').val()).getTime() > new Date($('#seguridad_seguridadbundle_usuario_expiracionpassword').val()).getTime()))
				{
					$('#seguridad_seguridadbundle_usuario_expiracionpassword').val($('#sixMonthsFromNow').val());
				}
			}	
		});
		
		
	</script>
	{{ form_end(edit_form) }}

{% endblock %}
