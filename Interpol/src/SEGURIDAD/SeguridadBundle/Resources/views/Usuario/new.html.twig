{% extends 'GESTIONGestionBundle::base.html.twig' %} 

{% block body -%}
	<div class="row text-center">
		<h1>Nuevo Usuario</h1>
	</div>
	{{ form_start(form) }}
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<div class="container">
					<button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('usuario') }}">
		                Volver
		            </a>
	            </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">
                   		<div class="col-md-6">
		                    {{ form_label(form.nombre) }}
		                    {{ form_widget(form.nombre) }}
		                    {{ form_errors(form.nombre) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(form.apellido) }}
		                    {{ form_widget(form.apellido) }}
		                    {{ form_errors(form.apellido) }}
		                </div>

						
		            </div>
		            <div class="row">
		            	<div id="dvUsuario" class="col-md-6{{'usuario:' in errores ? ' form-group has-error' : ''}}">
		                    {{ form_label(form.usuario) }}
		                    {{ form_widget(form.usuario) }}
		                    {{ form_errors(form.usuario) }}
		                </div>
		                <div class="col-md-6">
		                     {{ form_label(form.password) }}
		                    {{ form_widget(form.password) }}
		                    {{ form_errors(form.password) }}
		                </div> 
		            </div>
		            <div class="row">
		                <div class="col-md-6">
		                     {{ form_label(form.tipodoc) }}
		                    {{ form_widget(form.tipodoc) }}
		                    {{ form_errors(form.tipodoc) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(form.numerodoc) }}
		                    {{ form_widget(form.numerodoc) }}
		                    {{ form_errors(form.numerodoc) }}
		                </div>
		            </div>
		            <div class="row">
		            	<div class="col-md-4">
		                    {{ form_label(form.depenid) }}
		                    {{ form_widget(form.depenid) }}
		                    {{ form_errors(form.depenid) }}
		                </div>
		                <div class="col-md-4">
		                    {{ form_label(form.jerarquia) }}
		                    {{ form_widget(form.jerarquia) }}
		                    {{ form_errors(form.jerarquia) }}
		                </div>
		                <div class="col-md-4">
		                    {{ form_label(form.estado) }}
		                    {{ form_widget(form.estado) }}
		                    {{ form_errors(form.estado) }}
		                </div>
		            </div>
		            <div class="row">
		            	<div class="col-md-6">
		                     {{ form_label(form.iphabilitada) }}
		                    {{ form_widget(form.iphabilitada) }}
		                    {{ form_errors(form.iphabilitada) }}
		                </div>
		                <div class="col-md-6">
		                    {{ form_label(form.expiracionpassword)}}
		                    {{ form_widget(form.expiracionpassword)}}
		                    {{ form_errors(form.expiracionpassword) }}
		                </div> 
		            </div>
		            <div class="row">
		            	<div class="col-md-6">
		                    {{ form_label(form.perfilid)}}
		                    {{ form_widget(form.perfilid)}}
		                    {{ form_errors(form.perfilid) }}
		                </div>
		                {% if is_granted('ROLE_SUPER_ADMIN') %} 
		            	<div class="col-md-6">
		                    {{ form_label(form.roles)}}
		                    {{ form_widget(form.roles)}}
		                    {{ form_errors(form.roles) }}
		                </div>
		                {% endif %} 
		            </div>
					<div class="row">
		            	<div class="col-md-12">
		                    {{ form_label(form.observacion)}}
		                    {{ form_widget(form.observacion)}}
		                    {{ form_errors(form.observacion) }}
		                </div>
		            </div>
		            <br>
		            <br>
		            <div style="text-align:center;">
		            	<span><strong>Datos obligatorios (*)</strong></span>
		            </div>   
				</div>
			</div>
			<div class="panel-footer">
	            <div class="container">
	                <button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('usuario') }}">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
		$('#seguridad_seguridadbundle_usuario_depenid').attr('required','true');
	</script>
	{{ form_end(form) }}

{% endblock %}
