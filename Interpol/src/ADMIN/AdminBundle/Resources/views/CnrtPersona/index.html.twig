	function detalleCNRT(){
		
		sTabla = "";
		var pId = $("#idCNRT").val();
		 
       	var sData = "{'id':"+pId+"}";
       	var oData = JSON.stringify(sData);
           var sRet = "";
           var sPath = '{{ path ('cnrt_consultarPersonasCnrtId',{'id':'@id'}) }}';
           sPath = sPath.replace('@id', pId);
   		   $.ajax({
                url:        sPath,  
                type:       'GET',
                dataType:   'json',
                async:      false,
                data:       oData,
                success: function(data, status) {
			       	  oData = jQuery.parseJSON( data );
			       	  $("#cnrtData").val(data);
                      if( oData.ID == null ){
                   	   sRet = "Error, no se encontró el registro correspondiente al ID [" + ( pId == "" ? "null" : pId ) + "].";
                      }else{
                    	sTabla += "<div class=\"col-sm-12\">";
                    	sTabla += "<div class=\"list-group\">";
                        sTabla += "<div class=\"modal-header modal-header-info\">Información del pasajero</div>";
                      	sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Id Pasajero</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.ID_PASAJERO+"</a>";
			            sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Documento</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.NUMERO_DOCUMENTO+"</a>";
			            sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Apellido y Nombre</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.APELLIDO+" "+oData.NOMBRE+"</a>";
                     	sTabla += "</div>";
                        sTabla += "</div>";
                        
               			sTabla += "<div class=\"col-sm-12\">";
                        sTabla += "<div class=\"list-group\">";
                        sTabla += "<div class=\"modal-header modal-header-info\">Información del pasaje</div>";
                      	sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Origen</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.ORIGEN+"</a>";
                      	sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Provincia Origen</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.PCIA_ORIGEN+"</a>";
                      	sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Destino</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.DESTINO+"</a>";
                      	sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Provincia Destino</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.PCIA_DESTINO+"</a>";
			            sTabla += "<a class=\"col-sm-4 list-group-item list-group-item-info\">Fecha Salida</a>";
			            sTabla += "<a class=\"col-sm-8 list-group-item\" >"+oData.FECHA_INICIO+"</a>";
