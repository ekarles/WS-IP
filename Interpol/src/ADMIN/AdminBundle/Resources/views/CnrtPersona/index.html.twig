    				<div class="panel-body">
                    	<div class="row">
	                    	<div class="col-sm-4">
	                    		<label>Id Pasajero</label>
	                    		<input type="text" name="txtIdPasajero" id="txtIdPasajero" value="{{ app.request.get( 'txtIdPasajero' ) }}" class="form-control">
	                    	</div>
	                    	<div class="col-sm-4">
	                    		<label>Nro. Documento</label>
	                    		<input type="text" name="txtNroDocumento" id="txtNroDocumento" value="{{ app.request.get( 'txtNroDocumento' ) }}" class="form-control">
	                    	</div>
	                        <div class="col-sm-4">
	                    		<label>Apellido</label>
	                    		<input type="text" name="txtApellido" id="txtApellido" value="{{ app.request.get( 'txtApellido' ) }}" class="form-control">
	                    	</div>
	                    	<div class="col-sm-4">
	                    		<label>Nombre</label>
	                    		<input type="text" id="txtNombre" name="txtNombre" value="{{ app.request.get('txtNombre') }}" class="form-control">
	                    	</div>
	                    	<div class="col-sm-4">
	                    		<label>Fecha desde</label>
	                    		<input type="date" id="dtfechaDesde" name="dtfechaDesde" value="{{ app.request.get('dtfechaDesde') }}" class="form-control">
	                    	</div>
	                    	<div class="col-sm-4">
	                    		<label>Fecha hasta</label>
	                    		<input type="date" id="dtfechaHasta" name="dtfechaHasta" value="{{ app.request.get( 'dtfechaHasta') }}" class="form-control">
	                    	</div>
	                    {% if not oper %}
	                    	<div class="col-sm-4">
	                    		<label>Estado</label>
           	                	<select id="lstEstados" name="lstEstados" required="required" class="selectpicker" value="{{ app.request.get( 'lstEstados' ) }}">
                            	{% for result in Estados %}
									<option value="{{ result['CODIGO'] }}" {{ ( app.request.get( 'lstEstados' )==result['CODIGO']?'selected':'') }}>{{ result['DESCRIPCION'] }}</option>           	                
                                {% endfor %}           	                
           	                  		<option value="" {{ ( app.request.get( 'lstEstados' )==''?'selected':'') }}>Seleccione una opción</option>
           	                	</select>
	                    	</div>&nbsp;
	                    	<div class="col-sm-4">
	                    		<label>Resultado</label>
	           	                <select id="lstResultado" name="lstResultado" required="required" class="selectpicker" value="{{ app.request.get( 'lstResultado' ) }}">
										<option value="0" {{ ( app.request.get( 'lstResultado' )=="0"?'selected':'') }} >0 - SIN NOVEDAD</option>
										<option value="1" {{ ( app.request.get( 'lstResultado' )=="1"?'selected':'') }}>1 - POSITIVO</option>           	                
	           	                  		<option value="" {{ ( app.request.get( 'lstResultado' )==''?'selected':'') }}>Seleccione una opción</option>
	           	                </select>
	                    	</div>
