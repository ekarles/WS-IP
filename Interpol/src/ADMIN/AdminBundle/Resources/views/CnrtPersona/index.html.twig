                                        	<td style="text-align:center;" width="15%">
                                        		{% if  result.RESULTADO == "1" %}
	                                            	<a id="btnDetalle{{j|default('')}}" class="btn btn-danger res" title="Detalle (id:{{ result.ID|default('NO ID') }})" data-toggle="modal" onClick="mostrarDetalle( '{{ result.ID|default("") }}', false )">
	                                                <i class="fa fa-eye"></i></a>
	                                                <a id="btnExportarPdf{{j|default('')}}" class="btn btn-secondary res" title="Exportar a PDF (id:{{ result.ID|default('NO ID') }})" onClick="exportarPdf( '{{ result.ID|default("") }}', '{{ result.IdPasajero|default("") }}', false )">
	                                                <i id="iconExportarPdf{{ result.ID|default('NO ID') }}" class="fa fa-print"></i></a>
                                                {% else %}
	                                            	<a id="btnDetalle{{j|default('')}}" class="btn btn-info res" title="Detalle (id:{{ result.ID|default('NO ID') }})" data-toggle="modal" onClick="mostrarDetalle( '{{ result.ID|default("") }}', false )">
	                                                <i class="fa fa-eye"></i></a>
                                                {% endif %}
                                                {% if  result.ESTADO != "1" and result.RESULTADO != "1" %}
                                            		<a id="btnReprocesar{{ result.ID|default('NO ID') }}" class="btn btn-primary res" title="Reprocesar persona CNRT (id:{{ result.ID|default('NO ID') }})" data-toggle="modal" onClick="mostrarDetalle( '{{ result.ID|default("") }}', true )">
	                                                <i class="fa fa-cog"></i></a>
	                                            {% endif %}
	                                            {% if is_granted('ROLE_ADMIN') and not oper %}
	                                            	<a id="btnAuditoria{{j|default('')}}" href= "{{path('cnrt_auditoria',{'id':result.ID})}}" class="btn btn-warning res" title="Auditor&iacute;a (id:{{ result.ID|default('NO ID') }})" data-toggle="modal">
	                                                <i class="fa fa-database"></i></a>
	                                            {% endif %}
                                        	</td>
                                        	<td style="text-align:center;">{{ result.IdPasajero|default('ERROR') }} <input type="hidden" id="txtIDCNRT" value="{{ result.ID|default('ERROR') }}" /> </td>
                                            <td style="text-align:center;">{{ result.numeroDocumento|default('') }}</td>
                                            <td style="text-align:center;">{{ result.apellido|default('') ~ " " ~ result.nombre|default('')  }}</td>
                                            <td style="text-align:center;">{{ result.SEXO|default('') }}</td>
                                            <td style="text-align:center;">{{ result.fechaConsulta|date('d/m/Y H:i:s')|default('') }}</td>
                                            {% if not oper %}
                                            <td style="text-align:center;">{{ result.ESTADO|default('') ~ " - " ~ "" }}{{ Estados[result.ESTADO]["DESCRIPCION"] }}</td>
                                            {% endif %}
                                        </tr>
                                        {% set j = j + 1 %}
                                    {% endfor %}
                                </tbody>
                            </table>
	                        <div class="row-fluid" align="center">        
			                    {{ pagerfanta (results,'twitter_bootstrap_translated', { 'prev_message' : 'Anterior', 'next_message': 'Siguiente',"routeParams": {'txtNroDocumento': app.request.get( "txtNroDocumento"),'dtfechaDesde': app.request.get( "dtfechaDesde"),'dtfechaHasta': app.request.get( "dtfechaHasta"),'txtApellido': app.request.get( "txtApellido"),'txtNombre': app.request.get( "txtNombre") }} ) }}
			                </div>                        
						</div>
                	</div>
                </div>
            </div>
        	<input type="hidden" id="cnrtData"\>
        	<input type="hidden" id="personaData"\>
        	<input type="hidden" id="errorCnrt" value="false"\>
