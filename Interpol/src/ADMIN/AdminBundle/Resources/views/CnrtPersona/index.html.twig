{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
{% set oper = false %}
{% for perfil in app.user.perfilid %}
	{% for permiso in perfil.permisoid %}
		{% if permiso.id == 127 %}
			{% set oper = true %}
		{% endif %}
	{% endfor %}
{% endfor %}
<form method="GET" action="{{path('admin_cnrtpersona')}}" enctype="multipart/form-data" id="frm">
    	<div class="container" width="100%">
    		<div class="row text-center">
				<div class="panel-heading">
					{% if oper %}
					<h1>Interpol - Positivos CNRT</h1>
					{% else %}
		    		<h1>Interpol - Administraci&oacute;n CNRT</h1>
		    		{% endif %}
		    	</div>
        	</div>        	
    		<div id="panelconsulta" class="col-xs-12 col-md-12" style="margin-bottom:2%;" height="150px;">
