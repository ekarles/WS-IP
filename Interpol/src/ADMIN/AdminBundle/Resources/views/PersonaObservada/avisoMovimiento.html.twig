{% block body -%}
	<div width="100%">
   		<div width="80%">
			<span style="color:#e30022">
	    		<h3>Se ha realizado una consulta NOMINALS en el sistema I24/7 con los siguientes datos coincidentes con un registro activo del módulo <strong>Avisos de Movimientos</strong>:</h3>
	    	</span>
	    	<br><br>
	    	<span>
	    		<h3>Apellido: </h3>{{consulta.personaObservada.apellido}}<br>
	    		<h3>Nombre: </h3>{{consulta.personaObservada.nombre}}<br>
	    		<h3>Fec. Nac.: </h3>{{consulta.personaObservada.fechaNac}}<br>
	    	</span>
	    	<br><br><br>
   		</div>
		<div>
			<span>
	    		<h3>Informaci&oacute;n de la consulta realizada:</h3>
	    	</span>
            <table width="100%">
                <tbody>
                   	<tr>
                   		<td bgcolor="#e6e6e6">Id:&nbsp;</td>
                		<td style='text-align:center'>{{ consulta.iaId.iaId }}</td>
                   	</tr>
                   	<tr>
                   		<td bgcolor="#e6e6e6">Fecha Consulta:&nbsp;</td>
                        <td style='text-align:center'>{{ consulta.iaId.iaTimestamp|date('d/m/Y H:i:s')|default('NO DATA') }}</td>
                    </tr>
                    <tr>
                    	<td bgcolor="#e6e6e6">Usuario:&nbsp;</td>    
                        <td style='text-align:center'>{{ consulta.iaId.iaUsuario|default('NO DATA') }}</td>
                    </tr>
                    <tr>
                    	<td bgcolor="#e6e6e6">Dependencia:&nbsp;</td>    
                        <td style='text-align:center'>{{ consulta.iaId.iaUsuarioDependencia|default('NO DATA') }}</td>
                    </tr>
                    <tr>    
                        {% if consulta.iaId.iaResultCode == 'NO_ERROR' %}
							{% set resultCode = 'POSITIVO(NO_ERROR)' %}
						{% elseif consulta.iaId.iaResultCode == 'NO_ANSWER' %}
							{% set resultCode = 'NEGATIVO(NO_ANSWER)' %}
						{% else %}
							{% set resultCode = consulta.iaId.iaResultCode %}
						{% endif %}
						<td bgcolor="#e6e6e6">Resultado:&nbsp;</td>
                        <td style='text-align:center'>{{ resultCode }}</td>
                   	</tr>
             	</tbody>
        	</table>	
   		</div>
   		<br><br>
   		<span>
	    	<h3>Para ver más informaci&oacute;n ingrese al módulo de gestión de Avisos de Movimientos.</h3>
	   	</span>
    </div>
    
    <style>
    table, th, td {
	  border: 1px solid black;
	}
    </style>
{% endblock %}
