{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<form id="frm" method="POST" action="{{ path('gestion_personaobservada_consultas',{'id':personaObservada.id}) }}">
	<div class="container" width="100%">
		<div class="row text-center">
			<h1>Interpol - Consultas Realizadas a <strong>{{personaObservada}}</strong></h1>
		</div>
		<div id="panelconsulta" class="col-xs-12 col-md-12"
			style="margin-bottom: 2%;">
			<div class="panel panel-primary">
				<div class="panel-heading">
					<b>BUSCADOR</b> <i class="fa fa-search"></i>
					<div _ngcontent-ktt-12="" class="pull-right">
                        <a onclick='window.location="{{path('gestion_personaobservada')}}"' role="button" id="btnVolver" name="btnVolver" _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
                        <a class="btn btn-default res mb-2" href="javascript:exportar()" id="exportarCsv" style="margin-right:10px;" title="Exportar CSV">
	                       	<i class="fas fa-file-excel" style="color:green;"> Exportar CSV</i>
	                   	</a>
                    </div>	
				</div>
				<div class="panel-body">
				    <input type="hidden" id="accion" name="accion" value="{{app.request.get( "accion")}}" class="form-control">
					<input type="hidden" id="busqueda" name="busqueda" value="{{app.request.get( 'busqueda')}}" class="form-control">
					<div class="row" style="margin-bottom:5px;">
						<div class="col-sm-4 mb-2">
							<label>Fecha desde</label> <input type="date" id="txtFechaDesde"
								name="txtFechaDesde" value="{{app.request.get( "txtFechaDesde")}}" 
								class="form-control">
						</div>
						<div class="col-sm-4 mb-2">
							<label>Fecha hasta</label> <input type="date" id="txtFechaHasta"
								name="txtFechaHasta" value="{{app.request.get( "txtFechaHasta")}}" 
								class="form-control">
						</div>
						<div class="col-sm-4 mb-3">
							<label>Usuario</label> <input type="text" id="txtUsuario"
								name="txtUsuario" value="{{app.request.get( 'txtUsuario')}}"
								class="form-control">
						</div>
					</div>
					<div class="row" style="margin-bottom:5px;">
						<div class="col-sm-4 mb-3">
							<label>Dependencia</label> <input type="text" id="txtDependencia"
								name="txtDependencia" value="{{app.request.get( 'txtDependencia')}}"
								class="form-control">
						</div>
						<div class="col-sm-4 mb-3">
							<label>Resultado</label>
							<select id="lstResultado"
								name="lstResultado" class="selectpicker">
								<option value="" selected>Seleccione el resultado</option>
								<option value="NO_ERROR">POSITIVO</option>
								<option value="NO_ANSWER">NEGATIVO</option>
								<option value="OTROS">OTROS</option>
							</select>
						</div>
						<div class="col-sm-4 mb-3">
							<label>Estado</label>
							<select id="lstEstado"
								name="lstEstado" class="selectpicker">
								<option value="" selected>Seleccione el estado</option>
								<option value="P">PENDIENTE</option>
								<option value="T">TRABAJANDO</option>
								<option value="C">CERRADO</option>
							</select>
						</div>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-info col-xs-12" data-toggle="tooltip"
							id="consultar" title="" type="button" data-placement="bottom"
							data-original-title="Consultar">
							<div class="hidden-xs hidden-sm">Consultar</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-search" aria-hidden="true"></i>
							</div>
						</button>
						<button id="sendForm" type="submit" class="hide"></button>
					</div>
					<div class="row col-sm-4 col-md-4">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-default col-xs-12" data-toggle="tooltip"
							title="" id="limpiar" type="button" onclik="limpiarForm"
							data-placement="bottom"
							data-original-title="Limpiar Parámetros de Búsqueda">
							<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-undo" aria-hidden="true"></i>
							</div>
						</button>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-1. col-md-12">
						<table id="tablaConsultasPersonaObservada" class="table-bordered table-striped mb-0">
                            <thead>
                                <tr style='text-align:center' bgcolor="#e9e9e9">
                                	<th style='text-align:center'>Id</th>
					                <th style='text-align:center'>Fecha Consulta</th>
					                <th style='text-align:center'>Usuario</th>
					                <th style='text-align:center'>Dependencia</th>
					                <th style='text-align:center'>Resultado</th>
					                <th style='text-align:center'>Estado</th>
					                <th style='text-align:center'>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for entity in entities %}
                                    <tr>
                                    	<td style='text-align:center'>{{ entity.iaId.iaId }}</td>
                                        <td style='text-align:center'>{{ entity.iaId.iaTimestamp|date('d/m/Y H:i:s')|default('NO DATA') }}</td>
                                        <td style='text-align:center'>{{ entity.iaId.iaUsuario|default('NO DATA') }}</td>
                                        <td style='text-align:center'>{{ entity.iaId.iaUsuarioDependencia|default('NO DATA') }}</td>
                                        {% if entity.iaId.iaResultCode == 'NO_ERROR' %}
									        {% set resultCode = 'POSITIVO(NO_ERROR)' %}
									    {% elseif entity.iaId.iaResultCode == 'NO_ANSWER' %}
									        {% set resultCode = 'NEGATIVO(NO_ANSWER)' %}
									    {% else %}
									        {% set resultCode = entity.iaId.iaResultCode %}
										{% endif %}
                                        <td style='text-align:center'>{{ resultCode }}</td>
						                <td style='text-align:center'>{{ entity.estado|default('NO DATA') }}</td>
						                <td style='text-align:center'>
						                	{% if entity.estado == 'PENDIENTE' %}
                                       		<a class="btn btn-success res" title="Iniciar Trabajo" href="{{path('gestion_consultapersonaobservada_estado',{'id':entity.id,'estado':'T'})}}">
                                            	<i class="fas fa-tasks"> Trabajar</i>
                                        	</a>
                                        	{% endif %}
                                        	{% if entity.estado == 'TRABAJANDO' %}
                                        	<a class="btn btn-warning res" title="Volver a Estado Pendiente" href="{{path('gestion_consultapersonaobservada_estado',{'id':entity.id,'estado':'P'})}}">
                                            	<i class="fas fa-clock"> Volver a Pendiente</i>
                                        	</a>
                                        	<a class="btn btn-info res" title="Cambiar a Estado Cerrado" href="{{path('gestion_consultapersonaobservada_estado',{'id':entity.id,'estado':'C'})}}">
                                            	<i class="fas fa-check"> Cerrar</i>
                                        	</a>
                                        	{% endif %}
                                        	{% if entity.estado == 'CERRADO' %}
                                        	<a class="btn btn-warning res" title="Volver a Estado Pendiente" href="{{path('gestion_consultapersonaobservada_estado',{'id':entity.id,'estado':'P'})}}">
                                            	<i class="fas fa-clock"> Volver a Pendiente</i>
                                        	</a>
                                        	{% endif%}
                                        	<a class="btn btn-primary res" title="Ver Log de Interpol" href="{{path('gestion_consultapersonaobservada_interpollog',{'id':entity.id})}}">
                                            	<i class="fas fa-eye"> Log de Interpol</i>
                                        	</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <div class="row-fluid" align="center">        
		                    {{ pagerfanta (entities,'twitter_bootstrap_translated', { 'prev_message' : 'Anterior', 'next_message': 'Siguiente',
		                    				"routeParams": {'id':personaObservada.id,
		                    								'txtFechaDesde':app.request.get('txtFechaDesde'),
		                    								'txtFechaHasta':app.request.get('txtFechaHasta'),
		                    								'txtUsuario':app.request.get('txtUsuario'),
		                    								'txtDependencia':app.request.get('txtDependencia'),
		                    								'lstResultado':app.request.get('lstResultado'),
		                    								'lstEstado':app.request.get('lstEstado')
															}
						           		}) 
		                    }}
		                </div>                        
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

<script>
	$(document).ready(function () {
        
		if ($(window).width() < 600) {
			$("#panelconsulta").attr("style","margin-bottom:2%;");
		}else{
			$("#panelconsulta").attr("style","margin-left:0%;margin-bottom:2%;");
		}
		
		$("#lstResultado").val("{{app.request.get( "lstResultado")}}").selectpicker('refresh');
		$("#lstEstado").val("{{app.request.get( "lstEstado")}}").selectpicker('refresh');
		
		
		$("#consultar").click(function(){
			$("#accion").val("busqueda");
			$("#frm").attr('action',"{{ path('gestion_personaobservada_consultas',{'id':personaObservada.id}) }}");
			$("#sendForm").click();
		});

		{% if app.request.get( "busqueda")=='SI' or app.request.get( "page")!='' %}
			$(window).scrollTop($('#panelconsulta').offset().top);
		{% endif %}
		
		$('#limpiar').click(function () {
		    
		    $("#txtUsuario").val("");
		    $("#txtFechaDesde").val("");
		    $("#txtFechaHasta").val("");
		    $("#txtDependencia").val("");
		    $("#lstResultado").val("").selectpicker('refresh');
		    $("#lstEstado").val("").selectpicker('refresh');
		    
		});
		
	    $('.pagination a').attr('class', 'btn btn-default');
        $('.pagination li').css('float', 'left');
        $('.pagination .active span').attr('class', 'btn btn-info');
        $('.pagination .prev span').attr('class', 'btn btn-default disabled');
        $('.pagination .next span').attr('class', 'btn btn-default disabled');
		
        $('#tablaConsultasPersonaObservada').DataTable({
        	"scrollY": "600px",
        	"scrollX": true,
            "filter": true,
            "paging": false,
            "info": false,
            "order": [[ 0, 'desc' ]],
            "scrollCollapse": true,
            "responsive": true,
            "columnDefs": [ {
            	"targets": 2,
            	"orderable": false
            	} ],	
            "oLanguage": {
				"sSearch": 		   "Buscar en registros visibles:",
				"sEmptyTable": 	   '<div class="alert alert-seccondary"><i class="fa fa-info-circle" style="font-size: 20px"></i> <span style="font-size: 20px;"> No hay consultas con los parámetros de búsqueda ingresados.</span></div>',			
				"sProcessing":     "Procesando...",
				"sLengthMenu":     "Mostrar _MENU_ registros",
				"sZeroRecords":    "No se encontraron resultados",
				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
				"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
				"sInfoPostFix":    "",
				"sUrl":            "",
				"sInfoThousands":  ",",
				"sLoadingRecords": "Cargando...",
				"columnDefs": [ {
	            	"targets": 2,
	            	"orderable": false
	            	} ],
				"oPaginate": {
                    "sFirst":    "Pri",
                    "sLast":     "Ult",
                    "sNext":     "Sig",
                    "sPrevious": "Ant"
                	}
			}
        });
	});

	function exportar(){	
		$("#accion").val("csv");
		$("#frm").attr('target',"_blank");
		$("#sendForm").click();
		$("#accion").val("");
		$("#frm").removeAttr('target');
	}
</script>
    {% endblock %}
