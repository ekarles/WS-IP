{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<form method="GET" action="{{path('auditoriawisdm')}}">
    	<div class="container" width="100%">
    		<div class="row text-center">
				<div class="panel-heading">
		    		<h1>Interpol - Auditor&iacute;a WISDM</h1>
		    	</div>
        	</div>
    		<div id="panelconsulta" class="col-xs-12 col-md-12" style="margin-bottom:2%;" height="150px;">
    			<div class="panel panel-default">
    				<div class="panel-body">
                    	<div class="row">
	                    	<div class="col-sm-4">
	                    		<label>Nro. Documento</label>
	                    		<input type="text" name="numerodoc" id="numerodoc" value="{{ app.request.get( "numerodoc" ) }}" class="form-control">
	                    	</div>
	                        <div class="col-sm-4">
	                    		<label>Usuario</label>
	                    		<input type="text" name="user" id="user" value="{{ app.request.get( "user" ) }}" class="form-control">
	                    	</div>
	                    	<div class="col-sm-4">
	                    		<label>Resp. Servicio</label>
	                    		<input type="text" name="respservicio" id="respservicio" value="{{ app.request.get( "respservicio" ) }}" class="form-control">
	                    	</div>
	                    </div>	
                    	<div class="row">
	                    	<div class="col-sm-4">
	                    		<label>Fecha desde</label>
	                    		<input type="date" id="fechaDesde" name="fechaDesde" value="{{ app.request.get('fechaDesde') }}" class="form-control">
	                    	</div>
	                    	<div class="col-sm-4">
	                    		<label>Fecha hasta</label>
	                    		<input type="date" id="fechaHasta" name="fechaHasta" value="{{ app.request.get( "fechaHasta") }}" class="form-control">
	                    	</div>
	                    	<div class="col-sm-4">
	                    		<label>Fecha robo</label>
	                    		<input type="date" id="fechaRobo" name="fechaRobo" value="{{ app.request.get( "fechaRobo") }}" class="form-control">
	                    	</div>
	                    </div>	
                    	<div class="row col-sm-12 col-md-12">
    						<div>&nbsp;</div>
    						<div>&nbsp;</div>
    					</div>
        				<div class="col-sm-4 col-md-4">
        					<button class="btn btn-success col-xs-12" data-toggle="tooltip" id="consultar" title="" type="submit" data-placement="bottom" data-original-title="Consultar">
        						<div class="hidden-xs hidden-sm">Consultar</div>
        						<div class="hidden-md hidden-lg">
        							<i class="fa fa-search" aria-hidden="true"></i>
        						</div>
        					</button>
        					<button id="sendForm" type="submit" class="hide"></button>
        				</div>
                    	<div class="row col-sm-4 col-md-4">
    						<div>&nbsp;</div>
    						<div>&nbsp;</div>
    					</div>
    					<div class="col-sm-4 col-md-4">
        					<button class="btn btn-default col-xs-12" data-toggle="tooltip" title="" id="limpiar" type="button" onclik="limpiarForm" data-placement="bottom" data-original-title="Limpiar Parámetros de Búsqueda">
        						<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
        						<div class="hidden-md hidden-lg">
        							<i class="fa fa-undo" aria-hidden="true"></i>
        						</div>
        					</button>
        				</div>
        			    <div class="row">
    						<div>&nbsp;</div>
    						<div>&nbsp;</div>
    					</div>
    					<br>
						<div class="row text-center">
							<h4><strong>Total: {{cant}} registros</strong></h4>
						</div>
        				<div class="col-sm-12 col-md-12 table-wrapper-scroll-y my-custom-scrollbar" >
        				
                            <table id="tablaAuditoriaWisdm" class="table-bordered table-striped mb-0">
                                <thead>
                                    <tr style='text-align:center' bgcolor="#e9e9e9">
                                    	<th>{{ 'Acción' }}</th>
                                    	<th>Fecha Proc.</th>
                                    	<th>Nro. Doc.</th>
                                        <th>Resp. Serv.</th>
                                        <th>Fecha Robo</th>
                                        <th>M&eacute;todo</th>
                                        <th>Usuario</th>
                                        <th>Item ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                	{% set j = 0 %}
                                    {% for result in results %}
                                        <tr>
                                            <td style="text-align:center;">
                                            	<a id="btnRes{{j|default('')}}" indice="{{ j }}" class="btn btn-info res" title="Ver m&aacute;s (id:{{ result.ID }})" data-toggle="modal" onClick="mostrarDetalle( '{{ result.ID }}' );">
                                                <i class="fa fa-eye"></i></a>
                                                <input type="hidden" value="<table class='table table-striped table-bordered' style='text-align=left;'>
	                                               								<tr><td><strong>Id: </strong></td><td> {{ result.ID }}</td></tr>
	                                                							<tr><td><strong>Fecha Proc.: </strong></td><td>{{ result.FECHAPROCESO }}</td></tr>
										                                    	<tr><td><strong>Nro. Doc.: </strong></td><td>{{ result.NUMERODOC }}</td></tr>
										                                        <tr><td><strong>Tipo Doc.: </strong></td><td>{{ result.TIPODOC }}</td></tr>
										                                        <tr><td><strong>Resp. Serv.: </strong></td><td>{{ result.RESPSERVICIO }}</td></tr>
										                                        <tr><td><strong>Pa&iacute;s Reg.: </strong></td><td>{{ result.PAISREG }}</td></tr>
										                                        <tr><td><strong>Tipo de Fraude: </strong></td><td>{{ result.TIPOFRAUDE }}</td></tr>
										                                        <tr><td><strong>Nro. Ref.: </strong></td><td>{{ result.NUMREF }}</td></tr>
										                                        <tr><td><strong>Nro. Ref. OCN: </strong></td><td>{{ result.NUMREFOCN }}</td></tr>
										                                        <tr><td><strong>Fecha Robo: </strong></td><td>{{ result.FECHAROBO }}</td></tr>
										                                        <tr><td><strong>Pa&iacute;s Robo: </strong></td><td>{{ result.PAISROBO }}</td></tr>
										                                        <tr><td><strong>Fecha Emi.: </strong></td><td>{{ result.FECHAEMI }}</td></tr>
										                                        <tr><td><strong>Fecha Exp.: </strong></td><td>{{ result.FECHAEXP }}</td></tr>
										                                        <tr><td><strong>Infoad: </strong></td><td>{{ result.INFOAD }}</td></tr>
										                                        <tr><td><strong>Id WISDM: </strong></td><td>{{ result.IDWISDM }}</td></tr>
										                                        <tr><td><strong>M&eacute;todo: </strong></td><td>{{ result.METODO }}</td></tr>
										                                        <tr><td><strong>Usuario: </strong></td><td>{{ result.USUARIO }}</td></tr>
										                                        <tr><td><strong>Usuario IP: </strong></td><td>{{ result.USUARIOIP }}</td></tr>
										                                        <tr><td><strong>Usuario Nombre: </strong></td><td>{{ result.APELLIDO_USUARIO ~ ' ' ~ result.NOMBRE_USUARIO }}</td></tr>
										                                        <tr><td><strong>Usuario Jerarqu&iacute;a: </strong></td><td>{{ result.JERARQUIA_USUARIO }}</td></tr>
										                                        <tr><td><strong>Usuario Depen.: </strong></td><td>{{ result.DEPCIA_USUARIO }}</td></tr>
										                                        <tr><td><strong>Item ID: </strong></td><td>{{ result.ITEMID }}</td></tr>
									                                      	</table>" id="data{{ result.ID }}"/>
                                            </td>
                                            <td>{{ result.FECHAPROCESO }}</td>
                                            <td style='text-align:left'>{{ result.NUMERODOC }}</td>
                                            <td style='text-align:center'>{{ result.RESPSERVICIO }}</td>
                                            <td>{{ result.FECHAROBO }}</td>
                                            <td>{{ result.METODO }}</td>
                                            <td>{{ result.USUARIO }}</td>
                                            <td>{{ result.ITEMID }}</td>
                                        </tr>
                                        {% set j = j+1 %}
                                    {% endfor %}
                        
                                </tbody>
                            </table>
							
							{{ include('paginadorCurl.html.twig') }}
							    		            
						</div>
                	</div>
                </div>
            </div>
            
            <div class="modal" id="popupView" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    			<div class="modal-dialog" role="document">
    				<div class="modal-content">
    					<div class="modal-header modal-header-info">
    						<h5 class="modal-title text-center" id="exampleModalLabel"><strong>Datos de auditor&iacute;a WISDM</strong></h5>
    					</div>
    					<div class="modal-body text-left" id="dvDatos">
                			<div class="panel panel-default">
                				<div class="panel-body">
                					<div id="dvTable" class="col-sm-12">
                					</div>
                                </div>
                            </div>
    					</div>
    					<div class="modal-footer">
    						<button type="button" class="btn btn-danger  res" data-dismiss="modal">Cerrar</button>
    					</div>
    				</div>
    			</div>
    		</div>
    	</div>
		
</form>
    <script>
        $(document).ready(function () {
    		if ($(window).width() < 600) {
    			$("#panelconsulta").attr("style","margin-bottom:2%;");
    	    }else{
    	    	$("#panelconsulta").attr("style","margin-left:0%;margin-bottom:2%;");
    	    }	//	if ($(window).width() < 600) {

    	    $('.pagination a').attr('class', 'btn btn-default');
            $('.pagination li').css('float', 'left');
            $('.pagination .active span').attr('class', 'btn btn-info');
            $('.pagination .prev span').attr('class', 'btn btn-default disabled');
            $('.pagination .next span').attr('class', 'btn btn-default disabled');


    	    
            $('#limpiar').click(function () {
                $("#numerodoc"  ).val("");
                $("#user").val("");
                $("#respservicio").val("");
                $("#fechaDesde"  ).val("");
                $("#fechaHasta"  ).val("");
                $("#fechaRobo").val("");
                
                
            });	


            $('#tablaAuditoriaWisdm').DataTable({
            	"scrollY": "600px",
            	"scrollX": true,
                "filter": false,
                "paging": false,
                "info": false,
                "order": [[1, "desc"]],
                "scrollCollapse": true,
                "responsive": true,
                "oLanguage": {
    				"sSearch": 		   "Buscar:",
    				"sEmptyTable": 	   "No se encontraron registros.",			
    				"sProcessing":     "Procesando...",
    				"sLengthMenu":     "Mostrar _MENU_ registros",
    				"sZeroRecords":    "No se encontraron resultados",
    				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
    				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
    				"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
    				"sInfoPostFix":    "",
    				"sSearch":         "Buscar:",
    				"sUrl":            "",
    				"sInfoThousands":  ",",
    				"sLoadingRecords": "Cargando..."
    			}
            });
        });
        
        function mostrarDetalle( pId){
        	$("#dvTable").html($('#data'+ pId).val());
        	$("#popupView").modal('show');
        }
        
    </script>
    {% endblock %}
