{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<form method="POST" action="{{ path('lotedocumento_show') }}">
    	<div class="container" width="100%">
    		<div class="row text-center">
				<div class="panel-heading">
		    		<h1>Interpol - Lotes WISDM</h1>
		    	</div>
        	</div>
    		<div id="panelconsulta" class="col-xs-12 col-md-12" style="margin-bottom:2%;" height="150px;">
    			<div class="panel panel-default">
    				<div class="panel-body">
                    	<div class="col-sm-4">
                    		<label>Apellido</label>
                    		<input type="text" name="txtApellido" id="txtApellido" value="{{ app.request.get( "txtApellido" ) }}" class="form-control">
                    	</div>
                        <div class="col-sm-4">
                    		<label>Nombre</label>
                    		<input type="text" name="txtNombre" id="txtNombre" value="{{ app.request.get( "txtNombre" ) }}" class="form-control">
                    	</div>
                    	<div class="col-sm-4">
                    		<label>Tipo Documento</label>
                    		<input type="text" name="txtTipDoc" id="txtTipDoc" value="{{ app.request.get( "txtTipDoc" ) }}" class="form-control">
                    	</div>
                    	<div class="col-sm-3">
                    		<label>Nro. documento</label>
                    		<input type="text" name="txtNroDoc" id="txtNroDoc" value="{{ app.request.get( "txtNroDoc" ) }}" class="form-control">
                    	</div>
                    	<div class="col-sm-3">
                    		<label>Fecha desde</label>
                    		<input type="date" id="txtFechaDesde" name="txtFechaDesde" value="{{ app.request.get('txtFechaDesde') }}" class="form-control">
                    	</div>
                    	<div class="col-sm-3">
                    		<label>Fecha hasta</label>
                    		<input type="date" id="txtFechaHasta" name="txtFechaHasta" value="{{ app.request.get( "txtFechaHasta") }}" class="form-control">
                    	</div>
                    	<div class="col-sm-3" align="center">
                    		  <label>Error Francia</label>
                              <div align="center">
                    		  {% if( app.request.get("chkError") == "on" ) %}
                                <input type="checkbox" class="checkbox" id="customCheck" name="chkError" checked>
                              {% else %}
                                <input type="checkbox" class="checkbox" id="customCheck" name="chkError">
                    		  {% endif %}
                              </div>
                    	</div>
                    	<div class="row col-sm-12 col-md-12">
    						<div>&nbsp;</div>
    						<div>&nbsp;</div>
    					</div>
        				<div class="col-sm-4 col-md-4">
        					<button class="btn btn-success col-xs-12" data-toggle="tooltip" id="consultar" title="" type="submit" data-placement="bottom" data-original-title="Consultar">
        						<div class="hidden-xs hidden-sm">Consultar</div>
        						<div class="hidden-md hidden-lg">
        							<i class="fa fa-search" aria-hidden="true"></i>
        						</div>
        					</button>
        					<button id="sendForm" type="submit" class="hide"></button>
        				</div>
                    	<div class="row col-sm-4 col-md-4">
    						<div>&nbsp;</div>
    						<div>&nbsp;</div>
    					</div>
    					<div class="col-sm-4 col-md-4">
        					<button class="btn btn-default col-xs-12" data-toggle="tooltip" title="" id="limpiar" type="button" onclik="limpiarForm" data-placement="bottom" data-original-title="Limpiar Parámetros de Búsqueda">
        						<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
        						<div class="hidden-md hidden-lg">
        							<i class="fa fa-undo" aria-hidden="true"></i>
        						</div>
        					</button>
        				</div>
        			    <div class="row">
    						<div>&nbsp;</div>
    						<div>&nbsp;</div>
    					</div>
    					<br>
						<div class="row text-center">
							<h4><strong>Total: {{cant}} documentos</strong></h4>
						</div>
        				<div class="col-sm-12 col-md-12 table-wrapper-scroll-y my-custom-scrollbar" >
        				
                            <table id="tablaLoteDoc" class="table-bordered table-striped mb-0">
                                <thead>
                                    <tr style='text-align:center' bgcolor="#e9e9e9">
                                    	<th>{{ 'Acción' }}</th>
                                    	<th>Fecha</th>
                                        <th>Apellido / Nombres</th>
                                        <th>Fecha Nacimiento</th>
                                        <th>Sexo</th>
                                        <th>Numeo. Doc.</th>
                                        <th>Id. Nacionalidad</th>
                                        <th>Id. Pais Emisor</th>
                                        <th>Tipo Denuncia</th>
                                        <th>Accion</th>
                                        <th>Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                	{% set j = 0 %}
                                    {% for Documento in loteDocumento %}
                                        <tr>
                                            <td style="text-align:center;">
                                            {% if ( Documento.mensajeremoto != "" and Documento.mensajeremoto != "REGISTRO ENVIADO CORRECTAMENTE" and Documento.mensajeremoto != "NO_ERROR (0)" ) %}
                                            	<a id="btnRes{{j|default('')}}" indice="{{ j }}" class="btn btn-info res" title="Ver Resultados (id:{{ Documento.ID }})" data-toggle="modal" onClick="mostrarDetalle( '{{ Documento.ID }}', 'btnRes{{j|default('')}}' );">
                                                <i class="fa fa-search"></i></a>
                                            {% endif %}
                                            </td>
                                            <td style='text-align:left'>{{ Documento.FECHA }}</td>
                                            <td style='text-align:left'>{{ Documento.APELLIDO ~ ' ' ~ Documento.OTROSAPELLIDOS ~ ' ' ~ Documento.NOMBRE ~ ' ' ~ Documento.OTROSNOMBRES ~ '' }}</td>
                                            <td>{{ Documento.FECHANACIMIENTO }}</td>
                                            <td>{{ Documento.SEXO }}</td>
                                            <td>{{ Documento.NUMERODOC }}</td>
                                            <td>{{ Documento.IDNACIONALIDAD }}</td>
                                            <td>{{ Documento.IDPAISEMISOR }}</td>
                                            <td>{{ Documento.TIPODENUNCIA }}</td>
                                            <td>{{ Documento.ACCION }}</td>
                                            <td style='text-align:left'>{{ Documento.MOTIVO }}</td>
                                        </tr>
                                        {% set j = j+1 %}
                                    {% endfor %}
                        
                                </tbody>
                            </table>
                            
                            <div class="row-fluid" align="center">
    		                    {{ pagerfanta (loteDocumento,'twitter_bootstrap_translated', { 'prev_message' : 'Anterior', 'next_message': 'Siguiente',"routeParams": {'txtApellido': app.request.get( "txtApellido"),'txtNombre': app.request.get( "txtNombre"),'txtTipDoc': app.request.get( "txtTipDoc"),'txtNroDoc': app.request.get( "txtNroDoc"),'txtFechaDesde': app.request.get( "txtFechaDesde"),'txtFechaHasta': app.request.get( "txtFechaHasta")}} ) }}
    		                </div>
         				</div>
                	</div>
                	
        		</div>
            </div>
            
            <div class="modal" id="popupView" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    			<div class="modal-dialog" role="document">
    				<div class="modal-content">
    					<div class="modal-header modal-header-primary">
    						<h5 class="modal-title text-center" id="exampleModalLabel"><b>Reproceso de Documento hacia el servicio de Interpol Francia</b></h5>
    					</div>
    					<div class="modal-body text-left" id="dvMensaje"></div>
    					<div class="modal-body text-left" id="dvDatos">
                			<div class="panel panel-default">
                				<div class="panel-body">
                					<div class="list-group-item-info col-sm-12">
                					<label><div id="dvRegistroID">Registro ID: </div></label>
                					</div>
                                	<div class="list-group-item list-group-item-info col-sm-6">
                                		<label>Apellido</label>
                                		<input type="text" name="txtApellidoM" id="txtApellidoM" value="" disabled="" class="form-control">
                                	</div>
                                	<div class="list-group-item list-group-item-info col-sm-6">
                                		<label>Nombre</label>
                                		<input type="text" name="txtNombreM" id="txtNombreM" value="" disabled="" class="form-control">
                                	</div>
                                	<div class="list-group-item list-group-item-info col-sm-6">
                                		<label>Tipo Documento</label>
                                		<input type="text" name="txtTipoDocM" id="txtTipoDocM" value="" disabled="" class="form-control">
                                	</div>
                                	<div class="list-group-item list-group-item-info col-sm-6">
                                		<label>Número Documento</label>
                                		<input type="text" name="txtNroDocM" id="txtNroDocM" value="" disabled="" class="form-control">
                                	</div>
                                    <input type="hidden" name="txtIdM" id="txtIdM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txotrosapellidosM" id="txotrosapellidosM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtotrosnombresM" id="txtotrosnombresM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtfechanacimientoM" id="txtfechanacimientoM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtsexoM" id="txtsexoM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtidnacionalidadM" id="txtidnacionalidadM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtidpaisemisorM" id="txtidpaisemisorM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txttipodenunciaM" id="txttipodenunciaM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtaccionM" id="txtaccionM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtfecharegistroM" id="txtfecharegistroM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtidpersonaM" id="txtidpersonaM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtmotivoM" id="txtmotivoM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtfechaM" id="txtfechaM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtestadoM" id="txtestadoM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtdescargadoM" id="txtdescargadoM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtfechahoradescM" id="txtfechahoradescM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtusudescM" id="txtusudescM" value="" disabled="" class="form-control">
                                    <input type="hidden" name="txtBotonSelect" id="txtBotonSelect">
                                </div>
                				<div >
                					<div class="panel-body">
                						<div class="list-group-item-info col-sm-12" id="dvMensajeRetorno" name="dvMensajeRetorno" style="visibility:hidden"></div>
                					</div>
                					<div class="panel-body">
                						<div class="list-group-item-info col-sm-12" id="dvMensajeUpdate" name="dvMensajeUpdate" style="visibility:hidden"></div>
                					</div>
    							</div>
                            </div>
    					</div>
    					<div class="modal-footer">
    						<button type="button" id="btnReprocesar" name="btnReprocesar" class="btn btn-success res" onClick="procesarCurlDoc();">Reprocesar</button>
    						<button type="button" class="btn btn-danger  res" data-dismiss="modal">Cerrar</button>
    					</div>
    				</div>
    			</div>
    		</div>
    	</div>
		
</form>
    <script>
        $(document).ready(function () {
    		if ($(window).width() < 600) {
    			$("#panelconsulta").attr("style","margin-bottom:2%;");
    	    }else{
    	    	$("#panelconsulta").attr("style","margin-left:0%;margin-bottom:2%;");
    	    }	//	if ($(window).width() < 600) {

    	    $('.pagination a').attr('class', 'btn btn-default');
            $('.pagination li').css('float', 'left');
            $('.pagination .active span').attr('class', 'btn btn-info');
            $('.pagination .prev span').attr('class', 'btn btn-default disabled');
            $('.pagination .next span').attr('class', 'btn btn-default disabled');

            $("#customCheck").removeClass("form-control");
            
            $('.table').DataTable({
                "scrollY": "600px",
                "scrollX": true,
                "scrollCollapse": true,
                "paging": false,
                "info": false,
                responsive: true,
                "filter": true,
                "order": [[0, "asc"]],
                "oLanguage": {
					"sSearch": 		   "Buscar:",
					"sEmptyTable": 	   "No se encontraron registros.",			
					"sProcessing":     "Procesando...",
					"sLengthMenu":     "Mostrar _MENU_ registros",
					"sZeroRecords":    "No se encontraron resultados",
					"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
					"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
					"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
					"sInfoPostFix":    "",
					"sSearch":         "Buscar:",
					"sUrl":            "",
					"sInfoThousands":  ",",
					"sLoadingRecords": "Cargando..."
				}
            });
    	    
            $('#limpiar').click(function () {
                $("#txtNombre"  ).val("");
                $("#txtApellido").val("");
                $("#txtFechaNac").val("");
                $("#txtNroDoc"  ).val("");
                $("#txtTipDoc"  ).val("");
                $("#lstTipoCons").val("AD").selectpicker('refresh');
                
                //$("#optNominals").attr('checked', true);
                document.getElementById("optNominals").checked = true;
            });	//	$('#limpiar').click(function () {

            $('#optNominals').click(function () {
            	document.getElementById("txtNombre").required = false;
            	document.getElementById("txtFechaNac").required = false;
            });
            
            $('#optNominalsExact').click(function () {
                document.getElementById("txtNombre").required = true;
                document.getElementById("txtFechaNac").required = true;                
            });

            $('#tablaLoteDoc').DataTable({
            	"scrollY": "600px",
            	"scrollX": true,
                "filter": false,
                "paging": false,
                "info": false,
                "order": [[1, "desc"]],
                "scrollCollapse": true,
                "responsive": true,
                "oLanguage": {
    				"sSearch": 		   "Buscar:",
    				"sEmptyTable": 	   "No se encontraron registros.",			
    				"sProcessing":     "Procesando...",
    				"sLengthMenu":     "Mostrar _MENU_ registros",
    				"sZeroRecords":    "No se encontraron resultados",
    				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
    				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
    				"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
    				"sInfoPostFix":    "",
    				"sSearch":         "Buscar:",
    				"sUrl":            "",
    				"sInfoThousands":  ",",
    				"sLoadingRecords": "Cargando..."
    			}
            });
        });
        
        function mostrarDetalle( pId, pBtn ){
            var sRetorno = "";
            $("#txtBotonSelect").val(pBtn);//	asigno el boton de la grilla que se seleccionó así en caso de procesar oculto dicho boton
            $("#btnReprocesar").attr("disabled", false);
            sRetorno = consultarRegistro( pId, pBtn );
            if (sRetorno =="OK") {
            	$('#popupView').modal( 'toggle' );
            }else{
				alert(sRetorno);
            }
        }	//	function mostrarDivDetalle(){

        function consultarRegistro( pId ){
        	//console.log("consultarRegistro: ["+pId+"]")
            var sRet = "";
            document.getElementById("dvMensajeRetorno").style.visibility='hidden'
            document.getElementById("dvMensajeUpdate").style.visibility='hidden'
    		 $.ajax({  
                 url:        '{{ path ('lotedocumento_consulta') }}',  
                 type:       'GET',
                 dataType:   'json',
                 async:      false,
                 data:{
						"ID": pId
                     },
                 success: function(data, status) {
                       if( data.ID == null ){
                    	   sRet = "Error, no se encontró el registro correspondiente al ID [" + ( pId == "" ? "null" : pId ) + "].";
                       }else{
                           $("#txtApellidoM"       ).val(data.apellido         );
                           $("#txtNombreM"         ).val(data.nombre           );
                           $("#txtTipoDocM"        ).val(data.tipodoc          );
                           $("#txtNroDocM"         ).val(data.numerodoc        );
                           $("#dvRegistroID"       ).html( "<p>Registro ID: " + data.ID+"</p>");
                           $("#txtIdM"             ).val( data.ID              );
                           $("#txtotrosapellidosM" ).val( data.otrosapellidos  );
                           $("#txtotrosnombresM"   ).val( data.otrosnombres    );
                           $("#txtfechanacimientoM").val( data.fechanacimiento );
                           $("#txtsexoM"           ).val( data.sexo            );
                           $("#txtidnacionalidadM" ).val( data.idnacionalidad  );
                           $("#txtidpaisemisorM"   ).val( data.idpaisemisor    );
                           $("#txttipodenunciaM"   ).val( data.tipodenuncia    );
                           $("#txtaccionM"         ).val( data.accion          );
                           $("#txtfecharegistroM"  ).val( data.fecharegistro   );
                           $("#txtidpersonaM"      ).val( data.idpersona       );
                           $("#txtmotivoM"         ).val( data.motivo          );
                           $("#txtfechaM"          ).val( data.fecha           );
                           $("#txtestadoM"         ).val( data.estado          );
                           $("#txtdescargadoM"     ).val( data.descargado      );
                           $("#txtfechahoradescM"  ).val( data.fechahoradesc   );
                           $("#txtusudescM"        ).val( data.usudesc         );
                           $('#dvMensaje').html( "El registro procesado originalmente fue rechazado con el siguiente mensaje:<br/><br/><b>" + data.mensajeremoto + "</b>." );
                           sRet = "OK";
                       }	//	if( data.ID == null ){
                 },
                 error : function(xhr, textStatus, errorThrown) {  
                	 sRet = 'Error al ejecutar la consulta Ajax.';  
                 }  
              });
             return sRet;
    	}	//	function consultarRegistro(){

        function procesarCurlDoc( ){
            /*
            console.log("procesarCurlDoc");
            console.log("PARAMETROS : ",
                  	 "Nombre"          +": "+ $("#txtNombreM"         ).val( ),
                	 "TipoDoc"         +": "+ $("#txtTipoDocM"        ).val( ),
                	 "Apellido"        +": "+ $("#txtApellidoM"       ).val( ),
                	 "NroDoc"          +": "+ $("#txtNroDocM"         ).val( ),
                	 "Id"              +": "+ $("#txtIdM"             ).val( ),
                	 "otrosapellidos"  +": "+ $("#txtotrosapellidosM" ).val( ),
                	 "otrosnombres "   +": "+ $("#txtotrosnombresM"   ).val( ),
                	 "fechanacimiento" +": "+ $("#txtfechanacimientoM").val( ),
                	 "sexo"            +": "+ $("#txtsexoM"           ).val( ),
                	 "idnacionalidad"  +": "+ $("#txtidnacionalidadM" ).val( ),
                	 "idpaisemisor"    +": "+ $("#txtidpaisemisorM"   ).val( ),
                	 "tipodenuncia"    +": "+ $("#txttipodenunciaM"   ).val( ),
                	 "accion"          +": "+ $("#txtaccionM"         ).val( ),
                	 "fecharegistro"   +": "+ $("#txtfecharegistroM"  ).val( ),
                	 "idpersona"       +": "+ $("#txtidpersonaM"      ).val( ),
                	 "motivo"          +": "+ $("#txtmotivoM"         ).val( ),
                	 "fecha"           +": "+ $("#txtfechaM"          ).val( ),
                	 "estado"          +": "+ $("#txtestadoM"         ).val( ),
                	 "descargado"      +": "+ $("#txtdescargadoM"     ).val( ),
                	 "fechahoradesc"   +": "+ $("#txtfechahoradescM"  ).val( ),
                	 "usudesc"         +": "+ $("#txtusudescM"        ).val( )
                    );
            */
            $.ajax({  
                 url:'{{ path ('lotedocumento_procesarCurlDoc') }}',  
                 type:'GET',
                 dataType:'json',
                 async:false,
                 data:{
                	 "Nombre"          : $("#txtNombreM"         ).val( ),
                	 "TipoDoc"         : $("#txtTipoDocM"        ).val( ),
                	 "Apellido"        : $("#txtApellidoM"       ).val( ),
                	 "NroDoc"          : $("#txtNroDocM"         ).val( ),
                	 "Id"              : $("#txtIdM"             ).val( ),
                	 "otrosapellidos"  : $("#txtotrosapellidosM" ).val( ),
                	 "otrosnombres "   : $("#txtotrosnombresM"   ).val( ),
                	 "fechanacimiento" : $("#txtfechanacimientoM").val( ),
                	 "sexo"            : $("#txtsexoM"           ).val( ),
                	 "idnacionalidad"  : $("#txtidnacionalidadM" ).val( ),
                	 "idpaisemisor"    : $("#txtidpaisemisorM"   ).val( ),
                	 "tipodenuncia"    : $("#txttipodenunciaM"   ).val( ),
                	 "accion"          : $("#txtaccionM"         ).val( ),
                	 "fecharegistro"   : $("#txtfecharegistroM"  ).val( ),
                	 "idpersona"       : $("#txtidpersonaM"      ).val( ),
                	 "motivo"          : $("#txtmotivoM"         ).val( ),
                	 "fecha"           : $("#txtfechaM"          ).val( ),
                	 "estado"          : $("#txtestadoM"         ).val( ),
                	 "descargado"      : $("#txtdescargadoM"     ).val( ),
                	 "fechahoradesc"   : $("#txtfechahoradescM"  ).val( ),
                	 "usudesc"         : $("#txtusudescM"        ).val( )
                     },
                 success:function(data, status) {
                     console.log("Respuesta Remota Status: [" + status + "]");
                	 console.log("Respuesta Remota Data: [" + data + "]");
                       if( data.message!="" ){
                           $("#dvMensajeRetorno").html("<b>El servicio arrojó la siguiente respuesta: " + data.respuesta +"</b>" );
                           document.getElementById("dvMensajeRetorno").style.visibility='visible';
                           $("#btnReprocesar").attr("disabled", true);
                           $("#"+$("#txtBotonSelect").val()).attr("disabled", true);
                           
                       }
                       if(data != undefined){
                        console.log("Respuesta Remota itemid: ["+data.itemid+"]");
                    	console.log("Respuesta Remota Mensaje: ["+data.respuesta+"]");
					   	actualizacionMensaje(data.respuesta, data.itemid);
                       }
                 },
                 error : function(xhr, textStatus, errorThrown) {
                	 console.log("Error Remoto: ["+textStatus+", "+xhr.responseText+", "+errorThrown+"]");
                	 $("#dvMensajeRetorno").html("Error al intentar procesar la petición al servicio remoto.");
                	 document.getElementById("dvMensajeRetorno").style.visibility='visible'
               	  }  
              });
    	}	//	function ejecutarLlamadoCurl(){

    	function actualizacionMensaje(pMensaje, pItemId){
        	console.log("actualizacionMensaje: "+pMensaje);
    		if(pMensaje=="" || pMensaje==undefined){
    			$("#dvMensajeUpdate").html("<b>Error al realizar la actualización del campo mensajeRemoto: undefined.</b>" );
        		return;
    		}
            $.ajax({  
                url:'{{ path ('lotedocumento_actualizarMensaje') }}',  
                type:'GET',
                dataType:'json',
                async:false,
                data:{
               	 "NroDoc"          : $("#txtNroDocM"         ).val( ),
               	 "ID"              : $("#txtIdM"             ).val( ),
               	 "mensajeRemoto"   : pMensaje                        ,
               	 "ITEMID"          : pItemId
                    },
                success:function(data, status) {
                      //console.log(data);
                      if( data.mensaje!="" ){
                          $("#dvMensajeUpdate").html("<b>Error al realizar la actualización del campo mensajeRemoto: " + data.mensaje +".</b>" );
                          document.getElementById("dvMensajeUpdate").style.visibility='visible';
                      }else{	//	if( data.mensaje!="" ){
                          $("#dvMensajeUpdate").html("<b>actualización del campo mensajeremoto se realizó correctamente.</b>" );
                          document.getElementById("dvMensajeUpdate").style.visibility='visible';
                      }	//	if( data.mensaje!="" ){
                },
                error : function(xhr, textStatus, errorThrown) {  
