    	function actualizacionMensaje(pMensaje, pItemId){
    		if(pMensaje=="" || pMensaje==undefined){
    			$("#dvMensajeUpdate").html("<b>Error al realizar la actualización del campo mensajeRemoto: undefined.</b>" );
        		return;
    		}else if(pMensaje == 'NO_ERROR (0)' || pMensaje == 'PAS is already searchable'){
    			pMensaje = 'REGISTRO ENVIADO CORRECTAMENTE';
        	}
            $.ajax({  
                url:'{{ path ('lotedocumento_actualizarMensaje') }}',  
                type:'GET',
                dataType:'json',
                async:false,
                data:{
               	 "NroDoc"          : $("#txtNroDocM"         ).val( ),
               	 "ID"              : $("#txtIdM"             ).val( ),
               	 "mensajeRemoto"   : pMensaje,
               	 "ITEMID"          : pItemId
                    },
                success:function(data, status) {
                      console.log(data.mensaje);
                      if( data.mensaje!="" ){
                          $("#dvMensajeUpdate").html("<b>Error al realizar la actualizaci&oacute;n del campo mensajeRemoto: " + data.mensaje +".</b>" );
                          document.getElementById("dvMensajeUpdate").style.visibility='visible';
                      }else{	//	if( data.mensaje!="" ){*
                          $("#dvMensajeUpdate").html("<b>actualización del campo mensajeremoto se realiz&oacute; correctamente.</b>" );
                          document.getElementById("dvMensajeUpdate").style.visibility='visible';
                      }	//	if( data.mensaje!="" ){
                },
                error : function(xhr, textStatus, errorThrown) {  
            	 $("#dvMensajeUpdate").html("Error al intentar procesar la actualizaci&oacute;n del campo mensaje remoto.");
            	 document.getElementById("dvMensajeUpdate").style.visibility='visible'
             
                }  
             });
        }	//	function actualizacionMensaje(){

