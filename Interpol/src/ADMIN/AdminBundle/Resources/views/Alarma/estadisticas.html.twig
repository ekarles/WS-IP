{% extends 'GESTIONGestionBundle::base.html.twig' %} {% block body -%}
<form id="frm" method="POST" action="{{ path('alarmas_estadisticas') }}">
	<div class="container" width="100%">
		<div class="row text-center">
			<h1>Interpol - Estad&iacute;sticas Alarmas</h1>
		</div>
		<div id="panelconsulta" class="col-xs-12 col-md-12"
			style="margin-bottom: 2%;">
			<div class="panel panel-info">
				<div class="panel-heading">
					<b>BUSCADOR</b> <i class="fa fa-search"></i>
					<a href="#" onclick="window.history.back();" role="button" id="btnCerrar1" name="btnCerrar1" _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
					<div _ngcontent-ktt-12="" class="pull-right">
                        <a class="btn btn-default res mb-2" href="javascript:exportar()" id="exportarCsv" style="margin-right:10px;" title="Exportar CSV">
	                       	<i class="fas fa-file-excel" style="color:green;"> Exportar CSV</i>
	                   	</a>
                    </div>
				</div>
				<div class="panel-body">
					<input type="hidden" id="busqueda" name="busqueda" value="{{app.request.get( "busqueda")}}" class="form-control">
					<input type="hidden" id="accion" name="accion" value="{{app.request.get( "accion")}}" class="form-control">
					<div class="row" style="margin-bottom:5px;">
						<div class="col-sm-4 mb-2">
							<label>Fecha desde</label> <input type="date" id="txtFechaDesde"
								name="txtFechaDesde" value="{{app.request.get( "txtFechaDesde")}}" 
								class="form-control" required>
						</div>
						<div class="col-sm-4 mb-2">
							<label>Fecha hasta</label> <input type="date" id="txtFechaHasta"
								name="txtFechaHasta" value="{{app.request.get( "txtFechaHasta")}}" 
								class="form-control" required>
						</div>
						<div class="col-sm-4">
							<label>Tipo Alarma</label> <select id="lstTipoAlar" name="lstTipoAlar[]" class="selectpicker" data-live-search="true" multiple>
								{% for alarmatipo in alarmastipo %}
								<option value="{{alarmatipo.altiid}}" {{alarmatipo.altiid in app.request.get( "lstTipoAlar") ? 'selected' : '' }} style="background-color:{{ alarmatipo.backcolor }};color:{{alarmatipo.textcolor}};">{{alarmatipo.nombre}}</option>
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-success col-xs-12" data-toggle="tooltip"
							id="consultar" title="" type="button" data-placement="bottom"
							data-original-title="Consultar">
							<div class="hidden-xs hidden-sm">Consultar</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-search" aria-hidden="true"></i>
							</div>
						</button>
						<button id="sendForm" type="submit" class="hide"></button>
					</div>
					<div class="row col-sm-4 col-md-4">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-default col-xs-12" data-toggle="tooltip"
							title="" id="limpiar" type="button" onclik="limpiarForm"
							data-placement="bottom"
							data-original-title="Limpiar Parámetros de Búsqueda">
							<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-undo" aria-hidden="true"></i>
							</div>
						</button>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-12 col-md-12">
                        <table id="tablaAlarmas" class="table-bordered table-striped mb-0">
                            <thead>
                                <tr style='text-align:center' bgcolor="#e9e9e9">
                                	<th style='text-align:center'>Tipo de alarmas</th>
                                	<th style='text-align:center'>Cantidad Generada</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for totalAlarmas in totalesAlarmas %}
                                    <tr>
                                        <td align="center">{{ totalAlarmas.tipo }}</td>
                                        <td align="center">{{ totalAlarmas.cant }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>                      
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
<script>
	$(document).ready(function () {
                
		$("#consultar").click(function(){
			$("#busqueda").val("SI");
			$("#frm").attr('action',"{{ path('alarmas_estadisticas') }}");
			$("#sendForm").click();
		});

		

        $('#tablaAlarmas').DataTable({
        	"scrollY": "600px",
        	"scrollX": true,
            "filter": true,
            "paging": false,
            "info": false,
            "order":[[0,"asc"]],
            "scrollCollapse": true,
            "responsive": true,
            "oLanguage": {
				"sSearch": 		   "Buscar en registros visibles:",
				"sEmptyTable": 	   '<div class="alert alert-seccondary"><i class="fa fa-info-circle" style="font-size: 20px"></i> <span style="font-size: 20px;"> No existen alarmas con los parámetros de búsqueda ingresados.</span></div>',			
				"sProcessing":     "Procesando...",
				"sLengthMenu":     "Mostrar _MENU_ registros",
				"sZeroRecords":    "No se encontraron resultados",
				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
				"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
				"sInfoPostFix":    "",
				"sUrl":            "",
				"sInfoThousands":  ",",
				"sLoadingRecords": "Cargando...",
				"columnDefs": [ {
	            	"targets": 8,
	            	"orderable": false
	            	} ],
				"oPaginate": {
                    "sFirst":    "Pri",
                    "sLast":     "Ult",
                    "sNext":     "Sig",
                    "sPrevious": "Ant"
                	}
			}
        });
	     
	});
	
	
	function exportar(){	
		$("#accion").val("csv");
		$("#frm").attr('target',"_blank");
		$("#sendForm").click();
		$("#accion").val("");
		$("#frm").removeAttr('target');
	}

</script>
{% endblock %}
