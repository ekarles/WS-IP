{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<br>
<div class="alert alert-danger" hidden=""></div>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="row">
                <div class="col-md-6">
                    <h4 >Alarma Nro: <strong >{{ alarma.alarid.iaId }}</strong> generada el día <strong >{{ alarma.fecha | date('d-m-Y H:i:s') }}</strong></h4>
                </div>
                <div class="col-md-3" id="dvEstado">
                    <h4 >Estado: {{ alarma.estadoid.nombre|default('') }}</h4>
                </div>
                <div class="col-md-3" id="dvBotonesHeader">
                    <button class="btn btn-primary pull-right" type="button" onclick="salir();">Salir</button>
                    {% if alarma.estadoid.estadoid == 1 %}
                    <button class="btn btn-warning pull-right btnIniciarTratamiento" style="width: auto;margin-right:3px;" type="button">Iniciar Tratamiento</button>
                    {% elseif alarma.estadoid.estadoid == 3 %}
                    <button class="btn btn-danger pull-right btnCerrarAlarma" style="width: auto;margin-right:3px;" type="button">Cerrar Alarma</button>
                    {% elseif alarma.estadoid.estadoid == 2 %}
                    <button class="btn btn-success pull-right btnReabrirAlarma" style="width: auto;margin-right:3px;" type="button">Reabrir</button>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="panel-body">
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 ><strong >{% if respuesta.nominal is defined %}{{respuesta.nominal.name}}, {{respuesta.nominal.forename}} {% if respuesta.nominal.alias is defined %}(Alias: {% if respuesta.nominal.alias[0] is defined %}{{respuesta.nominal.alias[0].name}}, {{respuesta.nominal.alias[0].forename}}{% else %}{{respuesta.nominal.alias.name}}, {{respuesta.nominal.alias.forename}}{% endif %}){% endif %}{% else %}Información{% endif %}</strong></h4>
                            </div>
                            <div class="panel-body">
                                <div class="row">
                                    <div class="col-xs-4">
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <a class="thumbnail" href="javascript:mostrar(-1)">
                                                    <img id="imagen" src="{{ asset( 'bundles/images/unknown.png' ) }}">
                                                </a>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xs-12">
                                            <table width="100%">
                                                <tbody >
                                                	<tr>
	                                                    <td width="20%">
	                                                        <button class="btn btn-default center-block">
	                                                       	    <span class="glyphicon glyphicon-chevron-left"></span>
	                                                        </button>
	                                                    </td>
	                                                    <td width="60%">
	                                                        <p class="text-center" style="padding-top:10px;" id="nroFoto">1 de 1</p>
	                                                    </td>
	                                                    <td width="20%">
	                                                        <button class="btn btn-default center-block">
	                                                            <span class="glyphicon glyphicon-chevron-right"></span>
	                                                        </button>
	                                                    </td>
                                                	</tr>
	                                                <tr >
	                                                    <td colspan="3" id="tdBuscarImagenes">
	                                                    	{% if alarma.alarid.iaNominalsdetailsEntityid is defined and respuesta.nominal.file is defined %}
	                                                        <button class="btn btn-primary center-block" id="btBuscarImagenes" onclick="buscarImagenes();">
	                                                        {% else %}
	                                                        <button class="btn btn-primary center-block" id="btBuscarImagenes" disabled="">
	                                                        {% endif %}
	                                                            <span class="glyphicon glyphicon-search" style="cursor:pointer;"></span>
	                                                            Buscar imagenes
	                                                        </button>
	                                                    </td>
	                                                </tr>
	                                            </tbody>
                                            	</table>
                                            </div>
                                        </div>
                                    </div>
									
                                    <div class="col-xs-8">
                                        <table class="table table-striped table-bordered">
                                            <tbody >
                                            <tr style="background-color:{{ alarma.altiid.backcolor }};color:{{alarma.altiid.textcolor}};">
                                            	<td class="tabla-clave"><h4>&nbsp;&nbsp;Notificación</h4></td>
                                            	<td class="tabla-valor"><h4>&nbsp;&nbsp;{{alarma.altiid.nombre}}</h4></td>
                                            </tr>
                                            {% if respuesta.nominal is defined %}
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Sexo</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{{respuesta.nominal.sex_id}}</strong></td>
                                                </tr>
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Fecha Nac.</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{{respuesta.nominal.date_of_birth|slice(6,2)}}/{{respuesta.nominal.date_of_birth|slice(4,2)}}/{{respuesta.nominal.date_of_birth|slice(0,4)}}</strong></td>
                                                </tr>
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Lugar Nac.</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{{respuesta.nominal.place_of_birth|default('')}}</strong></td>
                                                </tr>
                                                {% if respuesta.nominal.country_of_birth_id is defined %}
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Pa&iacute;s Nac.</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{{paises[respuesta.nominal.country_of_birth_id].DESCRIPCION}}</strong></td>
                                                </tr>	
                                                {% endif %}
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Tipo Doc.</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{% if respuesta.nominal.document[0] is defined %}{{respuesta.nominal.document[0].type_id|default('')}}{% else %}{{respuesta.nominal.document.type_id|default('')}}{% endif %}</strong></td>
                                                </tr>
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Nro. Doc.</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{% if respuesta.nominal.document[0] is defined %}{{respuesta.nominal.document[0].nr|default('')}}{% else %}{{respuesta.nominal.document.nr|default('')}}{% endif %}</strong></td>
                                                </tr>
                                                {% if respuesta.nominal.alias is defined %}
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Alias</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{% if respuesta.nominal.alias[0] is defined %}{{respuesta.nominal.alias[0].name}}, {{respuesta.nominal.alias[0].forename}}{% else %}{{respuesta.nominal.alias.name}}, {{respuesta.nominal.alias.forename}}{% endif %}</strong></td>
                                                </tr>
                                                {% endif %}
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Actualizado</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{{respuesta.nominal.db_last_updated_on|slice(6,2)}}/{{respuesta.nominal.db_last_updated_on|slice(4,2)}}/{{respuesta.nominal.db_last_updated_on|slice(0,4)}}</strong></td>
                                                </tr>
                                                <tr _ngcontent-hfu-22="">
                                                        <td class="tabla-clave">&nbsp;&nbsp;Visto</td>
                                                        <td class="tabla-valor">&nbsp;&nbsp;<strong _ngcontent-hfu-22="">{{respuesta.nominal.db_review_date|slice(6,2)}}/{{respuesta.nominal.db_review_date|slice(4,2)}}/{{respuesta.nominal.db_review_date|slice(0,4)}}</strong></td>
                                                </tr>
                                                {% endif %}
                                        </tbody>
                                        </table>
                                    </div>
                                </div>
                                <br>
                                <div class="panel panel-default" id="infoComple">
                                    <div class="panel-heading" style="height:50px;">
                                        <table style="width: 100%">
                                            <tbody ><tr >
                                                <td style="width: 100%"><h4 >Información Complementaria</h4></td>
                                            </tr>
                                        </tbody></table>
                                    </div>
                                    <div class="panel-body">
									<table class="table table-striped">
										<tbody >
											{% set resp = (respuesta.nominal is defined) ? respuesta.nominal : (respuesta.document is defined) ? respuesta.document : respuesta.vehicle %}
											{% set rootkey = (respuesta.nominal is defined) ? 'Datos Personales' : (respuesta.document is defined) ? 'Documento' : 'Vehículo' %}
											{% for key, value in resp  %}
												<tr >
												{% if value is iterable %}
														{% for k, val in value %}
															{% if val is iterable %}
																{% for i, v in val %}
																	{% if v is iterable %}
																		{% for j,d in v %}
																			{% if 'country' in j %}{% set d = paises[d].DESCRIPCION %}{% endif %}
																				<td class="tabla-clave">{% if j matches '/^\\d+$/' %}{{i|trans}}{% else %}{{j|trans}}{% endif %}</td>
																				<td class="tabla-clave">{{j|trans}}</td>
																			{% if 'date' in j or '_on' in j %}
																	 			<td class="tabla-valor"><strong >{{d|slice(6,2)}}/{{d|slice(4,2)}}/{{d|slice(0,4)}}</strong></td>
																			{% else %}	
																				<td class="tabla-valor"><strong >{{d}}</strong></td>
																			{% endif %}
																			</tr>
																    		<tr >
																		{% endfor %}
																	{% else %}
																			{% if 'country' in i %}{% set v = paises[v].DESCRIPCION %}{% endif %}
																			<td class="tabla-clave">{% if i matches '/^\\d+$/' %}{{k|trans}}{% else %}{{i|trans}}{% endif %}</td>
																			<td class="tabla-clave">{{i|trans}}</td>
																			{% if 'date' in i or '_on' in i %}
																	 			<td class="tabla-valor"><strong >{{v|slice(6,2)}}/{{v|slice(4,2)}}/{{v|slice(0,4)}}</strong></td>
																			{% else %}	
																				<td class="tabla-valor"><strong >{{v}}</strong></td>
																			{% endif %}
																		</tr>
															    		<tr >
															    	{% endif %}	
																{% endfor %}
															{% else %}
																{% if 'country' in k %}{% set val = paises[val].DESCRIPCION %}{% endif %}
																<td class="tabla-clave">{% if key matches '/^\\d+$/' %}{{rootkey}}{% else %}{{key|trans}}{% endif %}</td>
																<td class="tabla-clave">{{k|trans}}</td>
																{% if 'date' in k or '_on' in k %}
														 			<td class="tabla-valor"><strong >{{val|slice(6,2)}}/{{val|slice(4,2)}}/{{val|slice(0,4)}}</strong></td>
																{% else %}	
																	<td class="tabla-valor"><strong >{{val}}</strong></td>
																{% endif %}
														   {% endif %}
														    </tr>
														    <tr >
														{% endfor %}
												{% else %}
														{% if 'country' in key %}{% set value = paises[value].DESCRIPCION %}{% endif %}
														<td class="tabla-clave">{{rootkey}}</td>
														<td class="tabla-clave">{{key|trans}}</td>
														{% if 'date' in key or '_on' in key %}
												 			<td class="tabla-valor"><strong >{{value|slice(6,2)}}/{{value|slice(4,2)}}/{{value|slice(0,4)}}</strong></td>
														{% else %}	
															<td class="tabla-valor"><strong >{{value}}</strong></td>
														{% endif %}			
												{% endif %}
												</tr>
											{% endfor %}		
										</tbody>
									</table>
								</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                    	<div class="row">
							<div class="col-xs-12">
		                    	<info-usuario _nghost-msq-15="">
		                    		<div _ngcontent-msq-15="" class="panel panel-default">
									    <div _ngcontent-msq-15="" class="panel-heading" style="height:40px; font-weight: bold">
									        Usuario responsable
									    </div>
									    <div _ngcontent-msq-15="" class="panel-body">
									        <table _ngcontent-msq-15="" class="table table-striped table-bordered">
									            <tbody _ngcontent-msq-15="" style="text-align:left;">
										            <tr _ngcontent-msq-15="">
										                <td _ngcontent-msq-15="" class="tabla-clave">&nbsp;&nbsp;Usuario:</td>
										                <td _ngcontent-msq-15="" class="tabla-valor">&nbsp;&nbsp;{{alarma.usuario}}</td>
										            </tr>
										            <tr _ngcontent-msq-15="">
										                <td _ngcontent-msq-15="" class="tabla-clave">&nbsp;&nbsp;Nombre:</td>
										                <td _ngcontent-msq-15="" class="tabla-valor">&nbsp;&nbsp;{{alarma.usuarionombre}}</td>
										            </tr>
										            <tr _ngcontent-msq-15="">
										                <td _ngcontent-msq-15="" class="tabla-clave">&nbsp;&nbsp;Apellido:</td>
										                <td _ngcontent-msq-15="" class="tabla-valor">&nbsp;&nbsp;{{alarma.usuarioapellido}}</td>
										            </tr>
										            <tr _ngcontent-msq-15="">
										                <td _ngcontent-msq-15="" class="tabla-clave">&nbsp;&nbsp;Jerarquía:</td>
										                <td _ngcontent-msq-15="" class="tabla-valor">&nbsp;&nbsp;{{alarma.usuariojerarquia}}</td>
										            </tr>
										            <tr _ngcontent-msq-15="">
										                <td _ngcontent-msq-15="" class="tabla-clave">&nbsp;&nbsp;Modo consulta:</td>
										                <td _ngcontent-msq-15="" class="tabla-valor">&nbsp;&nbsp;{% if alarma.alarid.iaQueryMode == 'BC' %}Control Fronterizo{% else %}Investigaci&oacute;n{% endif %}</td>
										            </tr>
										        </tbody>
										    </table>
									    </div>
									</div>
								</info-usuario>
      						</div>

						<div class="col-xs-12">
							<info-dependencia _nghost-msq-16="">
							<div _ngcontent-msq-16="" class="panel panel-default">
								<div _ngcontent-msq-16="" class="panel-heading">
									<strong>Dependencia</strong>
								</div>
								<div _ngcontent-msq-16="" class="panel-body">
									<table _ngcontent-msq-16="" class="table table-striped table-bordered">
										<tbody _ngcontent-msq-16="">
											<tr _ngcontent-msq-16="">
												<td _ngcontent-msq-16="" class="tabla-clave">&nbsp;&nbsp;Nombre:</td>
												<td _ngcontent-msq-16="" class="tabla-valor">&nbsp;&nbsp;{{alarma.usuariodepen}}</td>
											</tr>
											<tr _ngcontent-msq-16="">
												<td _ngcontent-msq-16="" class="tabla-clave">&nbsp;&nbsp;Dirección:</td>
												<td _ngcontent-msq-16="" class="tabla-valor">&nbsp;&nbsp;{{dependencia.direccion|default('---')}}</td>
											</tr>
											<tr _ngcontent-msq-16="">
												<td _ngcontent-msq-16="" class="tabla-clave">&nbsp;&nbsp;Contacto:</td>
												<td _ngcontent-msq-16="" class="tabla-valor">&nbsp;&nbsp;{{dependencia.contacto|default('---')}}</td>
											</tr>
											<tr _ngcontent-msq-16="">
												<td _ngcontent-msq-16="" class="tabla-clave">&nbsp;&nbsp;Tipo:</td>
												<td _ngcontent-msq-16="" class="tabla-valor">&nbsp;&nbsp;{{dependencia.tipo|default('---')}}</td>
											</tr>
											<tr _ngcontent-msq-16="">
												<td _ngcontent-msq-16="" class="tabla-clave">&nbsp;&nbsp;Institución:</td>
												<td _ngcontent-msq-16="" class="tabla-valor">&nbsp;&nbsp;{{dependencia.institucion.nombre|default('---')}}</td>
											</tr>
											<tr _ngcontent-msq-16="">
												<td _ngcontent-msq-16="" class="tabla-clave">&nbsp;&nbsp;Observaciones:</td>
												<td _ngcontent-msq-16="" class="tabla-valor">&nbsp;&nbsp;{{dependencia.observaciones|default('---')}}</td>
											</tr>
										</tbody>
									</table>
								</div>
							</div>
							</info-dependencia>
						</div>

						<div class="col-md-12">
                                <div class="panel panel-default">
                                    <div class="panel-heading" style="height:50px;">
                                        <h4 >Tipificación</h4>
                                    </div>
                                    <div class="panel-body">
                                        <table style="width: 100%;">
                                            <tbody ><tr >
                                                <td style="width: 20%;" class="tabla-clave">
                                                    <label class="pull-left" for="tipo" style="padding-top:5px;">Notificación:</label>
                                                </td>
                                                <td style="width: 80%;">
                                                    <div style="padding-top: 5px;"></div>
                                                    <select id="alarmaTipo" class="form-control selectpicker" required="">
                                                        {% for alarmatipo in alarmastipo %}
														<option value="{{alarmatipo.altiid}}" style="background-color:{{ alarmatipo.backcolor }};color:{{alarmatipo.textcolor}};">{{alarmatipo.nombre}}</option>
														{% endfor %}
                                                    </select>
                                                </td>
                                            </tr>
                                            <tr >
                                                <td class="tabla-clave">
                                                    <label class="pull-left" for="tipo" style="padding-top:5px;">Delito:</label>
                                                </td>
                                                <td style="width: 80%;">
                                                    <div style="padding-top: 5px;"></div>
                                                    <select id="tipoDelito" class="form-control selectpicker">
                                                    	<option value=""></option>
                                                        {% for tipodelito in tiposdelito %}
														<option value="{{tipodelito.id}}">{{tipodelito.nombre}}</option>
														{% endfor %}
                                                    </select>
                                                </td>
                                            </tr>
                                            <tr >
                                                <td colspan="2" style="width: 100%;" id="tdBotonTipificacion">
                                                    <div style="padding-top: 5px;"></div>
                                                    <button class="btn btn-primary pull-right" id="btTipificacion" type="button">Guardar</button>
                                                </td>
                                            </tr>

                                        </tbody></table>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12">
                                <div class="panel panel-default">
                                    <div class="panel-heading" style="height:50px;">
                                        <h4 >Seguimiento</h4>
                                    </div>
                                    <div class="panel-body">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <table style="width: 100%;">
                                                    <tbody>
                                                     <tr>
                                                         <td>
                                                             <label for="descripcion">Comentario</label>
                                                             <textarea class="form-control" id="descripcion" name="descripcion" required="" rows="3" style="overflow: auto; resize: none;"></textarea>
                                                         </td>
                                                     </tr>
                                                     <tr>
                                                         <td id="tdBotonComentario">
                                                             <div style="padding-top: 5px;"></div>
                                                             <button class="btn btn-primary pull-right" type="button" id="btComentario" disabled="">Aceptar</button>  
                                                         </td>
                                                     </tr>
                                                	</tbody>
                                                </table>
                                            </div>
                                            <div class="col-md-12" style="margin-top:10px;overflow:auto; height:300px;">
                                                <table class="table table-striped" style="font-size: 10px;">
                                                    <thead >
                                                        <tr class="table-header">
                                                            <th class="tabla-clave" style="width:15%;"><strong>Fecha</strong></th>
                                                            <th class="tabla-clave" style="width:25%;"><strong>Tipo</strong></th>
                                                            <th class="tabla-clave" style="width:20%;"><strong>Usuario</strong></th>
                                                            <th class="tabla-clave" style="width:40%;"><strong>Descripcion</strong></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="bodyDetalle">
                                                    	{% for aladet in alarmaDetalle %}
                                                        <tr >
                                                            <td class="tabla-valor">{{aladet.fecha | date('d-m-Y H:i:s')}}</td>
                                                            <td class="tabla-valor">{{aladet.aldtid.nombre}}</td>
                                                            <td class="tabla-valor">{{aladet.usuarioid.usuario}}</td>
                                                            <td class="tabla-valor">{{aladet.descripcion}}</td>
                                                        </tr>   
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer">
            <div class="row">
                <div class="col-md-8"> </div>
                <div class="col-md-4 pull-right" id="dvBotonesFooter">
                    <button class="btn btn-primary pull-right" type="button" onclick="salir();">Salir</button>
                    {% if alarma.estadoid.estadoid == 1 %}
                    <button class="btn btn-warning pull-right btnIniciarTratamiento" style="width: auto;margin-right:3px;" type="button">Iniciar Tratamiento</button>
                    {% elseif alarma.estadoid.estadoid == 3 %}
                    <button class="btn btn-danger pull-right btnCerrarAlarma" style="width: auto;margin-right:3px;" type="button">Cerrar Alarma</button>
                    {% elseif alarma.estadoid.estadoid == 2 %}
                    <button class="btn btn-success pull-right btnReabrirAlarma" style="width: auto;margin-right:3px;" type="button">Reabrir</button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
	<div class="modal fade" id="msgConfirm" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-body">
					<button type="button" class="bootbox-close-button close" data-dismiss="modal" aria-hidden="true" style="margin-top: -10px;">×</button>
					<div id="msg-body" style="text-align:center;font-weight: bold;"></div>
				</div>
				<div class="modal-footer" id="dvModalFooter">
					<button type="button" data-dismiss="modal" class="btn btn-danger">Cancelar</button>
					<button id="confirm" type="button" class="btn btn-success">OK</button>
				</div>
			</div>
		</div>
	</div>
	<div class="bootbox modal fade bootbox-alert in" tabindex="-1" role="dialog" id="showImages">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h4 class="modal-title">Imagen</h4>
				</div>
				<div class="modal-body">
					<div class="bootbox-body">
						<a href="javascript:void(0)" class="thumbnail"><img id="imgMostrar" src="{{ asset( 'bundles/images/unknown.png' ) }}"></a>
					</div>
				</div>
				<div class="modal-footer">
					<button data-bb-handler="ok" type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
				</div>
			</div>
		</div>
	</div>
<script>
$(document).ready(function(){

	$("#alarmaTipo").val('{{alarma.altiid.altiid}}').change();

	agregarEventos();

	if($("#descripcion").val().length == 0){
            $("#btComentario").attr('disabled','');
	}
	
	$("#descripcion").keyup(function(){
            if($(this).val().length > 0){
                    $("#btComentario").removeAttr('disabled');
            }else{
                    $("#btComentario").attr('disabled','');
            }
	});

	$("#btComentario").click(function(){
            $(this).attr('disabled','');	
            $(this).hide();
            $('#tdBotonComentario').append('<button class="btn btn-primary pull-right wait-comentario" type="button" disabled="">&nbsp;&nbsp;&nbsp;&nbsp;<i class="fas fa-spinner fa-spin"></i>&nbsp;&nbsp;&nbsp;&nbsp;</button>');
            trabajarAlarma('comentario');
	});

	$("#btTipificacion").click(function(){
		
            $('#msg-body').html('¿Est&aacute; seguro que desea cambiar la tipificaci&oacute;n?');

            $("#confirm").click(function(){
                trabajarAlarma('tipificacion');	
            });

            $("#msgConfirm").modal();
	});

	$(".glyphicon-chevron-right").parent().attr("disabled","");
	$(".glyphicon-chevron-left").parent().attr("disabled","");
    
});

function trabajarAlarma(opcion){
	$("#confirm").hide();
	$("#dvModalFooter").append('<button id="wait" type="button" class="btn btn-success wait" disabled="">&nbsp;<i class="fas fa-spinner fa-spin"></i>&nbsp;</button>');
	
	switch(opcion){
		case 'inicio':
			requestData = {'opcion':'inicio'};
			break;
		case 'cerrar':
			requestData = {'opcion':'cerrar'};
			break;
		case 'reabrir':
			requestData = {'opcion':'reabrir'};
			break;
		case 'comentario':
			requestData = {'opcion':'comentario','descripcion':$("#descripcion").val()};
			break;
		case 'tipificacion':
			requestData = {'opcion':'tipificacion','alarmaTipoId':$("#alarmaTipo").val(),'tipoDelitoId':$("#tipoDelito").val()};
			break;				
	}
	
	$.post('{{path('alarmas_trabajar', {'id': alarma.alarid.iaId } )}}', requestData )
		.done(function (data) {
				try {
		    		var d = jQuery.parseJSON(data);

		    		var html = '<tr >';
			        html +=	    	'<td class="tabla-valor">' + d.fecha + '</td>';
			        html +=	    	'<td class="tabla-valor">' + d.tipo + '</td>';
			        html +=	    	'<td class="tabla-valor">' + d.usuario + '</td>';
			        html +=         '<td class="tabla-valor">' + d.descripcion + '</td>';
			        html +=    '</tr>';

					$('#bodyDetalle').append(html);

					$('#dvEstado').html('<h4 >Estado: '+d.estado+'</h4>');

					if(opcion=='inicio'){
						$(".btnIniciarTratamiento").remove();
						$("#dvBotonesHeader").append('<button class="btn btn-danger pull-right btnCerrarAlarma" style="width: auto;margin-right:3px;" type="button">Cerrar Alarma</button>');
						$("#dvBotonesFooter").append('<button class="btn btn-danger pull-right btnCerrarAlarma" style="width: auto;margin-right:3px;" type="button">Cerrar Alarma</button>');
						agregarEventos();
					}else if(opcion=='cerrar'){
						$(".btnCerrarAlarma").remove();
						$("#dvBotonesHeader").append('<button class="btn btn-success pull-right btnReabrirAlarma" style="width: auto;margin-right:3px;" type="button">Reabrir</button>');
						$("#dvBotonesFooter").append('<button class="btn btn-success pull-right btnReabrirAlarma" style="width: auto;margin-right:3px;" type="button">Reabrir</button>');
						agregarEventos();
					}else if(opcion=='reabrir'){
						$(".btnReabrirAlarma").remove();
						$("#dvBotonesHeader").append('<button class="btn btn-warning pull-right btnIniciarTratamiento" style="width: auto;margin-right:3px;" type="button">Iniciar Tratamiento</button>');
						$("#dvBotonesFooter").append('<button class="btn btn-warning pull-right btnIniciarTratamiento" style="width: auto;margin-right:3px;" type="button">Iniciar Tratamiento</button>');
						agregarEventos();
					}else if(opcion=='comentario'){
						$("#descripcion").val('');
						$(".wait-comentario").remove();
						$("#btComentario").show();
					}
				}
		        catch (e) {
		            alert("Ha perdido la sesi\u00F3n.");
		            location.reload(); 
		        };
		        
                        $("#msgConfirm").modal('hide');
                        $(".wait").remove();
                        $("#confirm").unbind();
                        $("#confirm").show();				
			
		}).fail(function (jqXHR, textStatus, errorThrown) {
            console.log('Status:'+jqXHR.status+' Error:'+errorThrown);
    	});
}

function agregarEventos(){
	
	$("#confirm").unbind();

	$(".btnIniciarTratamiento").click(function(){
        $('#msg-body').html('¿Desea iniciar el tratamiento de la alarma?');

        $("#confirm").click(function(){
            trabajarAlarma('inicio');	
        });

		$("#msgConfirm").modal();
    });

    $(".btnCerrarAlarma").click(function(){
        $('#msg-body').html('¿Desea cerrar la alarma?');

        $("#confirm").click(function(){
            trabajarAlarma('cerrar');	
        });

		$("#msgConfirm").modal();
    });
    
    $(".btnReabrirAlarma").click(function(){
        $('#msg-body').html('¿Desea reabrir la alarma?');

        $("#confirm").click(function(){
            trabajarAlarma('reabrir');	
        });

	$("#msgConfirm").modal();
    });
}


{% if alarma.alarid.iaNominalsdetailsEntityid is defined and respuesta.nominal.file is defined %}

var arrayImg = new Array();
var cont = 0;

function buscarImagenes(){
	var cant = 0;
	arrayImg = [];
	cont = 0;

	$(".glyphicon-chevron-right").parent().attr("disabled","");
	$(".glyphicon-chevron-left").parent().attr("disabled","");
	$("#btBuscarImagenes").hide();
	$('#tdBuscarImagenes').append('<button class="btn btn-primary wait-buscar-imagenes center-block" type="button" disabled="" style="width:100%;"><i class="fas fa-spinner fa-spin"></i></button>');	

	{% if respuesta.nominal.file[0] is defined %}
		{% for file in respuesta.nominal.file %}
			{% if file.type_id == 'photo' %}
				cant++;
				var requestData = {'entityId':'{{alarma.alarid.iaNominalsdetailsEntityid}}','path':'{{file.path}}'};

				console.log(requestData);
				
				$.post('{{path('alarmas_buscar_imagen')}}', requestData )
					.done(function (data) {
						try{
								
							console.log(data);
							var resp = jQuery.parseJSON(data);
							
							if(!resp.error){
								arrayImg.push(resp.imagenBase64);
								{% if loop.index==1 %}
									$("#imagen").attr('src',resp.imagenBase64);
									$("#imagen").parent().attr('href','javascript:mostrar(0)');
								{% elseif loop.index==respuesta.nominal.file|length %}
									addIdxImg({{respuesta.nominal.file|length}});
								  	$("#nroFoto").html("1 de " + cant);
								{% endif %}
							}else{
								alert(resp.error);
							}
	
							cont++;
	
							if(cont=={{respuesta.nominal.file|length}}){
								cont=0;
							}
						}
				        catch (e) {
				        	console.log('Error: '+e.message);
				            alert("Ha perdido la sesi\u00F3n.");
				            location.reload(); 
				        };
				        $(".wait-buscar-imagenes").remove();
						$("#btBuscarImagenes").show();							
					}).fail(function (jqXHR, textStatus, errorThrown) {
			            console.log('Status:'+jqXHR.status+' Error:'+errorThrown);
			            $(".wait-buscar-imagenes").remove();
						$("#btBuscarImagenes").show();
			    	});
	    	{% endif %}
		{% endfor %}
	{% else %}	
		{% if respuesta.nominal.file.type_id == 'photo' %}	
			var requestData = {'entityId':'{{alarma.alarid.iaNominalsdetailsEntityid}}','path':'{{respuesta.nominal.file.path}}'};

			console.log(requestData);
			
			
			$.post('{{path('alarmas_buscar_imagen')}}', requestData )
				.done(function (data) {
					try{
						var resp = jQuery.parseJSON(data);
	
						if(!resp.error){
							arrayImg.push(resp.imagenBase64);
							$("#imagen").attr('src',resp.imagenBase64);
							$("#imagen").parent().attr('href','javascript:mostrar(0)');
							$(".wait-buscar-imagenes").remove();
							$("#btBuscarImagenes").show();
						}else{
							alert(resp.error);
							$(".wait-buscar-imagenes").remove();
							$("#btBuscarImagenes").show();
						}
					}
			        catch (e) {
				        console.log('Error: '+e.message);
			            alert("Ha perdido la sesi\u00F3n.");
			            location.reload(); 
			        };
				}).fail(function (jqXHR, textStatus, errorThrown) {
			        console.log('Status:'+jqXHR.status+' Error:'+errorThrown);
			        $(".wait-buscar-imagenes").remove();
					$("#btBuscarImagenes").show();
				});
		{% endif %}
	{% endif %}

}

var idx=0;

function addIdxImg(cant){
	
	$(".glyphicon-chevron-right").parent().removeAttr("disabled");
	$(".glyphicon-chevron-right").parent().unbind();
	$(".glyphicon-chevron-left").parent().unbind();
	
	$(".glyphicon-chevron-right").parent().click(function(){
		idx++;
		
		if(idx==1){
			$(".glyphicon-chevron-left").parent().removeAttr("disabled");
		}
		if(idx==(cant-1)){
			$(this).attr("disabled","");
		}
		$("#imagen").attr('src',arrayImg[idx]);
		$("#imagen").parent().attr('href','javascript:mostrar('+idx+')');
		$("#nroFoto").html((idx+1)+" de " + cant)
	});
	
	$(".glyphicon-chevron-left").parent().click(function(){
		idx--;
		if(idx==0){
			$(this).attr("disabled","");			
		}
		if(idx<(cant-1)){
			$(".glyphicon-chevron-right").parent().removeAttr("disabled");	
		}
		$("#imagen").attr('src',arrayImg[idx]);
		$("#imagen").parent().attr('href','javascript:mostrar('+idx+')');
		$("#nroFoto").html((idx+1)+" de " + cant);
	});	
}


{% endif %}


function mostrar(idx){
	if(idx >= 0){
		$("#imgMostrar").attr('src',arrayImg[idx]);
	}
	$("#showImages").modal();
}

function salir(){
    $('.animationload').fadeIn();
    $.post('{{path('_homepage')}}')
            .done(function (data) {
                window.location = '{{path('alarmas')}}';
            }).fail(function (jqXHR, textStatus, errorThrown) {
            console.log('Status:'+jqXHR.status+' Error:'+errorThrown);
            }); 
    
}

