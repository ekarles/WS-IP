{% extends 'GESTIONGestionBundle::base.html.twig' %} {% block body -%}
<form id="frm" method="POST" action="{{ path('alarmas') }}">
	<div class="container" width="100%">
		<div class="row text-center">
			<h1>Interpol - Alarmas</h1>
		</div>
		<div id="panelultimas24hs" class="col-xs-12 col-md-12"
			style="margin-bottom: 2%;">
			<div class="panel panel-info">
				<div class="panel-heading">
					<b>ALARMAS PENDIENTES ÚLTIMAS 24hs</b> <span class="badge badge-pill" style="background-color:gray;"> {{ultimas24|length}} </span>
					<div _ngcontent-ktt-12="" class="pull-right">
                        <a class="btn btn-primary" href="{{path('alarmas_estadisticas')}}" id="btnEstadisticas" style="margin-right:10px;" title="Estad&iacute;sticas">
	                       	<i class="fas fa-solid fa-chart-pie"> <strong>Estad&iacute;sticas</strong></i>
	                   	</a>
                    </div>
				</div>
				<div class="panel-body">
					<div class="col-sm-12 col-md-12">
                        <table id="tablaUltimas24Hs" class="table-bordered table-striped mb-0">
                            <thead>
                                <tr style='text-align:center' bgcolor="#e9e9e9">
                                	<th style='text-align:center'>Id</th>
                                	<th style='text-align:center'>Fecha</th>
                                	<th style='text-align:center'>Tipo</th>
                                	<th style='text-align:center'>Tiempo Respuesta</th>
                                	<th style='text-align:center'>Estado</th>
                                	<th style='text-align:center'>Dependecia</th>
                                    <th style='text-align:center'>Usuario</th>
                                    <th style='text-align:center'>Jerarqu&iacute;a</th>
                                    <th style='text-align:center'>Modo</th>
                                    <th style='text-align:center'>Acción</th>
                                </tr>
                            </thead>
                            <tbody style="overflow-y:scroll;">
                                {% for alarma in ultimas24 %}
                                    <tr style="background-color:{{ alarma.altiid.backcolor }};color:{{alarma.altiid.textcolor}};">
                                        <td align="center">{{ alarma.alarid.iaId }}</td>
                                        <td align="center">{{ alarma.fecha | date('Y-m-d H:i:s') }}</td>
                                        <td align="center">{{ alarma.altiid.nombre }}</td>
                                        <td align="center">{{ alarma.alarid.iaTimeResponse }}</td>
                                        <td align="center">{{ alarma.estadoid.nombre }}</td>
                                        <td align="center">{{ alarma.usuariodepen }}</td>
                                        <td align="center">{{ alarma.usuario }}</td>
                                        <td align="center">{{ alarma.usuariojerarquia }}</td>
                                        <td align="center"><strong>{% if alarma.alarid.iaQueryMode == 'BC' %}Control Fronterizo{% else %}Investigaci&oacute;n{% endif %}</strong></td>
                                        <td align="center">
                                        	<a class="btn btn-info res" title="Ver Detalle" href="{{path('alarmas_show',{'id':alarma.alarid.iaId})}}">
                                            	<i class="fa fa-info-circle"> Ver</i>
                                        	</a>                                        	
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>                       
					</div>
				</div>
			</div>
		</div>
		<div id="panelconsulta" class="col-xs-12 col-md-12"
			style="margin-bottom: 2%;">
			<div class="panel panel-success">
				<div class="panel-heading">
					<b>BUSCADOR</b> <i class="fa fa-search"></i>
				</div>
				<div class="panel-body">
					<input type="hidden" id="busqueda" name="busqueda" value="{{app.request.get( "busqueda")}}" class="form-control">
					<div class="row" style="margin-bottom:5px;">
						<div class="col-sm-4 mb-2">
							<label>Usuario</label> <input type="text" id="txtUsuario"
								name="txtUsuario" value="{{app.request.get( "txtUsuario")}}"
								class="form-control">
						</div>
						<div class="col-sm-4 mb-2">
							<label>Fecha desde</label> <input type="date" id="txtFechaDesde"
								name="txtFechaDesde" value="{{app.request.get( "txtFechaDesde")}}" 
								class="form-control" required>
						</div>
						<div class="col-sm-4 mb-2">
							<label>Fecha hasta</label> <input type="date" id="txtFechaHasta"
								name="txtFechaHasta" value="{{app.request.get( "txtFechaHasta")}}" 
								class="form-control" required>
						</div>
					</div>
					<div class="row">	
						<div class="col-sm-4">
							<label>Dependencia</label> <input type="hidden" id="txtIdDependencia" name="txtIdDependencia">
							<input type="text" id="txtDependencia" name="txtDependencia" value="{{app.request.get( "txtDependencia")}}" class="form-control">
						</div>
						<div class="col-sm-4">
							<label>Tipo Alarma</label> <select id="lstTipoAlar"
								name="lstTipoAlar" class="selectpicker" data-live-search="true">
								<option value="" style="background-color:white;color:black;" selected>Seleccione el tipo de alarma</option>
								{% for alarmatipo in alarmastipo %}
								<option value="{{alarmatipo.altiid}}" style="background-color:{{ alarmatipo.backcolor }};color:{{alarmatipo.textcolor}};">{{alarmatipo.nombre}}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-sm-4">
							<label>Modo Consulta</label> <select id="lstModo"
								name="lstModo" class="selectpicker">
								<option value="" selected>Seleccione el modo</option>
								<option value="BC">Control Fronterizo</option>
								<option value="AD">Investigaci&oacute;n</option>
							</select>
						</div>
					</div>	
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-success col-xs-12" data-toggle="tooltip"
							id="consultar" title="" type="button" data-placement="bottom"
							data-original-title="Consultar">
							<div class="hidden-xs hidden-sm">Consultar</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-search" aria-hidden="true"></i>
							</div>
						</button>
						<button id="sendForm" type="submit" class="hide"></button>
					</div>
					<div class="row col-sm-4 col-md-4">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-default col-xs-12" data-toggle="tooltip"
							title="" id="limpiar" type="button" onclik="limpiarForm"
							data-placement="bottom"
							data-original-title="Limpiar Parámetros de Búsqueda">
							<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-undo" aria-hidden="true"></i>
							</div>
						</button>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-12 col-md-12">
                        <table id="tablaAlarmas" class="table-bordered table-striped mb-0">
                            <thead>
                                <tr style='text-align:center' bgcolor="#e9e9e9">
                                	<th style='text-align:center'>Id</th>
                                	<th style='text-align:center'>Fecha</th>
                                	<th style='text-align:center'>Tipo</th>
                                	<th style='text-align:center'>Estado</th>
                                	<th style='text-align:center'>Dependecia</th>
                                    <th style='text-align:center'>Usuario</th>
                                    <th style='text-align:center'>Jerarqu&iacute;a</th>
                                    <th style='text-align:center'>Modo</th>
                                    <th style='text-align:center'>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for alarma in alarmas %}
                                    <tr style="background-color:{{ alarma.altiid.backcolor }};color:{{alarma.altiid.textcolor}};">
                                        <td align="center">{% if alarma.alarid is defined %}{{ alarma.alarid.iaId }}{% endif %}</td>
                                        <td align="center">{{ alarma.fecha | date('Y-m-d H:i:s') }}</td>
                                        <td align="center">{{ alarma.altiid.nombre }}</td>
                                        <td align="center">{{ alarma.estadoid.nombre }}</td>
                                        <td align="center">{{ alarma.usuariodepen }}</td>
                                        <td align="center">{{ alarma.usuario }}</td>
                                        <td align="center">{{ alarma.usuariojerarquia }}</td>
                                        <td align="center">{% if alarma.alarid is defined %}<strong>{% if alarma.alarid.iaQueryMode == 'BC' %}Control Fronterizo{% else %}Investigaci&oacute;n{% endif %}{% endif %}</strong></td>
                                        <td align="center">
                                        	<a class="btn btn-info res" title="Ver Detalle" href="{% if alarma.alarid is defined %}{{path('alarmas_show',{'id':alarma.alarid.iaId})}}{% else %}{{'#'}}{% endif %}">
                                            	<i class="fa fa-info-circle"> Ver</i>
                                        	</a>                                        	
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <div class="row-fluid" align="center">        
		                    {{ pagerfanta (alarmas,'twitter_bootstrap_translated', { 'prev_message' : 'Anterior', 'next_message': 'Siguiente',"routeParams": {'txtUsuario': app.request.get( "txtUsuario"),'txtFechaDesde': app.request.get( "txtFechaDesde"),'txtFechaHasta': app.request.get( "txtFechaHasta"),'lstModo': app.request.get( "lstModo"),'lstResult': app.request.get( "lstResult"),'txtDependencia': app.request.get( "txtDependencia"), 'lstTipoAlar': app.request.get( "lstTipoAlar") }} ) }}
		                </div>                        
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
<script>
	$(document).ready(function () {
                $("#dvAlarmas24").html('{{ultimas24|length}}');
                
                $.post('{{path('_homepage')}}')
                    .done(function (data) {
                        console.log('Menú actualizado correctamente.');
                    }).fail(function (jqXHR, textStatus, errorThrown) {
                        console.log('Status:'+jqXHR.status+' Error:'+errorThrown);
                    });
                
            
		if ($(window).width() < 600) {
			$("#panelconsulta").attr("style","margin-bottom:2%;");
		}else{
			$("#panelconsulta").attr("style","margin-left:0%;margin-bottom:2%;");
		}

		$("#consultar").click(function(){
			$("#busqueda").val("SI");
			$("#frm").attr('action',"{{ path('alarmas') }}");
			$("#sendForm").click();
		});

		{% if app.request.get( "busqueda")=='SI' or app.request.get( "page")!='' %}
			$(window).scrollTop($('#panelconsulta').offset().top);
		{% endif %}
				
		$("#lstTipoAlar").val("{{app.request.get( "lstTipoAlar")}}").selectpicker('refresh');
	    $("#lstModo").val("{{app.request.get( "lstModo")}}").selectpicker('refresh');
		
		$('#limpiar').click(function () {
		    $("#txtUsuario").val("");
		    $("#txtFechaDesde").val("");
		    $("#txtFechaHasta").val("");
		    $("#txtDependencia").val("");
		    $("#lstTipoAlar").val("").selectpicker('refresh');
		    $("#lstModo").val("").selectpicker('refresh');
		});

	    $('.pagination a').attr('class', 'btn btn-default');
        $('.pagination li').css('float', 'left');
        $('.pagination .active span').attr('class', 'btn btn-info');
        $('.pagination .prev span').attr('class', 'btn btn-default disabled');
        $('.pagination .next span').attr('class', 'btn btn-default disabled');

        $('#tablaUltimas24Hs').DataTable({
        	"scrollY": "400px",
        	"scrollX": true,
            "filter": true,
            "paging": true,
            "info": false,
            "order":[[0,"desc"]],
            "scrollCollapse": true,
            "responsive": true,
            "columnDefs": [ {
            	"targets": 8,
            	"orderable": false
            	} ],	
            "oLanguage": {
				"sSearch": 		   "Buscar:",
				"sEmptyTable": 	   '<div class="alert alert-success"><i class="fa fa-info-circle" style="font-size: 20px"></i> <span style="font-size: 20px;"> No existen alarmas pendientes</span></div>',			
				"sProcessing":     "Procesando...",
				"sLengthMenu":     "Mostrar _MENU_ registros",
				"sZeroRecords":    "No se encontraron resultados",
				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
				"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
				"sInfoPostFix":    "",
				"sSearch":         "Buscar:",
				"sUrl":            "",
				"sInfoThousands":  ",",
				"sLoadingRecords": "Cargando...",
				"oPaginate": {
                    "sFirst":    "Pri",
                    "sLast":     "Ult",
                    "sNext":     "Sig",
                    "sPrevious": "Ant"
                	}
			}
        });

        $('#tablaAlarmas').DataTable({
        	"scrollY": "600px",
        	"scrollX": true,
            "filter": true,
            "paging": false,
            "info": false,
            "order":[[0,"desc"]],
            "scrollCollapse": true,
            "responsive": true,
            "columnDefs": [ {
            	"targets": 8,
            	"orderable": false
            	} ],	
            "oLanguage": {
				"sSearch": 		   "Buscar en registros visibles:",
				"sEmptyTable": 	   '<div class="alert alert-seccondary"><i class="fa fa-info-circle" style="font-size: 20px"></i> <span style="font-size: 20px;"> No existen alarmas con los parámetros de búsqueda ingresados.</span></div>',			
				"sProcessing":     "Procesando...",
				"sLengthMenu":     "Mostrar _MENU_ registros",
				"sZeroRecords":    "No se encontraron resultados",
				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
				"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
				"sInfoPostFix":    "",
				"sUrl":            "",
				"sInfoThousands":  ",",
				"sLoadingRecords": "Cargando...",
				"columnDefs": [ {
	            	"targets": 8,
	            	"orderable": false
	            	} ],
				"oPaginate": {
                    "sFirst":    "Pri",
                    "sLast":     "Ult",
                    "sNext":     "Sig",
                    "sPrevious": "Ant"
                	}
			}
        });

        $("#txtDependencia").autocomplete({
            source: function( request, response ) {
              $.ajax({
                url: "{{ path('dependencia_autocompletar') }}",
                dataType: "json",
                data: {
                  term: request.term
                },
                success: function( data ) {
                  response(data);
                }
              });
            },
            minLength: 3,
            select: function( event, ui ) {
          	  $("#txtIdDependencia").val(ui.item.id);
      		  $("#txtDependencia").val(ui.item.nombre);
            },
            open: function() {
              $( this ).removeClass( "ui-corner-all" ).addClass( "ui-corner-top" );
            },
            close: function() {
              $( this ).removeClass( "ui-corner-top" ).addClass( "ui-corner-all" );
            },
            messages: {
                noResults: 'No se encontr\u00F3 ning\u00FAn resultado.',
                results: function(amount) {
                    return 'Se encontraron ' + amount + ' resultados. Use las teclas arriba y abajo para navegar.'
                }
            }
         });
	     
	});

</script>
{% endblock %}
