{% extends 'GESTIONGestionBundle::base.html.twig' %}

{% block body -%}
	<div class="row text-center">
		<h1>Show Proceso</h1>
	</div>
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<b>Datos del proceso</b>
				<div _ngcontent-ktt-12="" class="pull-right">
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="javascript:window.history.back()">
		                Volver
		            </a>
                 </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">  	                   	
                   		<div class="col-md-6" >
                   			<label>Id: </label>
			                <div class="alert alert-primary" role="alert">{{ entity.id }}</div>
			            </div>
			            <div class="col-md-6" >
			            	<label>Proceso Tipo: </label>
			                <div class="alert alert-primary" role="alert">{{ entity.nombre|default('Sin datos') }}</div>
			            </div>
			            <div class="col-md-6" >
			            	<label>Fecha Inicio: </label>
			                <div class="alert alert-primary" role="alert">{{ entity.fechaIni != null ? entity.fechaIni|date('d-m-Y H:i:s') : 'Sin datos' }}</div>
			            </div>
			            <div class="col-md-6" >
			            	<label>Fecha Fin: </label>
			                <div class="alert alert-primary" role="alert">{{ entity.fechaFin != null ? entity.fechaFin|date('d-m-Y H:i:s') : 'Sin datos' }}</div>
			            </div>
			            <div class="col-md-12" >
			            	<label>Resultado: </label>
			                <div class="alert alert-primary" role="alert">{{ entity.resultado|default('Sin datos')|raw }}</div>
			            </div>							         
					</div>
				</div>
			</div>
			<div class="panel-footer">
	            <div class="container">
	                <a class="btn btn-default pull-right" style="margin-right: 1em" href="javascript:window.history.back()">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
	</script>
{% endblock %}
