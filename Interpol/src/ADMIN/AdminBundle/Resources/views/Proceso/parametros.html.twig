{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<form id="frm" method="POST" action="{{ path('admin_proceso_parametros') }}">
	<div class="container" width="100%">
		<div class="row text-center">
			<h1>Interpol - Parametros</strong></h1>
		</div>
		<div id="panelconsulta" class="col-xs-12 col-md-12"
			style="margin-bottom: 2%;">
			<div class="panel panel-success">
				<div class="panel-heading">
					<b>BUSCADOR</b> <i class="fa fa-search"></i>
				</div>
				<div class="panel-body">
				    <input type="hidden" id="accion" name="accion" value="{{app.request.get( "accion")}}" class="form-control">
					<input type="hidden" id="busqueda" name="busqueda" value="{{app.request.get( 'busqueda')}}" class="form-control">
					<div class="row" style="margin-bottom:5px;">
						<div class="col-sm-4 mb-3">
							<label>Nombre</label> <input type="text" id="txtNombre"
								name="txtNombre" value="{{app.request.get( 'txtNombre')}}"
								class="form-control">
						</div>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-success col-xs-12" data-toggle="tooltip"
							id="consultar" title="" type="button" data-placement="bottom"
							data-original-title="Consultar">
							<div class="hidden-xs hidden-sm">Consultar</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-search" aria-hidden="true"></i>
							</div>
						</button>
						<button id="sendForm" type="submit" class="hide"></button>
					</div>
					<div class="row col-sm-4 col-md-4">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-default col-xs-12" data-toggle="tooltip"
							title="" id="limpiar" type="button" onclik="limpiarForm"
							data-placement="bottom"
							data-original-title="Limpiar Parámetros de Búsqueda">
							<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-undo" aria-hidden="true"></i>
							</div>
						</button>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-1. col-md-12">
						<table id="tablaProceso" class="table-bordered table-striped mb-0">
                            <thead>
                                <tr style='text-align:center' bgcolor="#e9e9e9">
                                	<th style='text-align:center'>Id</th>
					                <th style='text-align:center'>Nombre</th>
					                <th style='text-align:center'>Valor Numpérico</th>
					                <th style='text-align:center'>Valor Char</th>
					                <th style='text-align:center'>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for entity in entities %}
                                	<tr>
                                    	<td style='text-align:center'>{{ entity.parametroid }}</td>
                                    	<td style='text-align:center'>{{ entity.nombre }}</td>
                                        <td style='text-align:center'>{{ entity.valornum }}</td>
                                        <td style='text-align:center'>{{ entity.valorchar }}</td>
                                        <td style='text-align:center'>	
                                        	<a class="btn btn-info res " title="Ver M&aacute;s" data-toggle="modal" onClick="mostrarDetalle( '{{ entity.parametroid }}', '{{ entity.nombre }}', '{{ entity.valornum }}', '{{ entity.valorchar }}' );">
                                            	<i class="far fa-edit"> Editar</i>
                                        	</a>
                                        </td>	
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>                        
					</div>
				</div>
			</div>
		</div>
		
		    <div class="modal" id="popupEdit" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    			<div class="modal-dialog" role="document">
    				<div class="modal-content">
    					<div class="modal-header modal-header-info">
    						<h5 class="modal-title text-center" id="exampleModalLabel"><strong>Modificación de parámetro</strong></h5>
    					</div>
    					<div class="modal-body text-left" id="dvDatos">
                			<div class="panel panel-default">
                				<div class="panel-body">
                					<div id="dvTable" class="col-sm-12">
                                           <div class="list-group">
                                               <div class="modal-header modal-header-info">
						    						Información de consulta
						    					</div>
						    					<input type="hidden" id="txtId" name="txtId" name="txtId">
                                               <a class="col-sm-6 list-group-item list-group-item-info">Id Parametro:</a>
                                               <a class="col-sm-6 list-group-item" id="dvIdParam"></a>
                                               <a class="col-sm-6 list-group-item list-group-item-info">Nombre Parametro:</a>
                                               <a class="col-sm-6 list-group-item" id="dvNombre"></a>
                                               <a class="col-sm-6 list-group-item list-group-item-info " style="padding-bottom: 23px;">Valor numérico</a>
                                               <a class="col-sm-6 list-group-item" id="aFechaConsulta"><input type="text" id="txtValor" name="txtValor" value="" class="form-control"></a>
                                               <a class="col-sm-6 list-group-item list-group-item-info " style="padding-bottom: 23px;">Valor Char</a>
                                               <a class="col-sm-6 list-group-item" id="aFechaConsulta"><input type="text" id="txtValorChar" name="txtValorChar" value="" class="form-control"></a>                                        
                                           </div>
                					</div>
                                </div>
                            </div>
    					</div>
    					<div class="modal-footer">
    					    <div class="col col-sm-4 text-left"><img id="imgCargando" width="25px" src="{{asset('bundles/pfa/img/loading.gif')}}" /></div>
    					    <button type="button" class="btn btn-success res" id="btnActualizar" onClick="execActualizarParametro();">Actualizar</button>
    						<button type="button" class="btn btn-danger res" data-dismiss="modal">Cerrar</button>
    					</div>
    				</div>
    			</div>
    		</div>
		
		
	</div>
</form>

<script>
	$(document).ready(function () {
        $("#imgCargando").hide();
		if ($(window).width() < 600) {
			$("#panelconsulta").attr("style","margin-bottom:2%;");
		}else{
			$("#panelconsulta").attr("style","margin-left:0%;margin-bottom:2%;");
		}
		
		
		$("#consultar").click(function(){
			$("#accion").val("busqueda");
			$("#frm").attr('action',"{{ path('admin_proceso_parametros') }}");
			$("#sendForm").click();
		});

		{% if app.request.get( "busqueda")=='SI' or app.request.get( "page")!='' %}
			$(window).scrollTop($('#panelconsulta').offset().top);
		{% endif %}
		
		$('#limpiar').click(function () {
		    $("#txtNombre").val("");
		    $("#txtFechaDesde").val("");
		    $("#txtFechaHasta").val("");
		});
		
	    $('.pagination a').attr('class', 'btn btn-default');
        $('.pagination li').css('float', 'left');
        $('.pagination .active span').attr('class', 'btn btn-info');
        $('.pagination .prev span').attr('class', 'btn btn-default disabled');
        $('.pagination .next span').attr('class', 'btn btn-default disabled');
		
        $('#tablaProceso').DataTable({
        	"scrollY": "600px",
        	"scrollX": true,
            "filter": true,
            "paging": false,
            "info": false,
            "order": [[ 0, 'desc' ]],
            "scrollCollapse": true,
            "responsive": true,	
            "oLanguage": {
				"sSearch": 		   "Buscar en registros visibles:",
				"sEmptyTable": 	   '<div class="alert alert-seccondary"><i class="fa fa-info-circle" style="font-size: 20px"></i> <span style="font-size: 20px;"> No se encontraron resultados con los parámetros de búsqueda ingresados.</span></div>',			
				"sProcessing":     "Procesando...",
				"sLengthMenu":     "Mostrar _MENU_ registros",
				"sZeroRecords":    "No se encontraron resultados",
				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
				"sInfoFiltered":   "",
				"sInfoPostFix":    "",
				"sUrl":            "",
				"sInfoThousands":  ",",
				"sLoadingRecords": "Cargando...",
				"columnDefs": [ {
	            	"targets": 5,
	            	"orderable": false
	            	} ]
			}
        });
	});
	
    function mostrarDetalle( pId, pNombre, pValor, pValorChar){
		$("#dvIdParam").html(pId);
		$("#txtId").val(pId);
      	$("#dvNombre").html(pNombre);
      	$("#txtValor").val(pValor);
      	$("#txtValorChar").val(pValorChar);
      	$("#popupEdit").modal('show');
    }
    
    function execActualizarParametro( ){
		var sRetorno = actualizarParametro();
		alert(sRetorno);
    }
    
    function actualizarParametro( ){
     	console.log("ActualizarParametro");
     	$("#btnActualizar").attr("disabled", true);
     	$("#imgCargando").show();
     	
     	var pId = $("#txtId").val();
		var pValor = $("#txtValor").val();
		var pValorChar = $("#txtValorChar").val();
     	var sData = "{'id':'"+pId+"','valor':'"+pValor+"','valorchar':'"+pValorChar+"'}";
     	var oData = JSON.stringify(sData);
     	//console.log(oData);
     	
        var sRet = "";
        var sPath = '{{ path ( 'admin_proceso_parametros_update' ) }}';
 		$.ajax({
         	url:        sPath,  
             type:       'GET',
             dataType:   'json',
             async:      false,
             data:       {
             id:pId,
             valor:pValor,
             valorchar:pValorChar
             },
             success: function(data, status) {
		     oData = ( data );
		     $("#btnActualizar").attr("disabled", false);
		     $("#imgCargando").hide();
                 if( oData.estado == "ERROR" ){
                 	sRet = "Error al intentar modificar el parámetro.";
                 }else{
                 	sRet = "Parámetro modificado correctamente.";
                 	}
              	},
              error : function(xhr, textStatus, errorThrown) {  
             	 sRet = 'Error al ejecutar la consulta Ajax. ' + textStatus;
             	 $("#imgCargando").hide();
			     $("#btnActualizar").attr("disabled", false);
              }  
           });
          return sRet;
 	}
	
	
</script>
{% endblock %}