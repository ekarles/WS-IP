{% extends 'GESTIONGestionBundle::base.html.twig' %} {% block body -%}
<form id="frm" method="POST" action="{{ path('lotesprocesados') }}">
	<div class="container" width="100%">
		<div id="panelconsulta" class="col-xs-12 col-md-12"
			style="margin-bottom: 2%;">
			
			
			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
					<div class="container" width="100%">
			    		<div class="row">
			    		<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
				    	</div>
						<div class="row">
							<div>&nbsp;</div>
						</div>
						<div class="row form-inline">
							<span style="color:#00457D; font-size:24px;">Interpol - Lotes Procesados</span>
		    			</div>
					</div>
				</div>
			</div>

			
			<div class="panel panel-default">
				<div class="panel-body">
					<input type="hidden" id="idConsultaLote" name="idConsultaLote" value="" class="form-control">
					{% if 'ROLE_ADMIN' in app.user.roles or 'ROLE_SUPER_ADMIN' in app.user.roles %}
					<div class="col-sm-4">
						<label>Usuario</label> <input type="text" id="txtUsuario"
							name="txtUsuario" value="{{app.request.get( "txtUsuario")}}"
							class="form-control">
					</div>
					<div class="col-sm-4">
						<label>Fecha desde</label> <input type="date" id="txtFechaDesde"
							name="txtFechaDesde" value="{{app.request.get( "txtFechaDesde")}}" 
							class="form-control">
					</div>
					<div class="col-sm-4">
						<label>Fecha hasta</label> <input type="date" id="txtFechaHasta"
							name="txtFechaHasta" value="{{app.request.get( "txtFechaHasta")}}" 
							class="form-control">
					</div>
					{% else %}
					<div class="hidden">
						<label>Usuario</label> <input type="hidden" id="txtUsuario"
							name="txtUsuario" value="{{app.user}}"
							class="form-control">
					</div>
					<div class="col-sm-6">
						<label>Fecha desde</label> <input type="date" id="txtFechaDesde"
							name="txtFechaDesde" value="{{app.request.get( "txtFechaDesde")}}" 
							class="form-control">
					</div>
					<div class="col-sm-6">
						<label>Fecha hasta</label> <input type="date" id="txtFechaHasta"
							name="txtFechaHasta" value="{{app.request.get( "txtFechaHasta")}}" 
							class="form-control">
					</div>
					{% endif %}
					<div class="col-sm-6">
						<label>Tipo consulta</label> <select id="lstTipoCons"
							name="lstTipoCons" class="selectpicker">
							<option value="" selected>Seleccione el tipo de consulta</option>
							<option value="P">Personas</option>
							<option value="D">Documentos</option>
							<option value="V">Vehículos</option>
						</select>
					</div>
					<div class="col-sm-6">
						<label>Resultado proceso</label> <select id="lstResult"
							name="lstResult" class="selectpicker">
							<option value="" selected>Seleccione el resultado</option>
							<option value="F">Finalizado</option>
							<option value="I">Incompleto</option>
							<option value="E">Finalizado con Errores</option>
						</select>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-success col-xs-12" data-toggle="tooltip"
							id="consultar" title="" type="button" data-placement="bottom"
							data-original-title="Consultar">
							<div class="hidden-xs hidden-sm">Consultar</div>
							<div class="hidden-md hidden-lg" style="margin-bottom:2px;">
								<i class="fa fa-search" aria-hidden="true"></i>
							</div>
						</button>
						<button id="sendForm" type="submit" class="hide"></button>
					</div>
					<div class="col-sm-4 col-md-4">
						<a class="btn btn-primary col-xs-12" data-toggle="tooltip"
							title="" id="nuevo" href="{{path('lote')}}"
							data-placement="bottom"
							data-original-title="Cargar Nuevo Lote">
							<div class="hidden-xs hidden-sm">Cargar Nuevo Lote</div>
							<div class="hidden-md hidden-lg" style="margin-bottom:2px;">
								<i class="fa fa-upload" aria-hidden="true"></i>
								<br>
							</div>
						</a>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-default col-xs-12" data-toggle="tooltip"
							title="" id="limpiar" type="button" onclik="limpiarForm"
							data-placement="bottom"
							data-original-title="Limpiar Parámetros de Búsqueda">
							<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
							<div class="hidden-md hidden-lg" style="margin-bottom:2px;">
								<i class="fa fa-undo" aria-hidden="true"></i>
							</div>
						</button>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-12 col-md-12">
                        <table id="tablaLotes" class="table-bordered table-striped mb-0">
                            <thead>
                                <tr style='text-align:center' bgcolor="#e9e9e9">
                                	<th style='text-align:center'>Acción</th>
                                	<th style='text-align:center'>Nro.</th>
                                    <th style='text-align:center'>Usuario</th>
                                    <th style='text-align:center'>Fecha Alta</th>
                                    <th style='text-align:center'>Tipo Consulta</th>
                                    <th style='text-align:center'>Archivo</th>
                                    <th style='text-align:center'>Estado</th>
                                    <th style='text-align:center'>Registros</th>
                                    <th style='text-align:center'>Errores</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for lote in lotesprocesados %}
                                    <tr>
                                    	<td align="center">
                                    		<div class="row form-inline">
	                                        	<a class="btn btn-info res" title="Ver Detalle" data-toggle="modal" onClick="mostrarDetalle( '{{ lote.consultaLote.id }}' );">
	                                            <i class="fa fa-search"></i>
	                                        	</a>
	                                        	<a class="btn btn-info res" title="Descargar Archivo" data-toggle="modal" href=" {{ path('lotesprocesados_descargar', { 'idConsultaLote': lote.consultaLote.id } ) }}" target="_blank">
	                                            <i class="fa fa-download"></i>
	                                        	</a>
                                        	</div>                                        	
                                        </td>
                                        <td align="center">{{ lote.consultaLote.id }}</td>
                                        <td align="center">{{ lote.consultaLote.usuario }}</td>
                                        <td align="center">{{ lote.consultaLote.fecAlta | date('d-m-Y H:i:s') }}</td>
                                        <td align="center">{{ lote.consultaLote.tipoLote | replace({'P':'Personas','D':'Documentos','V':'Vehículos'}) }}</td>
                                        <td align="center">{{ lote.consultaLote.archivoNombre }}</td>
                                        <td align="center">{{ lote.consultaLote.estado| replace({'I':'Incompleto','F':'Finalizado'}) }}</td>
                                        <td align="center">{{ lote.cantDetalle }}</td>
                                        <td align="center">{{ lote.consultaLote.error }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <div class="row-fluid" align="center">        
		                    {{ pagerfanta (lotesprocesados,'twitter_bootstrap_translated', { 'prev_message' : 'Anterior', 'next_message': 'Siguiente',"routeParams": {'txtUsuario': app.request.get( "txtUsuario"),'txtFechaDesde': app.request.get( "txtFechaDesde"),'txtFechaHasta': app.request.get( "txtFechaHasta"),'lstTipoCons': app.request.get( "lstTipoCons"),'lstResult': app.request.get( "lstResult")}} ) }}
		                </div>                        
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
<script>
	$(document).ready(function () {
		$('.animationload').fadeOut('slow');
		
		if ($(window).width() < 600) {
			$("#panelconsulta").attr("style","margin-bottom:2%;");
		}else{
			$("#panelconsulta").attr("style","margin-left:0%;margin-bottom:2%;");
		}

		$("#consultar").click(function(){
			$("#frm").attr('action',"{{ path('lotesprocesados') }}");
			$("#frm").submit();
		});

				
		$("#lstTipoCons").val("{{app.request.get( "lstTipoCons")}}").selectpicker('refresh');
	    $("#lstResult").val("{{app.request.get( "lstResult")}}").selectpicker('refresh');
		
		$('#limpiar').click(function () {
		    $("#txtUsuario").val("");
		    $("#txtFechaDesde").val("");
		    $("#txtFechaHasta").val("");
		    $("#lstTipoCons").val("").selectpicker('refresh');
		    $("#lstResult").val("").selectpicker('refresh');
		});

	    $('.pagination a').attr('class', 'btn btn-default');
        $('.pagination li').css('float', 'left');
        $('.pagination .active span').attr('class', 'btn btn-info');
        $('.pagination .prev span').attr('class', 'btn btn-default disabled');
        $('.pagination .next span').attr('class', 'btn btn-default disabled');

        $('#tablaLotes').DataTable({
        	"scrollX": true,
            "filter": false,
            "paging": false,
            "info": false,             
            "scrollCollapse": true,
            "responsive": true,
            "columnDefs": [ {
            	"targets": 0,
            	"orderable": false,
            	"order": []
            	} ],
            "order": [[1, 'desc']],	
            "oLanguage": {
				"sSearch": 		   "Buscar:",
				"sEmptyTable": 	   "No se encontraron registros.",			
				"sProcessing":     "Procesando...",
				"sLengthMenu":     "Mostrar _MENU_ registros",
				"sZeroRecords":    "No se encontraron resultados",
				"sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
				"sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
				"sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
				"sInfoPostFix":    "",
				"sSearch":         "Buscar:",
				"sUrl":            "",
				"sInfoThousands":  ",",
				"sLoadingRecords": "Cargando..."
			}
        });
	     
	});


	function mostrarDetalle( idConsultaLote ){
		$('.animationload').fadeIn();
		$("#idConsultaLote").val(idConsultaLote);
		$("#frm").attr('action',"{{path('lotesprocesados_show')}}");
		$("#frm").submit();
	}


</script>
{% endblock %}
