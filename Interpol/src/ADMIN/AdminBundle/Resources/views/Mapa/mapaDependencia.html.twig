{% extends 'GESTIONGestionBundle::base.html.twig' %} 
{% block body -%}
	<div class="row text-center">
		<h1>Dependencias del mapa <strong>{{entity}}</strong></h1>
	</div>
	{{ form_start(edit_form) }}
	
			<div id="panelconsulta" class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
			<div class="panel panel-success">
				<div class="panel-heading">
					<b>BUSCADOR</b> <i class="fa fa-search"></i>
				</div>
				<div class="panel-body">
				    <input type="hidden" id="accion" name="accion" value="{{app.request.get( "accion")}}" class="form-control">
					<div class="row" style="margin-bottom:5px;">
						<div class="col-sm-4 mb-3">
							<label>Dependencia</label> <input type="text" id="txtDescripcion"
								name="txtDescripcion" value="{{app.request.get( 'txtDescripcion')}}"
								class="form-control">
						</div>
					</div>
					<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-info col-xs-12" data-toggle="tooltip"
							id="consultar" title="" type="button" data-placement="bottom"
							data-original-title="Consultar">
							<div class="hidden-xs hidden-sm">Consultar</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-search" aria-hidden="true"></i>
							</div>
						</button>
						<button id="sendForm" type="submit" class="hide"></button>
					</div>
					<div class="row col-sm-4 col-md-4">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
					<div class="col-sm-4 col-md-4">
						<button class="btn btn-default col-xs-12" data-toggle="tooltip"
							title="" id="limpiar" type="button" onclik="limpiarForm"
							data-placement="bottom"
							data-original-title="Limpiar Parámetros de Búsqueda">
							<div class="hidden-xs hidden-sm">Limpiar Búsqueda</div>
							<div class="hidden-md hidden-lg">
								<i class="fa fa-undo" aria-hidden="true"></i>
							</div>
						</button>
					</div>
				</div>
			</div>

					<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
						<div class="panel panel-primary">
							<div class="panel-heading">
								<div class="container">
									<button type="submit" class="btn btn-success pull-right">Guardar</button>
									<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_mapa') }}">
						                Volver
						            </a>
					            </div>
							</div>
							
							<div class="panel-body">
								<div>			
				                {{ form_widget(edit_form.dependencias)}}
				                </div>
							</div>
							
							<div class="panel-footer">
					            <div class="container">
					                <button type="submit" class="btn btn-success pull-right">Guardar</button>
									<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_mapa') }}">
						                Volver
						            </a>
					            </div>
					        </div>
						</div>
					</div>
					
				</div>
	{{ form_end(edit_form) }}
	<script>
		$(document).ready(function(){
			$("#accion").val("");
			$("form :input[type='checkbox']").each(function(){
				$(this).wrap('<ul class="list-group"><div class="col-md-6"><li class="list-group-item"><div class="nombre"><div class="squaredFour" style="text-align:center;"></div></li></div></ul>').after($("label[for='"+$(this).attr("id")+"']"));
			});
			
			$("label").css('margin-top','20px');
			
			var altura = 0;
			
			$(".squaredFour").each(function(){
				if($(this).height() > altura){
					altura = $(this).height();
				}
			});
			
			$(".squaredFour").css('height',altura+'px');
			
			$("#consultar").click(function(){
				$("#accion").val("busqueda");
				
				$("#frm").attr('action',"{{ path('admin_mapa_mapaDependencia', {'id':entity.id} ) }}");
				$("#sendForm").click();
			});
		});
	</script>

{% endblock %}
