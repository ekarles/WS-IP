{% extends 'GESTIONGestionBundle::base.html.twig' %} 
{% block body -%}
	<div class="row text-center">
		<h1>Editar mapas</h1>
	</div>
	{{ form_start(edit_form) }}
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<div class="container">
					<button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_mapa') }}">
		                Volver
		            </a>
	            </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.descripcion) }}
		                    {{ form_widget(edit_form.descripcion) }}
		                    {{ form_errors(edit_form.descripcion) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.latitud) }}
		                    {{ form_widget(edit_form.latitud) }}
		                    {{ form_errors(edit_form.latitud) }}
		                </div>
		            </div>
                   	<div class="row">
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.longitud) }}
		                    {{ form_widget(edit_form.longitud) }}
		                    {{ form_errors(edit_form.longitud) }}
		                </div>
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.nombre) }}
		                    {{ form_widget(edit_form.nombre) }}
		                    {{ form_errors(edit_form.nombre) }}
		                </div>
		            </div>
                   	<div class="row">
                   		<div class="col-md-6">
		                    {{ form_label(edit_form.zoom) }}
		                    {{ form_widget(edit_form.zoom) }}
		                    {{ form_errors(edit_form.zoom) }}
		                </div>
                   		<div class="col-md-6">
		                    
		                </div>
		            </div>
		            <br>        
				</div>
			</div>
			<div class="panel-footer">
	            <div class="container">
	                <button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_mapa') }}">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
	</script>
	{{ form_end(edit_form) }}
{% endblock %}
