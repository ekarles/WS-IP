{% extends 'GESTIONGestionBundle::base.html.twig' %} 
{% block body -%}
	<div class="row text-center">
		<h1>Nuevo mapa</h1>
	</div>
	{{ form_start(form) }}
	<div class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
		<div class="panel panel-primary">
			<div class="panel-heading">
				<div class="container">
					<button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_mapa') }}">
		                Volver
		            </a>
	            </div>
			</div>
			<div class="panel-body">
				<div class="col-sm-12 col-md-12">
                   	<div class="row">
			            <div class="col-md-6">
			                {{ form_label(form.descripcion) }}
		                    {{ form_widget(form.descripcion) }}
		                    {{ form_errors(form.descripcion) }}
			            </div>
			            <div class="col-md-6">
			                {{ form_label(form.latitud) }}
		                    {{ form_widget(form.latitud) }}
		                    {{ form_errors(form.latitud) }}
			            </div>
			        </div>
			        <div class="row">
			            <div class="col-md-6">
			            	{{ form_label(form.longitud) }}
		                    {{ form_widget(form.longitud) }}
		                    {{ form_errors(form.longitud) }}
			            </div>
			            <div class="col-md-6">
			            	{{ form_label(form.nombre) }}
		                    {{ form_widget(form.nombre) }}
		                    {{ form_errors(form.nombre) }}
			            </div>
			         </div>
			         <div class="row">
			            <div class="col-md-6">
			            	{{ form_label(form.zoom) }}
		                    {{ form_widget(form.zoom) }}
		                    {{ form_errors(form.zoom) }}
			            </div>
					</div>
				</div>
		</div>
			<div class="panel-footer">
	            <div class="container">
	                <button type="submit" class="btn btn-success pull-right">Guardar</button>
					<a class="btn btn-default pull-right" style="margin-right: 1em" href="{{ path('admin_mapa') }}">
		                Volver
		            </a>
	            </div>
	        </div>
		</div>
	</div>
	<script>
	</script>
	{{ form_end(form) }}

{% endblock %}
