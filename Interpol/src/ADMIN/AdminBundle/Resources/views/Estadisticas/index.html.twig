{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow-y: auto;
    }

    .iframe-container {
        width: 100%;
        height: 100vh;
    }

    .iframe-container iframe {
        width: 100%;
        height: 100%;
        border: none;
        overflow-y: auto;
    }
</style>

<div class="iframe-container">
    <iframe
    	id="contentIframe"
        src="{{ externalPath }}"
        loading="lazy"
        frameborder="0">
    </iframe>
</div>

<script>

	const iframe = document.getElementById('contentIframe');

	$(document).ready(function () {
		$('#cerrarMenu').click();
	});

    document.addEventListener('DOMContentLoaded', function() {
        iframe.onload = function() {
            ajusteIframe();
        };
    });

    window.addEventListener('message', e => {
        if (e.data.type === 'resize') {
            ajusteIframe();
        }
	});

	function ajusteIframe() {
		
		try {
            const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
            const iframeWindow = iframe.contentWindow;

            if (iframeDoc && iframeWindow) {
                // Permitir scroll en el contenido del iframe
                iframeDoc.body.style.margin = '0';
                iframeDoc.body.style.padding = '0';
                iframeDoc.body.style.overflow = 'auto';
                iframeDoc.documentElement.style.overflow = 'auto';

                // Ajustar altura dinámicamente según contenido
                function adjustIframeHeight() {
                    const contentHeight = iframeDoc.documentElement.scrollHeight;
                    iframe.style.height = contentHeight + 'px';
                }

                adjustIframeHeight();
                iframeDoc.addEventListener('load', adjustIframeHeight);
                window.addEventListener('resize', adjustIframeHeight);

                // Monitorear cambios de ruta en el iframe
                iframeWindow.addEventListener('popstate', function() {
                    console.log('Ruta actual del iframe:', iframeWindow.location.href);

					if(iframeWindow.location.href.indexOf('/interpol/web/login')!== -1){
						window.location.href = "{{ path('_homepage') }}";
					}
                    
                });

                // Interceptar cambios de historial
                const originalPushState = iframeWindow.history.pushState;
                iframeWindow.history.pushState = function(...args) {
                    console.log('Ruta actual del iframe:', iframeWindow.location.href);
                    return originalPushState.apply(this, args);
                };

                // Log inicial
                console.log('Ruta inicial del iframe:', iframeWindow.location.href);
            }
        } catch (e) {
            console.warn('No se puede acceder al contenido del iframe (CORS)', e);
        }
    }
    
</script>

{% endblock %}
