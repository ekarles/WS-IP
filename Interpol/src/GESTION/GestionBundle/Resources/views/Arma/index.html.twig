{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
{% set PermisoDetalle = app.session %}
<form method="POST" id="frm" action="{{ path('arma_show') }}">
		<div id="panelconsulta" class="col-xs-12 col-md-6">
			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
					<div class="container" width="100%">
			    		<div class="row text-cemter">
			    		<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
				    	</div>
						<div class="row">
							<div>&nbsp;</div>
						</div>
						<div class="row">
							<div><p style="color:#00457D; font-size:24px;">Interpol - Armas</p></div>
						</div>
					</div>
				</div>
			</div>
			<div class="panel panel-default">
				<div class="panel-body">
       	        	<div class="col-sm-6 col-md-6" >
						<div class="form-group">
           	        		<label>Número de Serie</label>
           	        		<input type="text" id="txtSN" name="txtSN" value="" required="required" placeholder="Ingrese Nro. de serie de arma"/>
           	        	</div>
           	        </div>
       	        	<div class="col-sm-6 col-md-6" >
   						<div class="form-group">
           	        		<label>Marca</label>
                               <input type="text" id="txtMarca" name="txtMarca" placeholder="Ingrese marca de arma" value=""/>
           	        	</div>
       	        	</div>
       	        	<div class="col-sm-6 col-md-6" >
   						<div class="form-group">
           	        		<label>Modelo</label>
                               <input type="text" id="txtModelo" name="txtModelo" placeholder="Ingrese modelo de arma" value=""/>
           	        	</div>
       	        	</div>
       	        	<div class="col-sm-6 col-md-6" >
   						<div class="form-group">
           	        		<label>Calibre</label>
           	        		<input type="text" id="txtCalibre" name="txtCalibre" placeholder="Ingrese calibre de arma" value="" />
           	            </div>
       	        	</div>
       	        	<div class="col-sm-6 col-md-6" >
   						<div class="form-group">
           	        		<label>Fabricante</label>
           	        		<input type="text" id="txtFabricante" name="txtFabricante" placeholder="Ingrese fabricante de arma" value="" />
           	            </div>
       	        	</div>
       	        	<div class="col-sm-6 col-md-6" >
   						<div class="form-group">
           	        		<label>Tipo</label>
           	                <select id="txtTipo" name="txtTipo" required="required" class="selectpicker">
           	                  <option value="1" selected>Seleccione el tipo de arma</option>
           	                  <option value="1" >1 - Commercial Version</option>
           	                  <option value="2" >2 - Combination Gun</option>
           	                  <option value="3" >3 - Handgun</option>
           	                  <option value="4" >4 - Machine Gun</option>
           	                  <option value="5" >5 - Rifle</option>
           	                  <option value="6" >6 - Shotgun</option>
           	                  <option value="7" >7 - Submachine Gun</option>
           	                  <option value="8" >8 - Other</option>
           	                  <option value="9" >9 - Cannon</option>
           	                  <option value="10" >10 - Grenade Launcher</option>
           	                  <option value="11" >11 - Mortar</option>
           	                  <option value="12" >12 - Airsoft</option>
           	                </select>
           	            </div>
       	        	</div>
       	        	<div class="col-sm-6 col-md-6" >
   						<div class="form-group">
           	        		<label>Fecha desde</label>
           	        		<input type="date" id="dtfechaDesde" name="dtfechaDesde" value="{{ app.request.get('dtfechaDesde') }}" class="form-control">
           	            </div>
       	        	</div>
       	        	<div class="col-sm-6 col-md-6" >
   						<div class="form-group">
           	        		<label>Fecha hasta</label>
           	        		<input type="date" id="dtFechaHasta" name="dtFechaHasta" value="{{ app.request.get('dtFechaHasta') }}" class="form-control">
           	            </div>
       	        	</div>
            	</div>
                <div class="col-xs-12" align="center">
                	<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
    				<div class="col-sm-6 col-md-6">
    					<button class="btn btn-success col-xs-12" data-toggle="tooltip" id="consultar" title="Consultar" type="submit" data-placement="bottom">
    						<div class="hidden-xs hidden-sm">Consultar</div>
    						<div class="hidden-md hidden-lg">
    							<i class="fa fa-search" aria-hidden="true"></i>
    						</div>
    					</button>
    					<button id="sendForm" type="submit" class="hide"></button>
    				</div>
    				<div class="col-sm-6 col-md-6">
    					<button class="btn btn-default col-xs-12" data-toggle="tooltip" title="Limpiar Par&aacute;metros de B&uacute;squeda" id="limpiar" type="button" onclik="limpiarForm" data-placement="bottom">
    						<div class="hidden-xs hidden-sm">Limpiar B&uacute;squeda</div>
    						<div class="hidden-md hidden-lg">
    							<i class="fa fa-undo" aria-hidden="true"></i>
    						</div>
    					</button>
    				</div>
    			</div>
    		</div>
        </div>
    </div>    
</form>
    <script>
        $(document).ready(function () {
    		if ($(window).width() < 600) {
    			$("#panelconsulta").attr("style","margin-bottom:2%;");
    	    }else{
    	    	$("#panelconsulta").attr("style","margin-left:25%;margin-bottom:2%;");
    	    }	//	if ($(window).width() < 600) {
    	    
        });
        
        $(window).on('load', function(event) {
        
        	console.log($("#txtCalibre").val());
        
        	if($("#txtCalibre").val()!="BC"){
        		//document.getElementById("txtNombre").required = false;
            	//document.getElementById("txtModelo").required = false;
        	}else{
        		//document.getElementById("txtNombre").required = true;
                //document.getElementById("txtModelo").required = true;
        	}
        });
        
       	$('#limpiar').click(function () {
            //$("#txtNombre").val("");
            $("#txtSN").val("");
            $("#txtModelo").val("");
            $("#txtCalibre").val("BC").selectpicker('refresh');
        });	//	$('#limpiar').click(function () {

        $('#consultar').click(function () {
        
        
        });
        
    </script>
    {% endblock %}
