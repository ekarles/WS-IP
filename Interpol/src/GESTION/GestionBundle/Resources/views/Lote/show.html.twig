{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<form method="POST" action="{{ path('persona_showdetails') }}">
	<div class="container" width="100%">
		<div class="row text-center">
		<h1>Interpol - Consulta por Lote</h1>
	</div>
	<div class="row">
		<div>&nbsp;</div>
		<div>&nbsp;</div>
		<input id="idConsultaLote" name="idConsultaLote" type="hidden" value="{{consultaLote.id}}"/>
		<input id="idConsultaLoteDetalle" name="idConsultaLoteDetalle" type="hidden" value=""/>
	</div>
	<div class="row">
		<div class="progress progress-striped active">
		  <div id="barraProgreso" class="progress-bar" role="progressbar"
		       aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
		       style="width: 0%">
		    <span id="textProgreso">0% completado</span>
		  </div>
		</div>
	<div class="row">
	
	
	<div id="panelconsulta" class="col-xs-12" style="margin-bottom:2%;">
	<div class="panel panel-default">
	
    <div class="panel-heading">
	    <a onclick="window.history.back();" role="button" id="btnVolver" name="btnVolver" _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
      	<a role="button" id="btnProcesar" name="btnProcesar" _ngcontent-soi-7="" class="btn btn-warning pull-right" title="Iniciar proceso">Procesar</a>
      
      <h4 _ngcontent-xyt-6="">Se han obtenido <strong>{{ loteDetalles|length }}</strong> registros de <strong>{{ consultaLote.tipoLote == 'P' ? 'PERSONAS' : consultaLote.tipoLote == 'D' ? 'DOCUMENTOS' : 'VEH&Iacute;CULOS'}}</strong></h4>
    </div>	
	<div class="panel-body">
	
		<div class="col-sm-12 col-md-12" >
		<div class="form-group">
	
        <table class="display" id="tablaLote">
            <thead>
                <tr>
                	<th>Resultado Detalle</th>	
                	<th>Resultado</th>
                	{% if consultaLote.tipoLote == 'P' %}
                	<th class="text-left">Apellido</th>
                    <th class="text-left">Nombre</th>                          
                    <th class="text-left">Fecha Nacimiento</th>
                    {% endif %}
					
					{% if consultaLote.tipoLote == 'D' %}
                    <th class="text-left">Nro. Documento</th>      
                    <th class="text-left">Tipo Documento</th>
                    <th class="text-left">Pa&iacute;s</th>
                    {% endif %}
                                        
					{% if consultaLote.tipoLote == 'V' %}
                    <th class="text-left">Vin</th>      
                    <th class="text-left">Dominio</th>
                    <th class="text-left">Nro. Motor</th>
                    {% endif %}                                         
                </tr>
            </thead>
            <tbody>
                {% for detalle in loteDetalles %}
                    <tr>
                    	<td id="res{{detalle.id}}">
                    		{% if detalle.resultCode == 'NO_ANSWER' %}
                            	Sin resultados
                            	{% set cont = cont + 1 %}  
                            {% elseif detalle.resultCode == 'NO_ERROR' %}
                            	Información disponible!
                            	{% set cont = cont + 1 %} 
                            {% elseif detalle.resultCode == '' %}
                            	Error
                            {% endif %}
                    	</td>
                    	<td>
                            <div id="detalle{{detalle.id}}" style="display:none">{{detalle.id}}</div>                                               
                            {% if detalle.resultCode == 'NO_ANSWER' %}
                            	<a id="btnRes{{detalle.id}}" class="btn btn-success res" title="Sin resultados" onClick="#" disabled>
                            		<i class="fa fa-check-circle"></i>  
                            {% elseif detalle.resultCode == 'NO_ERROR' %}
                            	<a id="btnRes{{detalle.id}}" class="btn btn-danger res" title="Información disponible!" onClick="verResultado('{{detalle.id}}')">
                            		<i class="fa fa-info-circle"></i>
                            {% elseif detalle.resultCode == 'ERROR' %}
                            	<a id="btnRes{{detalle.id}}" class="btn btn-warning res" title="Error al consultar al servicio!" onClick="alert('Error al consultar el servicio.')">
                            		<i class="fa fa-info-circle"></i>
                            {% elseif detalle.resultCode == '' %}
                            	<a id="btnRes{{detalle.id}}" class="btn btn-info res" title="Wait" onClick="#" disabled>
                            		<i class="fa fa-clock-o"></i>
                            {% endif %}
                            </a>                        	
                    	</td>
                    	{% if consultaLote.tipoLote == 'P' %}
                        <td class="row text-left">{{ detalle.apellido }}</td>
                        <td class="row text-left">{{ detalle.nombre }}</td>
                        <td class="row text-left">{{ detalle.fechaNacimiento}}</td>
	                    {% endif %}
						
						{% if consultaLote.tipoLote == 'D' %}
                        <td class="row text-left">{{ detalle.nroDocumento }}</td>
                        <td class="row text-left">{{ detalle.tipoDocumento }}</td>
                        <td class="row text-left">{{ detalle.pais}}</td>
	                    {% endif %}
	                                        
						{% if consultaLote.tipoLote == 'V' %}
                        <td class="row text-left">{{ detalle.vin }}</td>
                        <td class="row text-left">{{ detalle.dominio }}</td>
                        <td class="row text-left">{{ detalle.nroMotor}}</td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        
		</div>
    	</div>
		
		<div class="modal fade" id="MensajeConfirmacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<div class="modal-header modal-header-danger">
						<h5 class="modal-title text-center" id="exampleModalLabel"><b>Confirmación</b></h5>
					</div>
					<div class="modal-body text-center" id="dvMensaje"></div>
					<div class="modal-footer">
						<button type="button" class="btn btn-default res"
							data-dismiss="modal">Cancelar</button>
						<button type="button" class="btn btn-danger res" data-dismiss="modal" onClick="mostrarDetalle();">Aceptar</button>
					</div>
				</div>
			</div>
		</div>
    </div>
   	</div>
	</div>
	</div>
</form>
<script languaje="javascript">
	var interval;
	var porcentaje=0;
	var cantidadIntentos = 0;
	var procesoIniciado = false;
	
    $(document).ready(function () {  
    	
    	mostrarResultados();
    	
		$('#btnProcesar').click(function(){
			$(this).attr("disabled","true");
			$(this).html("Procesando...");
			procesoIniciado = true;
			$('.fa-clock-o').removeClass('fa-clock-o').addClass('fa-spinner').addClass('fa-spin');
			procesarLote();
		});
                
                tablaLote = $('#tablaLote').DataTable({
                    "scrollY": "600px",
                    "scrollX": true,
                    "paging": false,
                    "info": false,
                    "responsive": true,
                    "filter": true,
                    "order": [[0, "asc"]],
                    "columnDefs": [{"targets": [ 0 ],
                            		"visible": false
                        		  }],
                    "oLanguage": {
                                    "sSearch":         "Buscar:",
                                    "sEmptyTable": 	   "No se encontraron registros.",			
                                    "sProcessing":     "Procesando...",
                                    "sLengthMenu":     "Mostrar _MENU_ registros",
                                    "sZeroRecords":    "No se encontraron resultados",
                                    "sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
                                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                                    "sInfoPostFix":    "",
                                    "sUrl":            "",
                                    "sInfoThousands":  ",",
                                    "sLoadingRecords": "Cargando...",
                                    "oPaginate": {
                                        "sFirst":    "Primero",
                                        "sLast":     "Último",
                                        "sNext":     "Siguiente",
                                        "sPrevious": "Anterior"
                                    }
                                }
                });
                
                
                $(".datetimepicker").datetimepicker({
                    format: 'Y-m-d'
                });

                $("select").addClass('form-control');
                $('[data-toggle="tooltip"]').tooltip();

            });
	

	function procesarLote(){
		$.ajaxSetup({	beforeSend: function() {
					        $('html, body').css("cursor", "wait");
					        
					    },
					    complete: function() {
					        $('html, body').css("cursor", "default");
					    }
		});

		$.ajax({
			  type: 'POST',
			  url: '{{path('lote_procesar')}}',
			  data: {'idConsultaLote':'{{consultaLote.id}}'},
			  async : true,
			  success: function(data){
					setTimeout(function(){ 
						clearInterval(interval); 
						$('#btnProcesar').html("Proceso finalizado"); 
						if('{{ loteDetalles|length }}'>1000){
							mostrarResultados();
						}
					}, 4000);
			  },
			  fail: function (jqXHR, textStatus, errorThrown) {
				  	console.log('OCURRIO UN ERROR.');
		            console.log('Status:'+jqXHR.status+' Error:'+errorThrown);		            
		        }
			});
			
			loopLi();
	}
    
    function confirmaDetalle( pApellido, pNombre, pFechaNac, pEntity ){
		$("#txtEntity").val( pEntity );
    	$('#dvMensaje').html( "¿Est&aacute; seguro de que quiere consultar los datos de <b>" + pApellido + ", " + pNombre + "</b>, fecha de nacimiento: <b>"+pFechaNac+"</b>?<br/><br/><b>ESTA ACCI&Oacute;N PUEDE GENERAR ALARMAS</b>." );
    	$('#MensajeConfirmacion').modal( 'show' );
    }	//	function mostrarDivDetalle(){

	function mostrarDetalle( ){
		console.log($( "#txtEntity" ).val() );
		if( $( "#txtEntity" ).val() == ""){
			alert("Para ver el detalle debe seleccionar un renglón haciendo click en la lupa del mismo.");
			return false;
		}	//	if( $( "#txtEntity" ).val() == ""){
		$( "form" ).submit();
	}	//	function mostrarDetalle( ){

	function mostrarResultados(){
		$('form').attr('action', '{{ path('lotesprocesados_show') }}');
		$( "form" ).submit();			
	}

	function verResultado(idConsultaLoteDetalle){
		$("#idConsultaLoteDetalle").val(idConsultaLoteDetalle);
		$('form').attr('action', '{{ path('lote_getresultados') }}');
		$( "form" ).submit();			
	}
	
	function loopLi() {
		interval = setInterval(function() {
			actualizarTabla();
	    }, 2000);
	}
	
	function actualizarTabla(){
		$.post('{{path('lote_actualizar_tabla')}}', {'idConsultaLote': '{{consultaLote.id}}'
		}).done(function (data) {
			var results = jQuery.parseJSON(data);
			porcentaje+=(results.length/'{{ loteDetalles|length }}')*100;
			console.log(data);
			//console.log(porcentaje);
			
			//	<INTENTOS>
			//	SI LUEGO DE N INTENTOS SIGUE DEVOLVIENDO 0 ES PORQUE HA OCURRIDO UN ERROR.
            if(porcentaje == 0){
            	cantidadIntentos++;
            }else{
            	cantidadIntentos=0;
            }

			console.log( "Cantidad de intentos de lectura de resultados: " + cantidadIntentos );
			if(cantidadIntentos>=100){
				clearInterval(interval);
				// INFORMAR QUE OCURRIÓ UN ERROR
				alert("Ocurrió un error inesperado al ejecutar la consulta remota.");
			}

			if(porcentaje>=99){
				clearInterval(interval);
				$('#btnProcesar').html("Proceso finalizado");
				mostrarResultados();
				
			}

			porcent = parseFloat(porcentaje).toFixed(2);

			if(porcent.split('.')[1]=='00'){
				porcent = Math.trunc(porcent);
			}
			
			$("#barraProgreso").css('width',porcent+'%');
			$("#barraProgreso").attr('aria-valuenow',porcent);
			$("#textProgreso").html(porcent+'% completado');

			if('{{ loteDetalles|length }}'<=1000){
				for(i=0;i<results.length;i++){		
					if(results[i].resultCode=='NO_ERROR'){
						$('#btnRes'+results[i].idConsultaDetalle).removeAttr('disabled');
						$('#btnRes'+results[i].idConsultaDetalle).prop('title','Información disponible!');
						$('#btnRes'+results[i].idConsultaDetalle).removeClass('btn-info').addClass('btn-danger');
						$('#btnRes'+results[i].idConsultaDetalle).children().removeClass('fa-spinner').removeClass('fa-spin').addClass('fa-info-circle');
						$('#btnRes'+results[i].idConsultaDetalle).removeAttr('onclik').attr('onclick','verResultado("' + results[i].idConsultaDetalle + '")');
						var r = tablaLote.row( $('#btnRes'+results[i].idConsultaDetalle).parent().parent() ).index();
						tablaLote.cell({ row: r, column: 0 }).data("Información disponible!").draw();
					}else if(results[i].resultCode=='ERROR'){
						console.log(results[i]);
						$('#btnRes'+results[i].idConsultaDetalle).removeAttr('disabled');
						$('#btnRes'+results[i].idConsultaDetalle).prop('title','El servicio retornó error.');
						$('#btnRes'+results[i].idConsultaDetalle).removeClass('btn-info').addClass('btn-warning');
						$('#btnRes'+results[i].idConsultaDetalle).children().removeClass('fa-spinner').removeClass('fa-spin').addClass('fa-exclamation-circle');
						$('#btnRes'+results[i].idConsultaDetalle).removeAttr('onclik').attr('onclick','alert("Error: '+results[i].resultMessage+'")');
						var r = tablaLote.row( $('#btnRes'+results[i].idConsultaDetalle).parent().parent() ).index();
						tablaLote.cell({ row: r, column: 0 }).data("El Servicio retornó error.").draw();		
					}else{
						$('#btnRes'+results[i].idConsultaDetalle).prop('title','Sin resultados-');
						$('#btnRes'+results[i].idConsultaDetalle).removeClass('btn-info').addClass('btn-success');
						$('#btnRes'+results[i].idConsultaDetalle).children().removeClass('fa-spinner').removeClass('fa-spin').addClass('fa-check-circle');
						var r = tablaLote.row( $('#btnRes'+results[i].idConsultaDetalle).parent().parent() ).index();
						tablaLote.cell({ row: r, column: 0 }).data("Sin resultados").draw();		
					}					
				}
				tablaLote.columns.adjust().draw();
			}
		}).fail(function (jqXHR, textStatus, errorThrown) {
            console.log('Status:'+jqXHR.status+' Error:'+errorThrown);
    	});
	}
	
</script>
{% endblock %}