{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
	{% set PermisoDetalle = app.session.get('PERMISODETALLE') %}
	<form method="POST" action="{{ path('documento_showdetails') }}">

		<input type="hidden" id="txtEntity" name="txtEntity" value="{{ app.request.get('txtEntity' ) | default('') }}"/>
		<input type="hidden" id="lstTipoDoc" name="lstTipoDoc" value="{{ app.request.get('lstTipoDoc' ) | default('') }}"/>
		<input type="hidden" id="txtNumeroDoc" name="txtNumeroDoc" value="{{ app.request.get('txtNumeroDoc') | default('') }}"/>
		<input type="hidden" id="lstPais" name="lstPais" value="{{ app.request.get('lstPais' ) | default('') }}"/>
		<input type="hidden" id="lstTipoCons" name="lstTipoCons" value="{{ app.request.get('lstTipoCons' ) | default('') }}"/>
		<input type="hidden" id="idConsultaLoteDetalle" name="idConsultaLoteDetalle" value="{{ app.request.get('idConsultaLoteDetalle' ) | default('') }}"/>

		<div id="panelconsulta" class="col-xs-12" style="margin-bottom:2%;">

			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
					<div class="col-sm-12 col-md-6">
						<div class="row text-cemter">
							<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}"/>
						</div>
						<div class="row">
							<div>&nbsp;</div>
						</div>
						<div class="row">
							<div>
								<p style="color:#2d3c90; font-size:24px;">Interpol - Documentos</p>
							</div>
						</div>
					</div>
					<div class="col-sm-12 col-md-6">
						{% set tipoDoc = '' %}
						{% if app.request.get('lstTipoDoc') != '' %}
							{% for Documento in documentos %}
								{% if Documento.COD == app.request.get('lstTipoDoc') %}
									{% set tipoDoc = Documento.DESCRIPCION %}
								{% endif %}
							{% endfor %}
						{% endif %}
						{% set pais = '' %}
						{% if app.request.get('lstPais') != '' %}
							{% for Pais in paises %}
								{% if Pais.COD_B == app.request.get('lstPais') %}
									{% set pais = Pais.DESCRIPCION %}
								{% endif %}
							{% endfor %}
						{% endif %}

						{% set tipoCons = app.request.get('lstTipoCons') == 'BC' ? 'Control Fronterizo' : 'Investigaci&oacute;n'  %}
						<div class="row">
							<div>
								<p style="color:#2d3c90; font-size:24px;">Datos consultados</p>
							</div>
						</div>
						<strong>Tipo de Documento:
						</strong>
						{{ tipoDoc }}<br>
						<strong>Nro. de Documento:
						</strong>
						{{ app.request.get('txtNumeroDoc') | default('') }}<br>
						<strong>Pa&iacute;s:
						</strong>
						{{ pais }}<br>
						<strong>Tipo Cons.:
						</strong>
						{{ tipoCons | raw }}<br>
					</div>
				</div>
			</div>

			<div class="panel panel-default">
				<div class="panel-heading clearfix">
					<div class="list-group">
						{% if documento|length > 0 and not documento.ERROR is defined %}
							<div class="pull-left">
								<span style="color:red;margin-left:50px;">
									<strong>Resultado POSITIVO</strong>
								</span>
							</div>
						{% endif %}
						<a href="#" onclick="window.history.back();" role="button" id="btnVolver" name="btnVolver" _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
						<a href="#" role="button" id="btnReintentar" name="btnReintentar" _ngcontent-soi-7="" class="btn btn-default pull-right">Reintentar</a>
					</div>
				</div>
				<div class="panel-body">
					<div class="col-sm-12 col-md-12">
						<div class="form-group">

							{% if (documento.ERROR is defined) %}
								<div class="panel panel-danger">
									<div class="panel-heading">
										<b>Atención se produjo el siguiente mensaje de error:</b>
									</div>
									<div class="panel-body">
										<h3>{{ documento.ERROR }}</h3>
									</div>
								</div>
							{% else %}
								<table class="display" id="tablas">
									<thead>
										<tr>
											{% if PermisoDetalle.SLTDDETAILS == 1 %}
												<th>Opc</th>
											{% endif %}
											<th>ID</th>
											<th>Número</th>
											<th>Tipo</th>
											<th>Cod.País</th>
											<th>Desc.País</th>
										</tr>
									</thead>
									<tbody>
										{% for doc in documento %}
											{% if doc.sltdId|default('') != "" %}
												<tr>
													{% if PermisoDetalle.SLTDDETAILS == 1 %}
														<td>
															<div id="obs{{doc.sltdId|default('')}}" style="display:none"></div>
															<a id="btnRes{{doc.sltdId|default('')}}" class="btn btn-danger res" title="Haga click para ver el detalle" data-toggle="modal" onclick="confirmaDetalle('{{doc.nr|default('')}}', '{{doc.type_id|default('')}}', '{{doc.country_of_issuance_id|default('')}}', '{{doc.sltdId|default('')}}');">
																<i class="fa fa-search">
																	<strong>
																		Ver Detalle</strong>
																</i>
															</a>
															<div id="res{{doc.sltdId|default('')}}" style="display:none"></div>
														</td>
													{% endif %}
													<td class="row text-center">{{doc.sltdId|default('')}}</td>
													<td class="row text-center">{{doc.nr|default('')}}</td>
													<td class="row text-center">{{doc.type_id|default('')}}</td>
													<td class="row text-center">{{doc.country_of_issuance_id|default('')}}</td>
													<td class="row text-center">{{doc.country_description|default('')}}</td>
												</tr>
											{% endif %}
										{% endfor %}
									</tbody>
								</table>
							{% endif %}
						</div>
					</div>

					<div class="modal fade" id="MensajeConfirmacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
						<div class="modal-dialog" role="document">
							<div class="modal-content">
								<div class="modal-header modal-header-danger">
									<h5 class="modal-title text-center" id="exampleModalLabel">
										<b>Confirmación</b>
									</h5>
								</div>
								<div class="modal-body text-center" id="dvMensaje"></div>
								<div class="modal-footer">
									<button type="button" class="btn btn-default res" data-dismiss="modal">Cancelar</button>
									<button type="button" class="btn btn-danger res" data-dismiss="modal" onclick="mostrarDetalle();">Aceptar</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</form>
	<script languaje="javascript">
		$(document).ready(function () {
table = $('#tablas').DataTable({
"scrollY": "600px",
"scrollX": true,
"scrollCollapse": true,
"paging": false,
"info": false,
responsive: true,
"filter": true,
"order": [
[0, "asc"]
],
"oLanguage": {
"sSearch": "Buscar:",
"sEmptyTable": '<div class="alert alert-success"><strong>OK: No se encontraron registros.</strong></div>',
"sProcessing": "Procesando...",
"sLengthMenu": "Mostrar _MENU_ registros",
"sZeroRecords": "No se encontraron resultados",
"sInfo": "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
"sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
"sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
"sInfoPostFix": "",
"sUrl": "",
"sInfoThousands": ",",
"sLoadingRecords": "Cargando..."
}
});
});

function confirmaDetalle(pNumero, pTipo, pPais, pEntity) {
$("#txtEntity").val(pEntity);
$('#dvMensaje').html("¿Est&aacute; seguro de que quiere consultar el documento:<br/><b>" + pTipo + " - " + pNumero + "</b>?<br/><br/><b>ESTA ACCI&Oacute;N PUEDE GENERAR ALARMAS</b>.");
$('#MensajeConfirmacion').modal('show');
} // function mostrarDivDetalle(){

function mostrarDetalle() {
if ($("#txtEntity").val() == "") {
alert("Para ver el detalle debe seleccionar un renglón haciendo click en la lupa del mismo.");
return false;
} // if( $( "#txtEntity" ).val() == ""){
$("form").submit();
} // function mostrarDetalle( ){

$("#btnReintentar").click(function () {
location.reload();
});
	</script>
{% endblock %}
