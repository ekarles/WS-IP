{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
	<style>
		.table td {
			text-align: left;
			font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
			font-size: 14px;
		}
	</style>
	<form method="POST" action="{{ path('documento_showdetails') }}">
		<div id="panelTitulo" class="col-xs-12 col-md-6" style="margin-left:25%;">
			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
					<div class="row text-cemter">
						<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}"/>
					</div>
					<div class="row">
						<div>&nbsp;</div>
					</div>
					<div class="row">
						<div>
							<p style="color:#2d3c90; font-size:24px;">Interpol - Documentos</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		{% if app.request.get('txtCombinada') is defined and app.request.get('txtCombinada')=='SI' %}
			<input type="hidden" id="txtCombinadaPer" name="txtCombinada" value="SI"/>
		{% endif %}
		<input type="hidden" id="txtEntity" name="txtEntity" value="{{ app.request.get('txtEntity' ) | default('') }}"/>
		<input type="hidden" id="lstTipoDoc" name="lstTipoDoc" value="{{ app.request.get('lstTipoDoc' ) | default('') }}"/>
		<input type="hidden" id="txtNumeroDoc" name="txtNumeroDoc" value="{{ app.request.get('txtNumeroDoc') | default('') }}"/>
		<input type="hidden" id="lstPais" name="lstPais" value="{{ app.request.get('lstPais' ) | default('') }}"/>
		<input type="hidden" id="lstTipoCons" name="lstTipoCons" value="{{ app.request.get('lstTipoCons' ) | default('') }}"/>
		<div id="panelconsulta" class="col-xs-12 col-md-6" style="margin-bottom:2%;">

			{% if (documentDetails.ERROR is defined) %}
				<div class="panel panel-danger">
					<div class="panel-heading">
						<b>Atención se produjo el siguiente mensaje de error:</b>
					</div>
					<div class="panel-body">
						<h3>{{ documentDetails.ERROR }}</h3>
					</div>
					<div class="panel-body">
						<div _ngcontent-xyt-6="" class="panel-heading">
							<a href="#" onclick="window.history.back();" role="button" id="btnCerrar1" name="btnCerrar1" _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
						</div>
					</div>
				</div>

			{% else %}

				<div class="panel panel-danger">
					<div class="panel-heading" style="height:50px;">
						<h4>
							<span class="glyphicon glyphicon-info-sign"></span>Resultado Positivo!</h4>
					</div>
					<div class="panel-body">
						<div class="form-group">
							<label class="col-md-12" style="font-weight:normal; font-size:16px;">
								{{ encabezados.leyenda_A }}
							</label>
						</div>
						<div class="form-group">
							<label class="col-md-12" style="font-weight:normal; font-size:16px;">
								{{ encabezados.leyenda_B }}
							</label>
						</div>
						<div class="form-group">
							<label class="col-md-12" style="font-weight:normal; font-size:16px;">
								{{ encabezados.leyenda_C }}
							</label>
						</div>
						<div class="form-group">
							<label class="col-md-12" style="font-weight:normal; font-size:16px;">
								{{ encabezados.leyenda_D }}
							</label>
						</div>
						<div class="form-group">
							<label class="col-md-12" style="font-weight:normal; font-size:16px;">
								{{ encabezados.leyenda_E }}
							</label>
						</div>
						<div class="form-group">
							<label class="col-md-12" style="font-weight:normal; font-size:16px;">
								{{ encabezados.leyenda_F }}
							</label>
						</div>
					</div>
					<div _ngcontent-soi-7="" class="panel-heading">
						<a href="#" onclick="window.history.back();" role="button" id="btnCerrar1" name="btnCerrar1" _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
						<a href="#" role="button" id="btnReintentar" name="btnReintentar" _ngcontent-soi-7="" class="btn btn-default pull-right">Reintentar</a>
						<h4 _ngcontent-soi-7="">Datos de:
							{{ documentDetails["type_id"] ~ " " ~ documentDetails["nr"] }}</h4>
					</div>
					<div _ngcontent-soi-7="" class="panel-heading">
						<h4 _ngcontent-soi-7="">Información Complementaria</h4>
					</div>

					{% if documentDetails['theft']|length > 0 %}
						<div _ngcontent-soi-7="" class="panel-body">
							<div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
								<div class="list-group">
									<a class="list-group-item list-group-item-info">Robo</a>
									{% if documentDetails['theft'] is defined and documentDetails['theft'] is iterable %}
										{% for key, item in documentDetails["theft"]|default('') %}
											{% if key == "country_id" %}
												<a class="list-group-item">{{ titulos[key] }}:
													<strong>{{ paises[item]["ID"] ~ " - " ~ paises[item]["COD_B"] ~ " - " ~ paises[item]["DESCRIPCION"] | default('NO DATA') }}</strong>
												</a>
											{% elseif key == "date" or key == "db_insert_on" or key == "db_review_date" %}
												<a class="list-group-item">{{ titulos[key] }}:
													<strong>{{ item|slice(6,2) ~ "/" ~ item|slice(4,2) ~ "/" ~ item|slice(0,4)|default('NO DATA') }}</strong>
												</a>
											{% else %}
												<a class="list-group-item">{{ titulos[key] }}:
													<strong>{{ item }}</strong>
												</a>
											{% endif %}
										{% endfor %}
									{% endif %}
								</div>
							</div>
						</div>
					{% endif %}

					{% if documentDetails["investigation"] is iterable %}
						<div _ngcontent-soi-7="" class="panel-body">
							<div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
								<div class="list-group">
									<a class="list-group-item list-group-item-info">Información Adicional</a>
									{% for key, item in documentDetails["investigation"]["add_info"]|default('') %}
										<a class="list-group-item">{{ titulos[key] }}:
											<strong>{{ item }}</strong>
										</a>
									{% endfor %}
								</div>
							</div>
						</div>
					{% endif %}
					{% if documentDetails|length > 0 %}
						<div _ngcontent-soi-7="" class="panel-body">
							<div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
								<div class="list-group">
									<a class="list-group-item list-group-item-info">Documento</a>
									{% for key, item in documentDetails|default('') %}
										{% if item is not iterable %}
											{% if key == "country_of_issuance_id" %}
												<a class="list-group-item">{{ titulos[key] }}:
													<strong>{{ paises[item]["ID"] ~ " - " ~ paises[item]["COD_B"] ~ " - " ~ paises[item]["DESCRIPCION"] | default('NO DATA') }}</strong>
												</a>
											{% else %}
												<a class="list-group-item">{{ titulos[key] }}:
													<strong>{{ item }}</strong>
												</a>
											{% endif %}
										{% endif %}
									{% endfor %}
								</div>
							</div>
						</div>
					{% endif %}


					<div _ngcontent-xyt-6="" class="panel-footer">
						<button _ngcontent-xyt-6="" id="btnCerrar3" name="btnCerrar3" class="btn btn-default" onclick="window.history.back();">Volver</button>
					</div>
				{% endif %}
				<!-- if (documentDetails.ERROR is defined) -->
			</div>
		</div>
		<div class="modal fade" id="MensajeConfirmacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<div class="modal-header modal-header-danger">
						<h5 class="modal-title text-center" id="exampleModalLabel">
							<b>Confirmación</b>
						</h5>
					</div>
					<div class="modal-body text-center" id="dvMensaje"></div>
					<div class="modal-footer">
						<button type="button" class="btn btn-default res" data-dismiss="modal">Cancelar</button>
						<button type="button" class="btn btn-danger res" data-dismiss="modal" onclick="mostrarDetalle();">Aceptar</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
<script languaje="javascript">

	$(document).ready(function () {
if ($(window).width() < 600) {
$("#panelconsulta").attr("style", "margin-bottom:2%;");
} else {
$("#panelconsulta").attr("style", "margin-left:25%;margin-bottom:2%;");
}
});

$("#btnCerrar").click(function () {
cerrar();
});
$("#btnCerrar2").click(function () {
cerrar();
});

function cerrar() {{% if app.request.get('txtCombinada') is defined and app.request.get('txtCombinada')=='SI' %}
$('form').attr('action', '{{ path('combinada') }}');
{% else %}
$('form').attr('action', '{{ path('documento') }}');{% endif %}

$("form").submit();
}

$("#btnReintentar").click(function () {
confirmaDetalle($("#txtNumeroDoc").val(), $("#lstTipoDoc").val(), $("#lstPais").val(), $("#txtEntity").val());
});

function mostrarDetalle() {
if ($("#txtEntity").val() == "") {
alert("Para ver el detalle debe seleccionar un renglón haciendo click en la lupa del mismo.");
return false;
} // if( $( "#txtEntity" ).val() == ""){
$("form").submit();
} // function mostrarDetalle( ){

function confirmaDetalle(pNumero, pTipo, pPais, pEntity) {
$("#txtEntity").val(pEntity);
$('#dvMensaje').html("Esta seguro que quiere consultar el documento:<br/><b>" + pTipo + " - " + pNumero + "</b><br/><br/><br/>ESTA ACCION <b>PUEDE GENERAR ALARMAS</b>.");
$('#MensajeConfirmacion').modal('show');
} // function mostrarDivDetalle(){
</script>{% endblock %}
