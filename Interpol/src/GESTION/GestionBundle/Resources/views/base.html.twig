	                        </li>
	                        {% if is_admin %}
	                        	{% set diasSinCnrt = cnrtpersona_service.diasSinRegistrosCnrt() %}
	                        {% else %}
	                        	{% set diasSinCnrt = 0 %}	
 							{% endif %}
 							{% for menu in Menu %}
 								<li>
								<a href="#"><i class="{{ menu.ICONOMENU|default('') }}"></i>  {{ menu.TITULOMENU | raw }} 
	                                 {% if is_admin and menu.TITULOMENU == 'Administraci&oacute;n de lotes' and diasSinCnrt != 0 %}
	                                 	 <div class="notificacion-container-3">
	                                         <div class="notificacion-value">
	                                             <strong>!</strong>   
	                                         </div>
	                                     </div>
	                                 {% endif %}
	                                 {% if  menu.TITULOMENU == 'Gesti&oacute;n' %}
	                                     {% if app.session.get('ALARMASULTIMAS24HS') != 0 %}
	                                     <div class="notificacion-container">
	                                         <div class="notificacion-value">
	                                             <strong>!</strong>   
	                                         </div>
	                                     </div>
	                                     {% endif %}
	                                     {% if app.session.get('MOVIMIENTOSPENDIENTES') != 0 %}
	                                     <div class="notificacion-container-2" {{app.session.get('ALARMASULTIMAS24HS') != 0 ? 'style="left: 60%;"' : ''}}>
	                                         <div class="notificacion-value">
	                                             <strong>!</strong>   
	                                         </div>
	                                     </div>
	                                     {% endif %}
	                                 {% endif %}
	                                 <span class="fa arrow"></span>
                                  </a>
								<ul class="nav nav-second-level">
									{% for submenu in SubMenu %}
								    	{% if(menu.PERFILID == submenu.MENU) %}
    								    	<li>
    								    	
    								    		{% if submenu.TITULOMENU == 'Avisos de Movimiento' %}
        										<a class="menu" href="{{ path(submenu.ACCION) }}">
        											<i class="{{ submenu.ICONOMENU|default('') }}"></i>  {{ 'Avisos de<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Movimiento' | raw }}
        										</a>
        										{% else %}
        										<a class="menu" href="{{ path(submenu.ACCION) }}">
        											<i class="{{ submenu.ICONOMENU|default('') }}"></i>  {{ submenu.TITULOMENU | raw }}
        										</a>
        										{% endif %}
        										{% if submenu.TITULOMENU == 'Alarmas' %}
												<div class="notificacion-container">
										            <div class="notificacion-value" id="dvAlarmas24">
										             	{{app.session.get('ALARMASULTIMAS24HS')}}   
										            </div>
										        </div>
        										{% endif %}
        										
        										{% if submenu.TITULOMENU == 'Avisos de Movimiento' %}
												<div class="notificacion-container-2">
										            <div class="notificacion-value" id="dvMovimientosPendientes">
										             	{{app.session.get('MOVIMIENTOSPENDIENTES')}}   
										            </div>
										        </div>
        										{% endif %}
        										{% if is_admin and 'CNRT' in submenu.TITULOMENU and diasSinCnrt != 0 %}
												<div class="notificacion-container-3">
										            <div class="notificacion-value" id="dvAlertaCnrt">
										             	<strong>!</strong>   
										            </div>
										        </div>
        										{% endif %}
        									</li>
    								    {% endif %}
								    {% endfor %}
								</ul>
								</li>
							{% endfor %}
							{% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
								<br>
								<li class="list-group-item-info">
									<a href="#">
										<i class="fas fa-file-code"></i> Admin DESA 
                                        <span class="fa arrow"></span>
                                	</a>
                                	<ul class="nav nav-second-level">
   								    	<li>
   								    		<a class="menu" href="{{ path('admin_proceso') }}">
       											<i class="fas fa-terminal"></i>  Procesos
       										</a>
       									</li>
       									<li>
   								    		<a class="menu" href="{{ path('admin_proceso_parametros') }}">
       											<i class="fas fa-wrench"></i>  Par&aacute;metros
       										</a>
       									</li>
									</ul>
								</li>
							{% endif %}
						</ul>
						<br>
						<div style="text-align:center;display:none;">
							<img width="60%" src="{{asset('bundles/pfa/img/escudo-pfa.gif')}}" style="display:inlay-block"/>
						</div>
						<br>
						<div style="text-align:center;display:none;">
							<img width="60%" src="{{asset('bundles/pfa/img/escudo-sftiyc.gif')}}" style="display:inlay-block"/>
						</div>
                	</div>
                	<!-- /.sidebar-collapse -->
                </div>
                
                <!-- /.navbar-static-side -->
            </nav>

            <!-- Page Content -->
				<div id="page-wrapper">
                    <div class="container-fluid">
                        <div class="row-fluid text-center" id="dvFlashMsg">
                            {% for flashMessage in app.session.flashbag.get('msgError') %}
                                <div class="span4 offset4" >
                                    <div class="alert alert-block fade in alert-error">
                                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                                        <h4>{{ flashMessage|raw }}</h4> 
                                    </div>
                                </div>
                            {% endfor %}
                            {% for flashMessage in app.session.flashbag.get('msgWarn') %}
                                <div class="span4 offset4" >
                                    <div class="alert alert-block fade in alert-warning">
                                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                                        <h4>{{ flashMessage|raw }}</h4>
                                    </div>
                                </div>
                            {% endfor %}
                            {% for flashMessage in app.session.flashbag.get('msgOk') %}
                                <div class="span4 offset4" >
                                    <div class="alert alert-block fade in alert-success">
                                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                                        <h4>{{ flashMessage|raw }}</h4>
                                    </div>
                                </div>
                            {% endfor %}
                            {% for flashMessage in app.session.flashbag.get('msgInfo') %}
                                <div class="span4 offset4" >
                                    <div class="alert alert-block fade in alert-info">
                                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                                        <h4>{{ flashMessage|raw }}</h4>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        {% block body %}
                        {% endblock %} 
