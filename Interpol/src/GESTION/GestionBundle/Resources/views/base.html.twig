            <nav class="navbar navbar-default navbar-static-top" role="navigation" style="margin-bottom: 0;{{ ambiente == 'PREPRODUCCION' ? 'background-color:#fffdb9;' : '' }}{{ ambiente == 'DESARROLLO' ? 'background-color:#d3fdc2;' : '' }}">
