                {% endif %}
                {% if is_admin %}
                	{% set path = 'admin_' ~ path %}
                {% endif %}
                {% set hash = herramientas_service.obtener_hash(path) %}
                
                {% if herramientas_service.existe_archivo('/apache/htdocs' ~ asset('bundles/pfa/faq/' ~ path ~ '_' ~ hash ~ '.pdf')) %}
                <a target="_blank" title="Ver Instructivo" href="{{ asset('bundles/pfa/faq/' ~ path ~ '_' ~ hash ~ '.pdf') }}"><span class="glyphicon glyphicon-question-sign pull-right" style="margin-top:12px;position:relative;margin-right:10px;font-size:23px;"></span></a>
                {% endif %}
            {% endif %}
            {% set Menu = app.session.get('Menu') %}
            {% set SubMenu = app.session.get('SubMenu') %}
 
                  <div class="navbar-default sidebar" role="navigation">
                    <div class="showMenu" title="Expandir Men&uacute;">Scroll to Top</div> 
                    <div class="sidebar-nav navbar-collapse">
                        <ul class="nav" id="side-menu">
	                        <li id="homeM">
	                            <a id="home" href="{{path('_homepage')}}"><i class="fa fa-home"></i> Home</a>
	                        </li>
	                        <li id="cerrarM">
