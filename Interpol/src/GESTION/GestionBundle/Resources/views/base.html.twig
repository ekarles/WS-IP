                    <div class="textHeader" style="display:inline-block;margin-left:400px;font-size:20px;margin-top:10px;font-weight: bold;font-style:italic;">
                    {{ ambiente != 'PRODUCCION' ? ambiente|capitalize : '' }}
                    </div>       
                </div>
                
                
                
            <!-- /.navbar-header -->                
            {% if app.user %}
            	<ul class="nav navbar-top-links navbar-right">
                    <!-- /.dropdown -->
