    {% set perfil = app.session.get('perfil') %}
    <div id="alertCarga" class="row" style="display:none;margin-left:45%;">
		<div class="alert alert-primary mx-auto" style="position:fixed;margin-top:0px;z-index:9999;display:inline-block;opacity:0.9;font-size:18px;font-weight:bold;">
		  <span style="margin-top:10px;"><strong>&nbsp;&nbsp;&nbsp;Cargando&nbsp;</strong><i class="fas fa-spinner fa-spin"></i></span>
		</div>
	</div>
    <body>
    	<div id="wrapper">
	        <div class="animationload">
	            <div class="loader" style="background-image: url('{{asset('bundles/pfa/img/loading.gif')}}');">Cargando ...</div>
	        </div>
                <div class="animationload2">
	            <div class="loader" style="background-image: url('{{asset('bundles/pfa/img/loading.gif')}}');">Cargando ...</div>
	        </div>
