                    <!-- /.container-fluid -->
                </div>
	            <div class="footer-zone">
	            	<div class="container" align="right">{{ 'ROLE_SUPER_ADMIN' in app.user.roles and ambiente != 'PRODUCCION' ? '/apache/htdocs' ~ asset('bundles/pfa/faq/' ~ path ~ '_' ~ hash ~ '.pdf'):''}}<img id="logoDesa" width="600px" src="{{asset('bundles/pfa/img/desarrollo-transparent.png')}}?rand={{ random(5) }}"></div>
	            </div>
                <!-- /#page-wrapper -->
            </div>
            <!-- /#wrapper --> 
</body>
</html>
<script>

$(window).on('resize', function(){
	if ($(window).width() <= 767) {
		$('#cerrarMenu').hide();
		$('#logoDesa').hide();
		$('.glyphicon').hide();
	}else{
		$('#cerrarMenu').show();
		$('#logoDesa').show();
		$('.glyphicon').show();
	}
	showTextHeader();
});

$(window).load(function () {    
	showTextHeader();
});

function showTextHeader(){
    if ($(window).width() >= 812) {
        $(".textHeader").show();
    }else{
        $(".textHeader").hide();
    }
}


$(document).ready(function(){	
	{% if app.session.get('Menu')|length == 0  %}
		$('.animationload2').css('display','block');
		$.post('{{path('_homepage')}}')
			.done(function (data) {
				location.reload();
			}).fail(function (jqXHR, textStatus, errorThrown) {
		        console.log('Status:'+jqXHR.status+' Error:'+errorThrown);
			}); 
	{% endif  %}
	showTextHeader();
});

$('#cerrarMenu').click(function () {
    if ($(window).width() > 767) {
        $('.navbar-collapse').hide();
        $('.sidebar').css({width: '0px'});
        $('#page-wrapper').css({marginLeft: '30px'});
        $('.dataTable').DataTable().columns.adjust().draw();
        $('.showMenu').show();
    }
});
$('.showMenu').click(function () {
    if ($(window).width() > 767) {
        $('.showMenu').hide();
        $('.navbar-collapse').show();
        $('.sidebar').css({width: '250px'});
        $('#page-wrapper').css({marginLeft: '255px'});
        $('.dataTable').DataTable().columns.adjust().draw();
    }
});
</script>