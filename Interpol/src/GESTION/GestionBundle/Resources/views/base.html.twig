        <script>
            var table;
            var tableSF;
            
            function borrar(link){
                    if(confirm("Esta seguro que desea borrar?")){
                            window.location.href=link;
                    }
            }
			
            $(document).ready(function () {
                    
                $('input').addClass('form-control');
				
                $( "input:file" ).removeClass('form-control').removeAttr('required');
                $('input:first').focus();

                tableSF = $('#tablaSF').DataTable({
                    "scrollY": "400px",
                    "scrollCollapse": true,
                    "scrollX": true,
                    "paging": false,
                    "info": false,
                    responsive: true,
                    "filter": false,
                    "order": [[0, "desc"]]
                });

                
                $(".datetimepicker").datetimepicker({
                    format: 'Y-m-d'
                });

                $("select").addClass('form-control');
                $('[data-toggle="tooltip"]').tooltip();

            });

            $(window).resize(function () {
                $('#tablas').DataTable().columns.adjust().draw();
                $('#tablaSF').DataTable().columns.adjust().draw();
                $('.tablashow').DataTable().columns.adjust().draw();
            });

            $(window).load(function () {    
                $('.animationload').fadeOut("slow");
            });

            $(window).bind('beforeunload', function(){
                $('.animationload').fadeIn();
            });

            $(window).on("pageshow", function(event) {
                $('.animationload').fadeOut("slow");
            });

        </script>
