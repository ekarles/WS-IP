                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">                               
                            {{ app.user }} <i class="fa fa-user fa-fw"></i><i class="fa fa-caret-down"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li><a href="{{ path('usuario_datos')}}"><i class="fas fa-id-badge"></i> Mis Datos</a>
                            </li>
                            <li class="divider"></li>
                            <li><a href="{{ path('logout') }}"><i class="fas fa-sign-out-alt"></i> Cerrar Sesi&oacute;n</a>
                            </li>
                        </ul>
                        <!-- /.dropdown-user -->
                    </li>
                    <!-- /.dropdown -->
                </ul>
                
                <!-- /.navbar-top-links -->
                {% set path = app.request.attributes.get('_route') %}
                {% if 'ADMINISTRADOR (Administrador del sistema)' in app.user.perfilid %}
