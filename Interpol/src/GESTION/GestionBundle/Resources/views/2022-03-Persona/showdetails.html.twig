{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
<style>
.table td {
   text-align: left;
   font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
   font-size: 14px;
}
</style>

<form method="POST" action="{{ path('persona_showdetails') }}">
	{% if app.request.get('txtCombinada') is defined and app.request.get('txtCombinada')=='SI' %}
		<input type="hidden" id="txtCombinadaPer" name="txtCombinada" value="SI"/>
	{% endif %}			
	<input type="hidden" id="txtEntity"   name="txtEntity"   value="{{ app.request.get('txtEntity'  )|default('') }}" />
	<input type="hidden" id="txtNombre"   name="txtNombre"   value="{{ app.request.get('txtNombre'  )|default('') }}" />
	<input type="hidden" id="txtApellido" name="txtApellido" value="{{ app.request.get('txtApellido')|default('') }}" />
	<input type="hidden" id="txtFechaNac" name="txtFechaNac" value="{{ app.request.get('txtFechaNac')|default('') }}" />
	<input type="hidden" id="lstTipoCons" name="lstTipoCons" value="{{ app.request.get('lstTipoCons')|default('') }}" />

<div id="panelTitulo" class="col-xs-12 col-md-6" style="margin-left:25%;">
			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
			    		<div class="row text-cemter">
			    		<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
				    	</div>
						<div class="row">
							<div>&nbsp;</div>
						</div>
						<div class="row">
							<div><p style="color:#2d3c90; font-size:24px;">Interpol - Personas</p></div>
						</div>
				</div>
			</div>
</div>
	<div id="panelconsulta" class="col-xs-12 col-md-6" style="margin-left:25%; margin-bottom:2%;">
	
	<pre>
	{{ dump(nominalDetails) }}
	</pre>
	
	{% if (nominalDetails.ERROR is defined and nominalDetails.ERROR!='') %}
        <div class="panel panel-danger">
          <div class="panel-heading"><b>Atención se produjo el siguiente mensaje de error:</b></div>
          <div class="panel-body"><h3>{{ nominalDetails.ERROR }}</h3></div>
          <div class="panel-body">
          	<div _ngcontent-xyt-6="" class="panel-heading">
	  		<a href="#" onclick="window.history.back();" role="button" id="btnCerrar1"     name="btnCerrar1"     _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
	    	</div>
	      </div>
        </div>

	{% else %}
                <div class="panel panel-danger">
                    <div class="panel-heading" style="height:50px;">
                        <h4><span class="glyphicon glyphicon-info-sign"></span>Resultado Positivo!</h4>                          
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                            <label class="col-md-12" style="font-weight:normal; font-size:16px;">
                                {{ encabezados.leyenda_A }}
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12" style="font-weight:normal; font-size:16px;">
                                {{ encabezados.leyenda_B }}
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12" style="font-weight:normal; font-size:16px;">
                                {{ encabezados.leyenda_C }}
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12" style="font-weight:normal; font-size:16px;">
                                {{ encabezados.leyenda_D }}
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12" style="font-weight:normal; font-size:16px;">
                                {{ encabezados.leyenda_E }}
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="col-md-12" style="font-weight:normal; font-size:16px;">
                                {{ encabezados.leyenda_F }}
                            </label>
                        </div>            
                    </div>
            
            	    <div _ngcontent-xyt-6="" class="panel-heading">
            	  		<a href="#" onclick="window.history.back();" role="button" id="btnCerrar1"     name="btnCerrar1"     _ngcontent-soi-7="" class="btn btn-default pull-right">Volver</a>
            	      	<a href="#" role="button" id="btnReintentar" name="btnReintentar" _ngcontent-soi-7="" class="btn btn-default pull-right">Reintentar</a>
            	      	<h4 _ngcontent-xyt-6="">Datos de: {{ nominalDetails["name"]|default('NO DATA') ~ ' ' ~ nominalDetails["forename"]|default('NO DATA') }}</h4>
            	    </div>
            	
            	    <div _ngcontent-xyt-6="" class="panel-body">
            	      <div _ngcontent-xyt-6="" class="row">
            	        <div _ngcontent-xyt-6="" class="col-xs-12 col-sm-12 col-md-4 col-xl-4">
            	          <div _ngcontent-xyt-6="" class="row">
            	            <div _ngcontent-xyt-6="" class="col-xs-12">
            	              <a _ngcontent-xyt-6="" class="thumbnail" href="javascript:mostrar(0)">
            	              	{% if arrayImg|length>0 %}
            	              	<img id="imagen" src="{{ arrayImg[0]|default('') }}">
            	              	{% else %}
            	              	<img id="imagen" src="{{ asset( 'bundles/images/unknown.png' ) }}">
            	              	{% endif %}
            	              </a>
            	            </div>
            	          </div>
            	          <div _ngcontent-xyt-6="" class="row">
            	            <div _ngcontent-xyt-6="" class="col-xs-12">
            	              <table _ngcontent-xyt-6="" width="100%">
            	                <tbody _ngcontent-xyt-6=""><tr _ngcontent-xyt-6="">
            	                	<tr>
                                       <td width="20%">
                                           <button class="btn btn-default center-block" disabled>
                                          	    <span class="glyphicon glyphicon-chevron-left"></span>
                                           </button>
                                       </td>
                                       <td width="60%">
                                           <p class="text-center" style="padding-top:10px;" id="nroFoto">{{arrayImg|length==0?'0':'1'}} de {{arrayImg|length}}</p>
                                       </td>
                                       <td width="20%">
                                           <button class="btn btn-default center-block" disabled>
                                               <span class="glyphicon glyphicon-chevron-right"></span>
                                           </button>
                                       </td>
                                  	</tr>
            	              </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                        
                    <div _ngcontent-xyt-6="" class="col-xs-12 col-sm-12 col-md-8 col-xl-8">
                      <table _ngcontent-xyt-6="" class="table table-striped ">
                        <tbody _ngcontent-xyt-6="">
                        <!--template bindings={}-->
                        {% if nominalDetails["notification"]["type_id"]|default('')|lower == "red" %}
            	            <tr _ngcontent-xyt-6="" style="color: black; background-color: {{ nominalDetails["notification"]["type_id"]|default('')|lower }};">
            	        {% else %}
            	        	<tr _ngcontent-xyt-6="" style="color: lightblue; background-color: {{ nominalDetails["notification"]["type_id"]|default('')|lower }};">
                        {% endif %}
                          <td _ngcontent-xyt-6="">
                            <h4 _ngcontent-xyt-6="">Notificación</h4>
                          </td>
                          <td _ngcontent-xyt-6="">
                          {% if nominalDetails["notification"]["type_id"]|default('') in colores|keys %}
                            <h4 _ngcontent-xyt-6="">{{ colores[nominalDetails["notification"]["type_id"]|default('')]~ " / " ~ nominalDetails["notification"]["type_id"]|default('') }}</h4>
                          {% else %}
                          	<h4 _ngcontent-xyt-6="">{{ nominalDetails["notification"]["type_id"]|default('') }}</h4>
                          {% endif %}
                          </td>
                        </tr>
                        <!--template bindings={}-->
                        <tr _ngcontent-xyt-6="">
                          <td _ngcontent-xyt-6="" >{{ titulos["sex_id"] }}</td>
                          <td _ngcontent-xyt-6="" ><strong _ngcontent-xyt-6="">{{ nominalDetails["sex_id"]|default('NO DATA') }}</strong></td>
                        </tr>
                        <tr _ngcontent-xyt-6="">
                          <td _ngcontent-xyt-6="">{{ titulos["date_of_birth"] }}</td>
                          <td _ngcontent-xyt-6=""><strong _ngcontent-xyt-6="">{{ nominalDetails["date_of_birth"]|slice(6,2) ~ "/" ~ nominalDetails["date_of_birth"]|slice(4,2) ~ "/" ~ nominalDetails["date_of_birth"]|slice(0,4) | default('NO DATA') }}</strong></td>
                        </tr>
                        <tr _ngcontent-xyt-6="">
                          <td _ngcontent-xyt-6="">{{ titulos["place_of_birth"] }}</td>
                          <td _ngcontent-xyt-6=""><strong _ngcontent-xyt-6="">{{ nominalDetails["place_of_birth"]|default('NO DATA') }}</strong></td>
                        </tr>
                        <tr _ngcontent-xyt-6="">
                          <td _ngcontent-xyt-6="">{{ titulos["type"] }}</td>
                          <td _ngcontent-xyt-6=""><strong _ngcontent-xyt-6="">{{ nominalDetails["document"]["type"]|default('NO DATA') }}</strong></td>
                        </tr>
                        <tr _ngcontent-xyt-6="">
                          <td _ngcontent-xyt-6="">{{ titulos["nr"] }}</td>
                          <td _ngcontent-xyt-6=""><strong _ngcontent-xyt-6="">{{ nominalDetails["document"]["nr"]|default('NO DATA') }}</strong></td>
                        </tr>
                        <tr _ngcontent-xyt-6="">
                          <td _ngcontent-xyt-6="">Actualizado</td>
                          <td _ngcontent-xyt-6=""><strong _ngcontent-xyt-6="">{{ nominalDetails["db_last_updated_on"]|slice(6,2) ~ "/" ~ nominalDetails["db_last_updated_on"]|slice(4,2) ~ "/" ~ nominalDetails["db_last_updated_on"]|slice(0,4) |default('NO DATA') }}</strong></td>
                        </tr><tr _ngcontent-xyt-6="">
                          <td _ngcontent-xyt-6="">Visto</td>
                          <td _ngcontent-xyt-6=""><strong _ngcontent-xyt-6="">{{ nominalDetails["db_review_date"]|slice(6,2) ~ "/" ~ nominalDetails["db_review_date"]|slice(4,2) ~ "/" ~ nominalDetails["db_review_date"]|slice(0,4) | default('NO DATA') }}</strong></td>
                        </tr>
                      </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              
                  <div _ngcontent-xyt-6="" class="panel-heading">
                  <h4 _ngcontent-xyt-6="">Información Complementaria</h4>
                </div>
                
                <div class="panel-body">
                  <!--template bindings={}-->
            {% if nominalDetails["notification"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Notificación</a>
                {% for key, item in nominalDetails["notification"]|default('') %}
            				{% if item is iterable %}
            					{% for keyI, itemI in item %}
            						{% if itemI is not iterable %}
            							<a class="list-group-item">{{ titulos[keyI]|default('') }} <strong>{{ " : " ~ itemI|default('NO DATA') }}</strong></a>
            						{% endif %}
            					{% endfor %}
            				{% else %}
                            	<a class="list-group-item">{{ titulos[key]|default('') }} <strong>{{ " : " ~ item|default('NO DATA') }}</strong></a>
                            {% endif %}
                {% endfor %}
                        </div>
                    </div>
            {% endif %}
                    
            {% if nominalDetails["arrest_warrant"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Pedido de arresto</a>
            {% for key, item in nominalDetails["arrest_warrant"]|default('') %}
           		{% if item is iterable %}
           			{% for k, i in item|default('') %}
           				{% if i is iterable %}
           					{% for clave,valor in i|default('') %}
           						<a class="list-group-item">{{ titulos[clave]|default('') }} <strong>{{ " : " ~ valor|default('NO DATA') }}</strong></a>
           					{% endfor %}           					
           				{% else %}
           					<a class="list-group-item">{{ titulos[k]|default('') }} <strong>{{ " : " ~ i|default('NO DATA') }}</strong></a>
           				{% endif %}
           			{% endfor %}
           		{% else %}
                            <a class="list-group-item">{{ titulos[key]|default('') }} <strong>{{ " : " ~ item|default('NO DATA') }}</strong></a>
                {% endif %}            
            {% endfor %}
                        </div>
                    </div>
            {% endif %}
            {% if nominalDetails["document"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Documento</a>
            {% for key, item in nominalDetails["document"]|default('') %}
            	{% if item is iterable %}
            		{% for k, i in item %}
            			{% if i is iterable %}
            				{% for clave,valor in i %}
            					<a class="list-group-item">{{ titulos[clave]|default('') }} <strong>{{ " : " ~ valor|default('NO DATA') }}</strong></a>
            				{% endfor %}
            			{% else %}
            				<a class="list-group-item">{{ titulos[k]|default('') }} <strong>{{ " : " ~ i|default('NO DATA') }}</strong></a>
            			{% endif %}
            		{% endfor %}		
            	{% else %}
                            <a class="list-group-item">{{ titulos[key]|default('') }} <strong>{{ " : " ~ item|default('NO DATA') }}</strong></a>
                {% endif %}            
            {% endfor %}
                        </div>
                    </div>
            {% endif %}
            {% if nominalDetails["file"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Archivo</a>            				
            {% for key, item in nominalDetails["file"]|default('') %}
            				{% if item is iterable %}
            					{% for k, i in item|default('') %}
            						<a class="list-group-item">{{ titulos[k]|default('') }} <strong>{{ " : " ~ i|default('NO DATA') }}</strong></a>
            					{% endfor %}
            				{% else %}
            					<a class="list-group-item">{{ titulos[key]|default('') }} <strong>{{ " : " ~ item|default('NO DATA') }}</strong></a>
            				{% endif %}
            {% endfor %}
                        </div>
                    </div>
            {% endif %}
            
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Datos Personales</a>
                            <a class="list-group-item">Apellido: <strong>{{ nominalDetails["name"]|default('NO DATA') }}</strong></a>
                            <a class="list-group-item">Nombre: <strong>{{ nominalDetails["forename"]|default('NO DATA') }}</strong></a>
            {% if nominalDetails["name_at_birth"] is defined %}                
                            <a class="list-group-item">Nombre de Nacimiento: <strong>{{ nominalDetails["name_at_birth"]|default('NO DATA') }}</strong></a>
            {% endif %}
            {% for item in nominalDetails["nickname"]|default('') %}
                            <a class="list-group-item">Nickname: <strong>{{ item|default('NO DATA') }}</strong></a>
            {% endfor %}
            
            				<a class="list-group-item">Sexo: <strong>{{ nominalDetails["name"]|default('NO DATA') }}</strong></a>
            				<a class="list-group-item">Fecha de Nacimiento: <strong>{{ nominalDetails["date_of_birth"]|default('NO DATA') }}</strong></a>
            				<a class="list-group-item">Lugar de Nacimiento: <strong>{{ nominalDetails["place_of_birth"]|default('NO DATA') }}</strong></a>
            				<a class="list-group-item">País: <strong>{{ nominalDetails["country_of_birth_id"]|default('NO DATA') }}</strong></a>
            				<a class="list-group-item">Actualizado: <strong>{{ nominalDetails["db_last_updated_on"]|default('NO DATA') }}</strong></a>
            				<a class="list-group-item">Fecha de revisión: <strong>{{ nominalDetails["db_review_date"]|default('NO DATA') }}</strong></a>
            				<a class="list-group-item">Calificación: <strong>{{ nominalDetails["qualification_id"]|default('NO DATA') }}</strong></a>
                        </div>
                    </div>
                    
            {% if nominalDetails["father"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Padre</a>
                {% for itemf in nominalDetails["father"]|default('') %}
                            <a class="list-group-item">Apellido: <strong>{{ itemf|default('NO DATA') }}</strong></a>
                {% endfor %}
                        </div>
                    </div>
            {% endif %}
            {% if nominalDetails["mother"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Madre</a>
                {% for itemm in nominalDetails["mother"]|default('') %}
                            <a class="list-group-item">Apellido: <strong>{{ itemm|default('NO DATA') }}</strong></a>
                {% endfor %}
                        </div>
                    </div>
            {% endif %}
            
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Ciudadano de</a>
                            <a class="list-group-item">Pais: <strong>{{ nominalDetails["place_of_birth"]|default('NO DATA') }}</strong></a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Datos Personales</a>
                            <a class="list-group-item">status_id: <strong>{{nominalDetails["status_id"]|default('NO DATA') }}</strong></a>
                        </div>
                    </div>
            
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Icis</a>
            {% for key, itemi in nominalDetails["icis"]|default('') %}
                            <a class="list-group-item">{{ key }}: <strong>{{ itemi|default('NO DATA') }}</strong></a>
            {% endfor %}
                        </div>
                    </div>
            
            {% if nominalDetails["caution"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Precaución</a>
            {% for itemt in nominalDetails["caution"]|default('') %}
                            <a class="list-group-item">tipo: <strong>{{ itemt.caution_id|default('NO DATA') }} </strong></a>
            {% endfor %}
                        </div>
                    </div>
            {% endif %}
            {% if nominalDetails["criminal_history"] is defined %}
                    <div class="col-xs-12 col-sm-12 col-md-12 col-xl-12">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-info">Historia Criminal</a>
            {% for itemc in nominalDetails["criminal_history"]|default('') %}
                            <a class="list-group-item">offence_id: <strong>{{ itemc.offence_id|default('NO DATA') }}</strong></a>
            {% endfor %}
                        </div>
                    </div>
            {% endif %}
                </div>
                <div _ngcontent-xyt-6="" class="panel-footer">
            		<button _ngcontent-xyt-6="" id="btnCerrar3" name="btnCerrar3" class="btn btn-default" onclick="window.history.back();">Volver</button>   
                </div>
                </div>
    {% endif %}	<!-- if (nominalDetails.ERROR is defined) -->
    
	<div class="modal fade" id="MensajeConfirmacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-header modal-header-danger">
					<h5 class="modal-title text-center" id="exampleModalLabel"><b>Confirmación</b></h5>
				</div>
				<div class="modal-body text-center" id="dvMensaje"></div>
				<div class="modal-footer">
					<button type="button" class="btn btn-default res"
						data-dismiss="modal">Cancelar</button>
					<button type="button" class="btn btn-danger res" data-dismiss="modal" onClick="mostrarDetalle();">Aceptar</button>
				</div>
			</div>
		</div>
	</div>
  </div>
</form>
<div class="bootbox modal fade bootbox-alert in" tabindex="-1" role="dialog" id="showImages">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header" style="text-align:center;color: #a94442;background-color: #f2dede;border-color: #ebccd1;">
					<h4 class="modal-title">Fotos Disponibles</h4>
				</div>
				<div class="modal-body">
					<div class="bootbox-body">
						<a href="javascript:void(0)" class="thumbnail"><img id="imgMostrar" src="{{ asset( 'bundles/images/unknown.png' ) }}"></a>
					</div>
				</div>
				<div class="modal-footer">
					<table _ngcontent-xyt-6="" width="100%">
       	                <tbody _ngcontent-xyt-6=""><tr _ngcontent-xyt-6="">
       	                	<tr>
                              <td width="20%">
                                  <button class="btn btn-default center-block" disabled>
                                 	    <span class="glyphicon glyphicon-chevron-left"></span>
                                  </button>
                              </td>
                              <td width="60%">
                                  <p class="text-center" style="padding-top:10px;" id="nroFotoMostrar">{{arrayImg|length==0?'0':'1'}} de {{arrayImg|length}}</p>
                              </td>
                              <td width="20%">
                                  <button class="btn btn-default center-block" disabled>
                                      <span class="glyphicon glyphicon-chevron-right"></span>
                                  </button>
                              </td>
                         	</tr>
   	              		</tbody>
   	              	</table>	
				</div>
			</div>
		</div>
	</div>
<script languaje="javascript">
	var arrayImg = new Array();
	var cont = 0;
	var idx=0;
		
	{% for img in arrayImg %}
		arrayImg.push('{{img}}');
		cont++;
	{% endfor %}
	
    $(document).ready(function () {
    	if ($(window).width() < 600) {
    		$("#panelconsulta").attr("style","margin-bottom:2%;");
        }else{
        	$("#panelconsulta").attr("style","margin-left:25%;margin-bottom:2%;");
        }
        {% if arrayImg|length > 1 %}
        	addIdxImg(cont);
        {% endif %}

		$("#showImages").on('hidden.bs.modal', function () {
			checkIconos();
		});

		$("#showImages").on('show.bs.modal', function () {
			checkIconos();
		});
        
    });

    $( "#btnReintentar" ).click(function() {
		confirmaDetalle( $("#txtNombre").val(), $("#txtApellido").val(), $("#txtFechaNac").val(), $("#txtEntity").val() );
    });
    
    $( "#btnCerrar" ).click(function() {
    	cerrar();
    });
    
    $( "#btnCerrar2" ).click(function() {
    	cerrar();
    });

	function checkIconos(){
		if(idx==(cont-1)){
			$(".glyphicon-chevron-right").parent().attr("disabled","");
		}
		if(idx==0){
			$(".glyphicon-chevron-left").parent().attr("disabled","");			
		}
	}
    
    function confirmaDetalle( pApellido, pNombre, pFechaNac, pEntity ){
		$("#txtEntity").val( pEntity );
    	$('#dvMensaje').html( "¿Est&aacute; seguro de que quiere consultar los datos de <b>" + pApellido + ", " + pNombre + "</b>, fecha de nacimiento: <b>"+pFechaNac+"</b>?<br/><br/><b>ESTA ACCI&Oacute;N PUEDE GENERAR ALARMAS</b>." );
		$('#btDetalle').attr('onclick', '');
		$('#btDetalle').click(function() {
			mostrarDetalle();
		});
    	$('#MensajeConfirmacion').modal( 'show' );
    }	//	function mostrarDivDetalle(){
	
	function mostrarDetalle( ){
		if( $( "#txtEntity" ).val() == ""){
			alert("Para ver el detalle volver a seleccionar un renglón haciendo click en la lupa del mismo.");
			return false;
		}	//	if( $( "#txtEntity" ).val() == ""){
		$( "form" ).submit();
	}	//	function mostrarDetalle( ){
    
    function cerrar(){
    	{% if app.request.get('txtCombinada') is defined and app.request.get('txtCombinada')=='SI' %}
    		$('form').attr('action', '{{ path('combinada') }}');
		{% else %}
			$('form').attr('action', '{{ path('persona') }}');
		{% endif %}
    	
    	$( "form" ).submit();
    }

    function addIdxImg(cant){
    	$(".glyphicon-chevron-right").parent().removeAttr("disabled");
    	$(".glyphicon-chevron-right").parent().unbind();
    	$(".glyphicon-chevron-left").parent().unbind();
    	
    	$(".glyphicon-chevron-right").parent().click(function(e){

			e.preventDefault();        	
    		idx++;
    		
    		if(idx==1){
    			$(".glyphicon-chevron-left").parent().removeAttr("disabled");
    		}
    		if(idx==(cant-1)){
    			$(this).attr("disabled","");
    		}
    		$("#imagen").attr('src',arrayImg[idx]);
    		$("#imgMostrar").attr('src',arrayImg[idx]);
    		$("#imagen").parent().attr('href','javascript:mostrar('+idx+')');
    		$("#nroFoto").html((idx+1)+" de " + cant);
    		$("#nroFotoMostrar").html((idx+1)+" de " + cant);
    	});
    	
    	$(".glyphicon-chevron-left").parent().click(function(e){
    		e.preventDefault();
    		idx--;
    		if(idx==0){
    			$(this).attr("disabled","");			
    		}
    		if(idx<(cant-1)){
    			$(".glyphicon-chevron-right").parent().removeAttr("disabled");	
    		}
    		$("#imagen").attr('src',arrayImg[idx]);
    		$("#imgMostrar").attr('src',arrayImg[idx]);
    		$("#imagen").parent().attr('href','javascript:mostrar('+idx+')');
    		$("#nroFoto").html((idx+1)+" de " + cant);
    		$("#nroFotoMostrar").html((idx+1)+" de " + cant);
    	});	
    }
    
    function mostrar(idx){
    	if(idx >= 0){
    		$("#imgMostrar").attr('src',arrayImg[idx]);
    	}
    	$("#showImages").modal();
    }

    </script>
{% endblock %}
