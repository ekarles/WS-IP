{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}
{% set PermisoDetalle = app.session %}
<form method="POST" id="frm" action="{{ path('persona_show') }}">
		<div id="panelconsulta" class="col-xs-12 col-md-6">
			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
				
					<div class="container" width="100%">
			    		<div class="row text-cemter">
			    		<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
				    	</div>
						<div class="row">
							<div>&nbsp;</div>
						</div>
						<div class="row">
							<div><p style="color:#00457D; font-size:24px;">Interpol - Personas</p></div>
						</div>
					</div>
				</div>
			</div>
			<div class="panel panel-default">
				<div class="panel-body">
       	        	<div class="col-sm-12 col-md-12" >
						<div class="form-group">
           	        		<label>Apellido</label>
           	        		<input type="text" id="txtApellido" name="txtApellido" value="" required="required" placeholder="Ingrese Apellido"/>
           	        	</div>
           	        </div>
            	    <div class="col-sm-12 col-md-12" >
						<div class="form-group">
        	        		<label style="text-align: left">Nombre</label>
        	        		<input type="text" id="txtNombre" name="txtNombre" value="" placeholder="Ingrese Nombre" required="required" data-live-search="true" />
        	        	</div>
    	        	</div>
       	        	<div class="col-sm-12 col-md-12" >
   						<div class="form-group">
           	        		<label>Fecha de Nacimiento</label>
                               <input type="date" id="txtFechaNac" name="txtFechaNac" value="" required="required" />
           	        	</div>
       	        	</div>
{% set bInvestigativo = "NO" %}
{% for perfil  in usuario.perfilid %}
    {% for permiso in perfil.permisoid %}
        {% if permiso.id == '7' %}
        	{% set bInvestigativo = "SI" %}
        {% endif %}
    {% endfor %}	
{% endfor %}	
       	        	<div class="col-sm-12 col-md-12 {{bInvestigativo == 'SI'?'':'hidden'}}" >
   						<div class="form-group">
           	        		<label>Tipo de Consulta</label>
           	                <select id="lstTipoCons" name="lstTipoCons" required="required" class="selectpicker">
           	                  <option value="BC" selected>Control fronterizo</option>
           	                  {% if bInvestigativo == "SI" %}
           	                  <option value="AD">Investigación</option>
           	                  {% endif %}
           	                </select>
           	            </div>
       	        	</div>

       	        	<div class="col-sm-12 col-md-12 {{bInvestigativo == 'SI'?'':'hidden'}}">
     	        		<label>Modo de Consulta</label>
     	        	</div>
       	        	<div class="col-sm-12 col-md-12 {{bInvestigativo == 'SI'?'':'hidden'}}">
       	        		<div class="col-sm-6 col-md-6" >
	   						<div class="form-group">
	           	        		<span>Exacta</span>
	           	        	</div>
	                           <div class="radio">
	                               <div class="col-sm-6 col-md-6" id="dvNominalsExact">
	                                 <input type="radio" id="optNominalsExact" name="optNominals" value="NOMINALSEXACT" checked>
	                               </div>
	           	            </div>
	       	        	</div>
	       	        	{% if bInvestigativo == 'SI' %}
       	        		<div class="col-sm-6 col-md-6" >
	       	        		<div class="form-group">
	           	        		<span id="spanAproxLabel">Aproximada</span>
	           	        	</div>
	                           <div class="form-group">
	                               <div class="col-sm-6 col-md-6" id="dvNominals">
	                                 <input type="radio" id="optNominals" name="optNominals" value="NOMINALS" disabled="disabled">
	                               </div>
	           	            </div>
	       	        	</div>
	       	        	{% endif %}
	       	        	<br>
       	        	</div>
            	</div>
                <div class="col-xs-12" align="center">
                	<div class="row col-sm-12 col-md-12">
						<div>&nbsp;</div>
						<div>&nbsp;</div>
					</div>
    				<div class="col-sm-6 col-md-6">
    					<button class="btn btn-success col-xs-12" data-toggle="tooltip" id="consultar" title="Consultar" type="submit" data-placement="bottom">
    						<div class="hidden-xs hidden-sm">Consultar</div>
    						<div class="hidden-md hidden-lg">
    							<i class="fa fa-search" aria-hidden="true"></i>
    						</div>
    					</button>
    					<button id="sendForm" type="submit" class="hide"></button>
    				</div>
    				<div class="col-sm-6 col-md-6">
    					<button class="btn btn-default col-xs-12" data-toggle="tooltip" title="Limpiar Par&aacute;metros de B&uacute;squeda" id="limpiar" type="button" onclik="limpiarForm" data-placement="bottom">
    						<div class="hidden-xs hidden-sm">Limpiar B&uacute;squeda</div>
    						<div class="hidden-md hidden-lg">
    							<i class="fa fa-undo" aria-hidden="true"></i>
    						</div>
    					</button>
    				</div>
    			</div>
    		</div>
        </div>
    </div>    
</form>
    <script>
        $(document).ready(function () {
    		if ($(window).width() < 600) {
    			$("#panelconsulta").attr("style","margin-bottom:2%;");
    	    }else{
    	    	$("#panelconsulta").attr("style","margin-left:25%;margin-bottom:2%;");
    	    }	//	if ($(window).width() < 600) {
    	    
        });
        
        {% if bInvestigativo == 'SI' %}
        
        $(window).on('load', function(event) {
        	if(document.getElementById("optNominals").checked){
        		document.getElementById("txtNombre").required = false;
            	document.getElementById("txtFechaNac").required = false;
        	}else{
        		document.getElementById("txtNombre").required = true;
                document.getElementById("txtFechaNac").required = true;
        	}
        });
        
        {% endif %}
        
       	$('#limpiar').click(function () {
            $("#txtNombre").val("");
            $("#txtApellido").val("");
            $("#txtFechaNac").val("");
            $("#lstTipoCons").val("BC").selectpicker('refresh');
            document.getElementById("optNominalsExact").checked = true;
        });	//	$('#limpiar').click(function () {

        
        $('#optNominals').click(function () {
        	document.getElementById("txtNombre").required = false;
        	document.getElementById("txtFechaNac").required = false;
        });
        
        $('#optNominalsExact').click(function () {
            document.getElementById("txtNombre").required = true;
            document.getElementById("txtFechaNac").required = true;                
        });
        
        {% if bInvestigativo == 'SI' %}
        
        
        $("#lstTipoCons").change(function(){
        	if($("#lstTipoCons").val()=='BC'){
        		if(document.getElementById("optNominals").checked){
        			$('#dvNominalsExact input[type="radio"]').click();	
        		}
        		$('#dvNominals input[type="radio"]').attr('disabled','true');
        		$('#spanAproxLabel').css('color','gray');
        	}else{
        		$('#dvNominals input[type="radio"]').removeAttr('disabled');
        		$('#spanAproxLabel').removeAttr('style');
        	}	
        });
        
        {% endif %}
        

        
    </script>
    {% endblock %}
