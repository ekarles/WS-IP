<script>
    
    $(window).resize(function () {
        showAccessPanel();
    });

    $(window).load(function () {    
        showAccessPanel();
    });
    
    function showAccessPanel(){
        if ($(window).width() >= 812) {
            $(".accessPanel").show();
        }else{
            $(".accessPanel").hide();
        }
    }

    $(".administrador").click(function(){
            $("#inicioAccessPanel").hide();
            $("#administrador").show();
    });

    $(".administradorBack").click(function(){
            $("#inicioAccessPanel").show();
            $("#administrador").hide();
    });
    $(".consultas").click(function(){
            $("#inicioAccessPanel").hide();
            $("#consultas").show();
    });

    $(".consultasBack").click(function(){
            $("#inicioAccessPanel").show();
            $("#consultas").hide();
    });
    $(".lotes").click(function(){
            $("#inicioAccessPanel").hide();
            $("#lotes").show();
    });

    $(".lotesBack").click(function(){
            $("#inicioAccessPanel").show();
            $("#lotes").hide();
    });
</script>

{% endblock %}
