{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}

<form id="frm" method="POST" action="{{ path('combinada_show') }}">
{% set bInvestigativo = "NO" %}
{% for perfil  in usuario.perfilid %}
    {% for permiso in perfil.permisoid %}
        {% if permiso.id == '7' %}
        	{% set bInvestigativo = "SI" %}
        {% endif %}
    {% endfor %}	
{% endfor %}

    	<div id="panelconsulta" class="col-xs-12 col-md-6" style="margin-bottom:2%;">
			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
				
					<div class="container" width="100%">
			    		<div class="row text-cemter">
			    		<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
				    	</div>
						<div class="row">
							<div>&nbsp;</div>
						</div>
						<div class="row">
							<div><p style="color:#00457D; font-size:24px;">Interpol - Combinada</p></div>
						</div>
					</div>
				</div>
			</div>
			<!-- Personas -->
			<div class="panel panel-default">
				<div class="panel-heading" style="text-align:center;">
					<h3 class="panel-title"><strong>Consulta de personas</strong></h3>
				</div>
				<div class="panel-body">
       	        	<div class="col-sm-12 col-md-12" >
						<div class="form-group">
           	        		<label>Apellido</label>
           	        		<input type="text" id="txtApellido" name="txtApellido" value="" placeholder="Ingrese Apellido"/>
           	        	</div>
           	        </div>
            	    <div class="col-sm-12 col-md-12" >
						<div class="form-group">
        	        		<label style="text-align: left">Nombre</label>
        	        		<input type="text" id="txtNombre" name="txtNombre" value="" placeholder="Ingrese Nombre" data-live-search="true" required/>
        	        	</div>
    	        	</div>
       	        	<div class="col-sm-12 col-md-12" >
   						<div class="form-group">
           	        		<label>Fecha de Nacimiento</label>
                               <input type="date" id="txtFechaNac" name="txtFechaNac" value="" required/>
           	        	</div>
       	        	</div>
       	        	<div class="col-sm-12 col-md-12 {{bInvestigativo == 'SI'?'':'hidden'}}" >
   						<div class="form-group">
           	        		<label>Tipo de Consulta</label>
           	                <select id="lstTipoConsPer" name="lstTipoConsPer" required="required" class="selectpicker">
           	                  <option value="BC">Control fronterizo</option>
           	                  {% if bInvestigativo == "SI" %}
           	                  <option value="AD" selected>Investigación</option>
           	                  {% endif %}
           	                </select>
           	            </div>
       	        	</div>
            	</div>
			</div>

			<!-- Documentos -->
			<div class="panel panel-default">
				<div class="panel-heading" style="text-align:center;">
					<h3 class="panel-title"><strong>Consulta de documentos</strong></h3>
				</div>			
				<div class="panel-body">
					<div class="col-sm-12 col-md-12">
						<div class="form-group">
							<label for="tipoDocumento">Tipo de Documento</label> 
							<select id="lstTipoDoc" name="lstTipoDoc" data-live-search="true" class="selectpicker">
                                {% for Documento in documentos %}
                            		<option value="{{ Documento.COD }}"  {{ Documento.COD=='P'?'selected':'' }}>{{ Documento.COD ~ ' - ' ~ Documento.DESCRIPCION }}</option>
                                {% endfor %}
							</select>
						</div>
					</div>
					<div class="col-md-12">
						<div class="form-group">
							<label for="txtNumeroDoc">Nro. de Documento</label> 
							<input type="text" value="" class="form-control" id="txtNumeroDoc" name="txtNumeroDoc" placeholder="Ingrese Nro de Documento">
						</div>
					</div>
					<div class="col-sm-12 col-md-12">
						<div class="form-group">
							<label for="lstPais">País</label>
							<select id="lstPais" name="lstPais" data-live-search="true" class="selectpicker">
                                <option value="">- Sin especificar -</option>
                                {% for Pais in paises %}
                                	<option value="{{ Pais.COD_B }}">{{ Pais.COD_B ~ ' - ' ~ Pais.DESCRIPCION }}</option>
                                {% endfor %}
							</select>
						</div>
					</div>
					<div class="col-sm-12 col-md-12 {{bInvestigativo == 'SI'?'':'hidden'}}">
						<div class="form-group">
							<label for="lstTipoCons">Tipo de Consulta</label> 
							<select id="lstTipoConsDoc" name="lstTipoConsDoc" class="selectpicker">
								<option value="BC">Control fronterizo</option>
           	                    {% if bInvestigativo == "SI" %}
           	                      <option value="AD" selected>Investigación</option>
           	                    {% endif %}
							</select>
						</div>
					</div>
					<div class="col-sm-12 col-md-12">
						<div class="row">&nbsp;</div>
						<div class="row">&nbsp;</div>
					</div>
				</div>
			</div>
			
			
			<!-- Vehículos -->
			<div class="panel panel-default">
				<div class="panel-heading" style="text-align:center;">
					<h3 class="panel-title"><strong>Consulta de veh&iacute;culos</strong></h3>
				</div>
                <div class="panel-body">                            
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="txtVin">VIN (Nro. Chasis)</label>  
                            <input type="text" value="" class="form-control interpol" name="txtVin" id="txtVin" placeholder="Ingrese VIN" >
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">                        
                            <label for="txtDominio">Dominio</label>  
                            <input type="text" value="" class="form-control interpol" name="txtDominio" id="txtDominio" placeholder="Ingrese Dominio" >                          
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="txtNroMotor">Nro. Motor</label>  
                            <input type="text" value="" class="form-control" name="txtNroMotor" id="txtNroMotor" placeholder="Ingrese Número de Motor">                          
                        </div>
                    </div>
                    <div class="col-md-12 {{bInvestigativo == 'SI'?'':'hidden'}}">
                        <div class="form-group">
                            <label for="tipoDocumento">Tipo de Consulta</label>  
                            <select name="lstTipoConsVeh" class="selectpicker form-control" id="lstTipoConsVeh">
                                <option value="BC">Control Fronterizo</option>
               	                {% if bInvestigativo == "SI" %}
               	                    <option value="AD" selected>Investigación</option>
               	                {% endif %}
                            </select>                                
                        </div>
                     </div>
                </div>
            </div>
            				
                <div class="col-xs-12" align="center">
    				<div class="col-sm-6 col-md-6">
    					<button class="btn btn-success col-xs-12" data-toggle="tooltip" id="consultar" title="Consultar" type="submit" data-placement="bottom">
    						<div class="hidden-xs hidden-sm">Consultar</div>
    						<div class="hidden-md hidden-lg">
    							<i class="fa fa-search" aria-hidden="true"></i>
    						</div>
    					</button>
    					<button id="sendForm" type="submit" class="hide"></button>
    				</div>
    				<div class="col-sm-6 col-md-6">
    					<button class="btn btn-default col-xs-12" data-toggle="tooltip" title="Limpiar Par&aacute;metros de B&uacute;squeda" id="limpiar" type="button" onclik="limpiarForm" data-placement="bottom">
    						<div class="hidden-xs hidden-sm">Limpiar B&uacute;squeda</div>
    						<div class="hidden-md hidden-lg">
    							<i class="fa fa-undo" aria-hidden="true"></i>
    						</div>
    					</button>
    				</div>
    			</div>
    		</div>
        </div>
</form>

<div class="modal fade" id="MensajeValidar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header modal-header-danger">
				<h5 class="modal-title text-center" id="exampleModalLabel"><b>Atención</b></h5>
			</div>
			<div class="modal-body text-center" id="dvMensaje"><b>Debe completar algún campo de los siguientes: Apellido, Nro. de Documento o VIN</b></div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default res" data-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>


<script>
	$(document).ready(function () {
	
		if ($(window).width() < 992) {
			$("#panelconsulta").attr("style","margin-bottom:2%;");
	    }else{
	    	$("#panelconsulta").attr("style","margin-left:25%;margin-bottom:2%;");
	    }  
		
	});

	$(window).resize(function(){
		if ($(window).width() < 992) {
			$("#panelconsulta").attr("style","margin-bottom:2%;");
	    }else{
	    	$("#panelconsulta").attr("style","margin-left:25%;margin-bottom:2%;");
	    } 
 	});
	
	$(window).load(function(){
		
		$("#lstTipoConsPer").change( function(event) {
	    	if($(this).val()=='AD'){
	    		$("#txtNombre").removeAttr("required");
	    		$("#txtFechaNac").removeAttr("required");
	    	}else{
	    		$("#txtNombre").attr("required");
	    		$("#txtFechaNac").attr("required");
	    	}
	    });
	    
	    $("#lstTipoConsDoc").change( function(event) {
		    if($(this).val()=='AD'){
	    		$("#lstPais").removeAttr("required");
	    	}else{
	    		if($("#txtNumeroDoc").val()!=''){
	    			$("#lstPais").attr("required","true");
	    		}	
	    	}
	    
	    });    
		    
	    
	    $("#txtNumeroDoc").change(function(){
	    	if($(this).val()!=''){
	    		$("#lstTipoDoc").attr("required","true");
	    		
	    		if($("#lstTipoConsPer").val()=='AD'){
		    		$("#lstPais").removeAttr("required");
		    	}else{
		    		$("#lstPais").attr("required","true");
		    	}	
	    	}else{
	    		$("#lstTipoDoc").removeAttr("required");
	    		$("#lstPais").removeAttr("required");
	    	}
	    });
		
		
		if($("#txtApellido").val()!=''){
			if($("#lstTipoConsPer").val()=='AD'){
	    		$("#txtNombre").removeAttr("required");
	    		$("#txtFechaNac").removeAttr("required");
	    	}else{
	   			$("#txtNombre").attr("required","true");
	    		$("#txtFechaNac").attr("required","true");
	    	}	
    	}
	
		if($("#lstTipoConsDoc").val()=='AD'){
    		$("#lstPais").removeAttr("required");
    	}else{
    		if($("#txtNumeroDoc").val()!=''){
    			$("#lstPais").attr("required","true");
    		}	
    	}
		
		if($("#txtNumeroDoc").val()!=''){
			$("#lstTipoDoc").attr('required','true');
		}else{
			$("#lstTipoDoc").removeAttr('required');
	    	$("#lstPais").removeAttr('required');			
		}
	
	});
	
	
$('#limpiar').click(function () {
	$("#txtNombre").val("").removeAttr('required');
	$("#txtApellido").val("").removeAttr('required');
	$("#txtFechaNac").val("").removeAttr('required');
	$("#lstTipoConsPer").val("AD").selectpicker('refresh').removeAttr('required');
	$("#lstTipoDoc").val("").selectpicker('refresh').removeAttr('required');
    $("#txtNumeroDoc").val("").removeAttr('required');
    $("#lstPais").val("").selectpicker('refresh').removeAttr('required');
    $("#lstTipoConsDoc").val("AD").selectpicker('refresh').removeAttr('required');
	$("#txtVin").val("").removeAttr('required');
	$("#txtDominio").val("").removeAttr('required');
	$("#txtNroMotor").val("").removeAttr('required');
	$("#txtNroChasis").val("").removeAttr('required');
	$("#lstTipoConsVeh").val("AD").selectpicker('refresh').removeAttr('required');
     
 });	//	$('#limpiar').click(function () {

 $('#consultar').click(function () {
    event.preventDefault();
 	if($("#txtApellido").val()=='' && $("#txtNumeroDoc").val()=='' && $("#txtVin").val()==''){
 		$('#MensajeValidar').modal('show');
	}else{
		$("#sendForm").click();
    }
 });


 $("#txtApellido").change(function () {
	if($("#txtApellido").val()!=''){
		 
		 if($('#lstTipoConsPer').val()=='AD'){
			 $("#txtNombre").removeAttr('required');
	    	 $("#txtFechaNac").removeAttr('required');
	     }else{			     
	    	 $("#txtNombre").attr('required','true');
	    	 $("#txtFechaNac").attr('required','true');	
	     }
	}else{
		 $("#txtApellido").removeAttr('required');
		 $("#txtNombre").removeAttr('required');
    	 $("#txtFechaNac").removeAttr('required');			
	}
 });	
 
 
 $("#txtNumeroDoc").change(function () {
	if($("#txtNumeroDoc").val()!=''){
		$("#lstTipoDoc").attr('required','true');
	}else{
		$("#lstTipoDoc").removeAttr('required');
    	$("#lstPais").removeAttr('required');			
	}
 });

 $("#txtVin").change(function () {
	if($("#txtVin").val()!=''){
		 $("#txtVin").attr('required','true');	     
	}else{
		 $("#txtVin").removeAttr('required');	
	}
 }); 
 
 
 
 
 
</script>
{% endblock %}
