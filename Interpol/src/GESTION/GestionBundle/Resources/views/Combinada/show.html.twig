{% extends 'GESTIONGestionBundle::base.html.twig' %}
{% block body -%}

<!-- Persona -->
<form id="form_per" method="POST" action="{{ path('persona_showdetails') }}">
	
	<input type="hidden" id="txtCombinadaPer" name="txtCombinada" value="SI"/>
	<input type="hidden" id="txtEntityPer" name="txtEntity" value="" />
	<input type="hidden" id="txtNombre" name="txtNombre" value="{{ app.request.get('txtNombre'  ) | default('') }}" />
	<input type="hidden" id="txtApellido" name="txtApellido" value="{{ app.request.get('txtApellido') | default('') }}" />
	<input type="hidden" id="txtFechaNac" name="txtFechaNac" value="{{ app.request.get('txtFechaNac') | default('') }}" />
	<input type="hidden" id="lstTipoCons" name="lstTipoCons" value="{{ app.request.get('lstTipoConsPer') | default('') }}" />

	<div id="panelconsulta" class="col-xs-12" style="margin-bottom:2%;">
		<div class="panel panel-default">
			<div class="panel-body" style="margin-left: 2%;">
		    	<div class="col-sm-12 col-md-6">
		    		<div class="row text-cemter">
		    			<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
			    	</div>
					<div class="row">
						<div>&nbsp;</div>
					</div>
					<div class="row">
						<div><p style="color:#2d3c90; font-size:24px;">Interpol - Personas</p></div>
					</div>
				</div>
				<div class="col-sm-12 col-md-6">
					{% set fechaNac = app.request.get('txtFechaNac')!= '' ? date(app.request.get('txtFechaNac')) : '' %}
					{% set tipoCons = app.request.get('lstTipoConsPer') == 'BC' ? 'Control Fronterizo' : 'Investigaci&oacute;n'  %}
					<div class="row">
						<div><p style="color:#2d3c90; font-size:24px;">Datos consultados</p></div>
					</div>	
					<strong>Apellido/s: </strong>{{ app.request.get('txtApellido') | default('') }}<br>
					<strong>Nombre/s: </strong>{{ app.request.get('txtNombre') | default('') }}<br>
					<strong>Fecha Nac.: </strong>{{ fechaNac != '' ? fechaNac | date('d/m/Y') : '' }}<br>
					<strong>Tipo Cons.: </strong>{{ tipoCons | raw }}<br>
				</div>	
			</div>
		</div>
		<div class="panel panel-default">
			<div class="panel-heading clearfix">
				{% if nominals|length > 0 %}
				<div class="pull-left">
					<span style="color:red;margin-left:50px;"><strong>Resultado POSITIVO</strong></span>
				</div>
				{% endif %}
				<div class="list-group">
				  <button _ngcontent-xyt-6="" id="btnVolver3" name="btnVolver3" class="btn btn-default pull-right" onclick="window.history.back();">Volver</button> 	    
		    	</div>
		    </div>
		{% if (nominals.ERROR is defined) %}
	        <div class="panel panel-danger">
	          <div class="panel-heading"><b>Atención se produjo el siguiente mensaje de error:</b></div>
	          <div class="panel-body"><h3>{{ nominals.ERROR }}</h3></div>
	        </div>
		{% else %}
	
		<div class="panel-body">
			<div class="col-sm-12 col-md-12" >
			<div class="form-group">
			<table class="display tablashow" id="tabla_persona">
	            <thead>
	                <tr>
	                	<th>Opciones</th>
	                    <th>Nombre</th>      
	                    <th>Apellido</th>
	                    <th>Fecha Nacimiento</th>
	                    {% if app.request.get('lstTipoConsPer') == 'AD' %}
	                    <th title="A menor puntaje mayor correspondencia con los datos de b&uacute;squeda">Puntaje [Raz&oacute;n]</th>
	                    {% endif %}
	                </tr>
	            </thead>
	            <tbody>
	                {% for nominal in nominals %}
	                    <tr>
	                    	<td>
	                            <div id="obs{{nominal.entityId}}" style="display:none"></div>                                               
	                            <a id="btnRes{{nominal.entityId}}" class="btn btn-danger res" title="Haga click para ver el detalle" data-toggle="modal" onClick="confirmaDetallePer('{{nominal.name}}', '{{nominal.forename}}', '{{nominal.date_of_birth}}', '{{nominal.entityId}}');">
	                                <i class="fa fa-search"><strong> Ver Detalle</strong></i>
	                            </a>
	                            <div id="res{{nominal.entityId}}" style="display:none"></div>                        	
	                    	</td>
	                        <td class="row text-center">{{ nominal.name          }}</td>
	                        <td class="row text-center">{{ nominal.forename      }}</td>
	                        <td class="row text-center">{{ nominal.date_of_birth}}</td>
	                        {% if app.request.get('lstTipoConsPer') == 'AD' %}
	                        <td class="row text-left"><strong>{{ nominal.query_score.value |default('') }}</strong>{{ ' [' ~ nominal.query_score.reason |default('') ~ ']' }}</td>
	                        {% endif %}
	                    </tr>
	                {% endfor %}
	            </tbody>
	        </table>
	        
			</div>
    	</div>
		
		<div class="modal fade" id="MensajeConfirmacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<div class="modal-header modal-header-danger">
						<h5 class="modal-title text-center" id="exampleModalLabel"><b>Confirmación</b></h5>
					</div>
					<div class="modal-body text-center" id="dvMensaje"></div>
					<div class="modal-footer">
						<button type="button" class="btn btn-default res"
							data-dismiss="modal">Cancelar</button>
						<button id="btDetalle" type="button" class="btn btn-danger res" data-dismiss="modal" onClick="">Aceptar</button>
					</div>
				</div>
			</div>
		</div>
    </div>
    {% endif %}	<!-- if (nominals.ERROR is defined) -->
   	</div>
	</div>
</form>
<script languaje="javascript">
    $(document).ready(function () {
	});

    function confirmaDetallePer( pApellido, pNombre, pFechaNac, pEntity ){
		$("#txtEntityPer").val( pEntity );
    	$('#dvMensaje').html( "¿Est&aacute; seguro de que quiere consultar los datos de <b>" + pApellido + ", " + pNombre + "</b>, fecha de nacimiento: <b>"+pFechaNac+"</b>?<br/><br/><b>ESTA ACCI&Oacute;N PUEDE GENERAR ALARMAS</b>." );
		$('#btDetalle').attr('onclick', '');
		$('#btDetalle').click(function() {
			mostrarDetallePer();
		});
    	$('#MensajeConfirmacion').modal( 'show' );
    }	//	function mostrarDivDetalle(){

	function mostrarDetallePer( ){
		if( $( "#txtEntityPer" ).val() == ""){
			alert("Para ver el detalle debe seleccionar un renglón haciendo click en la lupa del mismo.");
			return false;
		}	//	if( $( "#txtEntity" ).val() == ""){
		$( "#form_per" ).submit();
	}	//	function mostrarDetalle( ){

</script>


<!-- Documento -->

<form id="form_doc" method="POST" action="{{ path('documento_showdetails') }}">
	
	<input type="hidden" id="txtCombinadaDoc" name="txtCombinada" value="SI"/>
	<input type="hidden" id="txtEntityDoc"    name="txtEntity" value="" />
	<input type="hidden" id="lstTipoDoc"   name="lstTipoDoc"   value="{{ app.request.get('lstTipoDoc'  ) | default('') }}" />
	<input type="hidden" id="txtNumeroDoc" name="txtNumeroDoc" value="{{ app.request.get('txtNumeroDoc') | default('') }}" />
	<input type="hidden" id="lstPais"      name="lstPais"      value="{{ app.request.get('lstPais'     ) | default('') }}" />
	<input type="hidden" id="lstTipoCons"  name="lstTipoCons"  value="{{ app.request.get('lstTipoConsDoc' ) | default('') }}" />
	
	<div id="panelconsulta" class="col-xs-12" style="margin-bottom:2%;">
		<div class="panel panel-default">
			<div class="panel-body" style="margin-left: 2%;">
		    	<div class="col-sm-12 col-md-6">
		    		<div class="row text-cemter">
		    			<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
			    	</div>
					<div class="row">
						<div>&nbsp;</div>
					</div>
					<div class="row">
						<div><p style="color:#2d3c90; font-size:24px;">Interpol - Documentos</p></div>
					</div>
				</div>
				<div class="col-sm-12 col-md-6">
					{% set tipoDoc = '' %}
					{% if app.request.get('lstTipoDoc') != '' %}
						{% for Documento in documentos %}
							{% if Documento.COD == app.request.get('lstTipoDoc') %}
								{% set tipoDoc = Documento.DESCRIPCION %}
							{% endif %}
						{% endfor %}
					{% endif %}	
					{% set pais = '' %}
					{% if app.request.get('lstPais') != '' %}
						{% for Pais in paises %}
							{% if Pais.COD_B == app.request.get('lstPais') %}
								{% set pais = Pais.DESCRIPCION %}
							{% endif %}
						{% endfor %}
					{% endif %}
					
					{% set tipoCons = app.request.get('lstTipoConsDoc') == 'BC' ? 'Control Fronterizo' : 'Investigaci&oacute;n'  %}
					<div class="row">
						<div><p style="color:#2d3c90; font-size:24px;">Datos consultados</p></div>
					</div>	
					<strong>Tipo de Documento: </strong>{{ tipoDoc }}<br>
					<strong>Nro. de Documento: </strong>{{ app.request.get('txtNumeroDoc') | default('') }}<br>
					<strong>Pa&iacute;s: </strong>{{ pais }}<br>
					<strong>Tipo Cons.: </strong>{{ tipoCons | raw }}<br>
				</div>
			</div>
		</div>
		<div class="panel panel-default">
			<div class="panel-heading clearfix">
				{% if documento|length > 0 and not documento.ERROR is defined %}
				<div class="pull-left">
					<span style="color:red;margin-left:50px;"><strong>Resultado POSITIVO</strong></span>
				</div>
				{% endif %}
				<div class="list-group">
				  <button _ngcontent-xyt-6="" id="btnVolver3" name="btnVolver3" class="btn btn-default pull-right" onclick="window.history.back();">Volver</button> 	    
			    </div>
		    </div>
			{% if (documento.ERROR is defined) %}
	        <div class="panel panel-danger">
	          <div class="panel-heading"><b>Atención se produjo el siguiente mensaje de error:</b></div>
	          <div class="panel-body"><h3>{{ documento.ERROR }}</h3></div>
	        </div>
			{% else %}

    	<div class="panel-body">
    		<div class="col-sm-12 col-md-12" >
    		<div class="form-group">
    		
            <table class="display tablashow" id="tabla_documento">
                <thead>
                    <tr>
                        <th>Opciones</th>
                        <th>ID</th>      
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>País</th>
                        <th>Desc.País</th>
                    </tr>
                </thead>
                <tbody>
                {% for doc in documento %}
                	{% if doc.sltdId|default('') != "" %}
                        <tr>
                        	<td>
                                <div id="obs{{doc.sltdId|default('')}}" style="display:none"></div>                                               
                                <a id="btnRes{{doc.sltdId|default('')}}" class="btn btn-danger res" title="Haga click para ver el detalle" data-toggle="modal" onClick="confirmaDetalleDoc('{{doc.nr|default('')}}', '{{doc.type_id|default('')}}', '{{doc.country_of_issuance_id|default('')}}', '{{doc.sltdId|default('')}}');">
                                    <i class="fa fa-search"><strong> Ver Detalle</strong></i>
                                </a>
                                <div id="res{{doc.sltdId|default('')}}" style="display:none"></div>                        	
                        	</td>
                        	<td class="row text-center">{{doc.sltdId|default('')}}</td>
                            <td class="row text-center">{{doc.nr|default('')}}</td>
                            <td class="row text-center">{{doc.type_id|default('')}}</td>
                            <td class="row text-center">{{doc.country_of_issuance_id|default('')}}</td>
                            <td class="row text-left">{{doc.country_description|default('')}}</td>
                        </tr>
    	    		{% endif %}
    	    	{% endfor %}
                </tbody>
            </table>
    		</div>
        </div>    
        </div>
    {% endif %}	<!-- if (documento.ERROR is defined) -->
   	</div>
	</div>
</form>
<script languaje="javascript">

    function confirmaDetalleDoc( pNumero, pTipo, pPais, pEntity ){
		$("#txtEntityDoc").val( pEntity );
    	$('#dvMensaje').html( "¿Est&aacute; seguro de que quiere consultar el documento:<br/><b>" + pTipo + " - " + pNumero + "</b>?<br/><br/><b>ESTA ACCI&Oacute;N PUEDE GENERAR ALARMAS</b>." );
		$('#btDetalle').attr('onclick', '');
		$('#btDetalle').click(function() {
			mostrarDetalleDoc();
		});
    	$('#MensajeConfirmacion').modal( 'show' );
    }	//	function mostrarDivDetalle(){

	function mostrarDetalleDoc( ){
		if( $( "#txtEntityDoc" ).val() == ""){
			alert("Para ver el detalle debe seleccionar un renglón haciendo click en la lupa del mismo.");
			return false;
		}	//	if( $( "#txtEntity" ).val() == ""){
		$( "#form_doc" ).submit();
	}	//	function mostrarDetalle( ){

</script>


<!-- Vehiculo -->


<form id="form_veh" method="POST" action="{{ path('vehiculo_showdetails') }}">
	
		<div class="row">
			<div>&nbsp;</div>
			<div>&nbsp;</div>
			<input type="hidden" id="txtCombinadaVeh" name="txtCombinada" value="SI"/>
			<input type="hidden" id="txtEntityVeh" name="txtEntity" value="" />
			<input type="hidden" id="txtVin" name="txtVin" value="{{ app.request.get('txtVin'  )|default('') }}" /> 
			<input type="hidden" id="txtDominio" name="txtDominio" value="{{ app.request.get('txtDominio')|default('') }}" />
			<input type="hidden" id="txtNroMotor" name="txtNroMotor" value="{{ app.request.get('txtNroMotor')|default('') }}" />
			<input type="hidden" id="lstTipoCons" name="lstTipoCons" value="{{ app.request.get('lstTipoConsVeh')|default('') }}" />			
		</div>
		<div id="panelconsulta" class="col-xs-12 col-md-12" style="margin-bottom: 2%;">
			<div class="panel panel-default">
				<div class="panel-body" style="margin-left: 2%;">
					<div class="col-sm-12 col-md-6">
			    		<div class="row text-cemter">
			    			<img width="300px" src="{{asset('bundles/pfa/img/ocnbuenosaires.png')}}" />
				    	</div>
						<div class="row">
							<div>&nbsp;</div>
						</div>
						<div class="row">
							<div><p style="color:#2d3c90; font-size:24px;">Interpol - Veh&iacute;culos</p></div>
						</div>
					</div>
					<div class="col-sm-12 col-md-6">
						{% set tipoCons = app.request.get('lstTipoConsVeh') == 'BC' ? 'Control Fronterizo' : 'Investigaci&oacute;n'  %}
						<div class="row">
							<div><p style="color:#2d3c90; font-size:24px;">Datos consultados</p></div>
						</div>	
						<strong>VIN (Nro. Chasis): </strong>{{ app.request.get('txtVin') | default('') }}<br>
						<strong>Dominio: </strong>{{ app.request.get('txtDominio') | default('') }}<br>
						<strong>Nro. Motor: </strong>{{ app.request.get('txtNroMotor')|default('') }}<br>
						<strong>Tipo Cons.: </strong>{{ tipoCons | raw }}<br>
					</div>
				</div>
			</div>
			<div class="panel panel-default">
				<div class="panel-heading clearfix">
					{% if smvs|length > 0 %}
					<div class="pull-left">
						<span style="color:red;margin-left:50px;"><strong>Resultado POSITIVO</strong></span>
					</div>
					{% endif %}
					<div class="list-group">
					  <button _ngcontent-xyt-6="" id="btnVolver3" name="btnVolver3" class="btn btn-default pull-right" onclick="window.history.back();">Volver</button> 	    
			    	</div>
			    </div>
	{% if (smvs.ERROR is defined) %}
        <div class="panel panel-danger">
          <div class="panel-heading"><b>Atención se produjo el siguiente mensaje de error:</b></div>
          <div class="panel-body"><h3>{{ smvs.ERROR }}</h3></div>
        </div>
	{% else %}

				<div class="panel-body">
					<div class="col-sm-12 col-md-12">
						<div class="form-group">
							<table class="display tablashow" id="tabla_vehiculo">
								<thead>
									<tr>
										<th width="8%">Opciones</th>
										<th width="25%">Vin (Nro. Chasis)</th>
										<th width="15%">Marca</th>
										<th width="15%">Modelo</th>
									</tr>
								</thead>
								<tbody>
                                {% if smvs is iterable %}
									{% for smv in smvs %}
									<tr>
										<td>
											<div id="obs{{smv.vinId}}" style="display: none"></div> 
											<a id="btnRes{{smv.vinId}}" class="btn btn-danger res" title="Haga click para ver el detalle" data-toggle="modal" onClick="confirmaDetalleVeh('{{smv.vin|default('')}}','{{smv.make|default('')}}','{{smv.model|default('')}}','{{smv.vinId|default('')}}');">
												<i class="fa fa-search"><strong> Ver Detalle</strong></i>
											</a>
											<div id="res{{smv.vinId}}" style="display: none"></div>
										</td>									
										<td class="row text-center">{{smv.vin|default('')}}</td>
										<td class="row text-center">{{smv.make|default('')}}</td>
										<td class="row text-center">{{smv.model|default('')}}</td>
									</tr>
									{% endfor %}
								{% else %}
									<tr>
										<td>
											<div id="obs{{smvs.vinId}}" style="display: none"></div> 
											<a id="btnRes{{smvs.vinId}}" class="btn btn-danger res"  title="Haga click para ver el detalle" data-toggle="modal" onClick="confirmaDetalleVeh('{{smvs.vin|default('')}}','{{smvs.make|default('')}}','{{smvs.model|default('')}}','{{smvs.vinId|default('')}}');">
												<i class="fa fa-search"><strong> Ver Detalle</strong></i>
											</a>
											<div id="res{{smvs.vinId}}" style="display: none"></div>
										</td>
										<td class="row text-center">{{smvs.vin|default('')}}</td>
										<td class="row text-center">{{smvs.make|default('')}}</td>
										<td class="row text-center">{{smvs.model|default('')}}</td>
									</tr>
								{% endif %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
	{% endif %}	<!-- if (smvs.ERROR is defined) -->
			</div>
		</div>

</form>
<script languaje="javascript">
        $(document).ready(function(){
            tableShow = $('.tablashow').DataTable({
                    "scrollY": "600px",
                    "scrollX": true,
                    "scrollCollapse": true,
                    "paging": false,
                    "info": false,
                    responsive: true,
                    "filter": true,
                    "order": [[0, "asc"]],
                    "oLanguage": {
                                    "sSearch":          "Buscar:",
                                    "sEmptyTable": 	   '<div class="alert alert-success"><strong>OK: No se encontraron registros.</strong></div>',		
                                    "sProcessing":     "Procesando...",
                                    "sLengthMenu":     "Mostrar _MENU_ registros",
                                    "sZeroRecords":    "No se encontraron resultados",
                                    "sInfo":           "Mostrando registros del: _START_ al _END_ (de un total de _TOTAL_ registros)",
                                    "sInfoEmpty":      "Mostrando registros del 0 al 0 de un total de 0 registros",
                                    "sInfoFiltered":   "(filtrado de un total de _MAX_ registros)",
                                    "sInfoPostFix":    "",
                                    "sUrl":            "",
                                    "sInfoThousands":  ",",
                                    "sLoadingRecords": "Cargando..."
				}
                });
        });


	$( ".btnCerrar" ).click(function() {
		$('form').attr('action', '{{ path('combinada') }}');
		$( "form" ).submit();
	});

	function confirmaDetalleVeh(pVin, pMarca, pModelo, pEntity) {
		$("#txtEntityVeh").val(pEntity);
		$('#dvMensaje').html("¿Est&aacute; seguro de que quiere consultar los datos de <b>" + pVin + "</b>, <br>marca: <b>" + pMarca + "</b>, modelo: <b>" + pModelo + "</b>? <br><br> <b>ESTA ACCI&Oacute;N PUEDE GENERAR ALARMAS</b>.");
		$('#btDetalle').attr('onclick', '');
		$('#btDetalle').click(function() {
			mostrarDetalleVeh();
		});
		$('#MensajeConfirmacion').modal('show');
	} //	function mostrarDivDetalle(){

	function mostrarDetalleVeh() {
		if ($("#txtEntityVeh").val() == "") {
			alert("Para ver el detalle debe seleccionar un renglón haciendo click en la lupa del mismo.");
			return false;
		} //	if( $( "#txtEntity" ).val() == ""){
		$("#form_veh").submit();
	} //	function mostrarDetalle( ){
</script>


{% endblock %}
